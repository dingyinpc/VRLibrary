--- !u!114 &439040294
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 439040292}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: daf404ac10c46324790e3afd8418ce81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: "CSharp_\u6570\u7EC4\u4E0E\u5F15\u7528_\u57FA\u7840\u603B\u7ED3"
  author: "\u65E5\u5E38\u95EE\u9898\u5904\u7406\u7ECF\u9A8C"
  summary: "\nC\n\u6570\u7EC4\u4E0E\u5BF9\u8C61\u5F15\u7528 \u2014\u2014 \u57FA\u7840\u603B\u7ED3\n\n#\n\u4E00\u3001\u6570\u7EC4\u662F\u4EC0\u4E48\n\n\u6570\u7EC4\u5C31\u662F
    \u540C\u7C7B\u578B\u6570\u636E\u7684\u6709\u5E8F\u96C6\u5408\uFF0C\u50CF\u4E00\u6392\u5E26\u7F16\u53F7\u7684\u50A8\u7269\u683C\u3002\n\ncsharp\nint[]
    scores = new int[3];   // 3 \u4E2A\u683C\u5B50\uFF0C\u5B58 int\nscores[0] = 90;             
    // \u7B2C 1 \u683C\u653E 90\nscores[1] = 85;              // \u7B2C 2 \u683C\u653E
    85\n\n\n\xB7 \u4E0B\u6807\u4ECE 0 \u5F00\u59CB\n\xB7 \u957F\u5EA6\u56FA\u5B9A\uFF0C\u521B\u5EFA\u540E\u4E0D\u80FD\u53D8\n\xB7
    \u58F0\u660E\uFF1A`\u7C7B\u578B[] \u540D\u5B57`\n\n---\n\n#\n\u4E8C\u3001\u4EFB\u4F55\u7C7B\u578B\u90FD\u80FD\u505A\u6210\u6570\u7EC4\n\ncsharp\nint[]
    a;              // int \u6570\u7EC4\nfloat[] b;            // float \u6570\u7EC4\nstring[]
    c;           // string \u7C7B\u6570\u7EC4\nGameObject[] d;       // Unity GameObject
    \u7C7B\u6570\u7EC4\nDrinkItem[] e; \f       // \u4F60\u81EA\u5DF1\u5199\u7684\u7C7B\u6570\u7EC4\n\n\n\u7C7B\uFF08class\uFF09\u5728
    C\n\u91CC\u5C31\u662F\u4E00\u79CD\u6570\u636E\u7C7B\u578B\uFF0C\u548C `int`\u3001`float`
    \u5730\u4F4D\u4E00\u6837\uFF0C\u81EA\u7136\u4E5F\u80FD\u505A\u6570\u7EC4\u3002\n\n---\n\n#\n\u4E09\u3001\u5F15\u7528\u7C7B\u578B\u4E0E\u503C\u7C7B\u578B\n\n|
    | \u503C\u7C7B\u578B | \u5F15\u7528\u7C7B\u578B |\n|---|---|---|\n| \u4F8B\u5B50
    | `int` `float` `bool` `struct` | `class` `string` `\u6570\u7EC4` `GameObject`
    |\n| \u5B58\u4EC0\u4E48 | \u503C\u672C\u8EAB | \u5185\u5B58\u5730\u5740\uFF08\u5F15\u7528\uFF09
    |\n| \u8D4B\u503C\u884C\u4E3A | \u590D\u5236\u503C | \u590D\u5236\u5730\u5740\uFF0C\u6307\u5411\u540C\u4E00\u4E2A\u5BF9\u8C61
    |\n\ncsharp\n// \u503C\u7C7B\u578B\nint a = 10;\nint b = a;   // b \u590D\u5236\u4E86
    10\uFF0Ca \u548C b \u72EC\u7ACB\n\n// \u5F15\u7528\u7C7B\u578B\nDrinkItem d1
    = new DrinkItem();\nDrinkItem d2 = d1;   // d2 \u590D\u5236\u4E86 d1 \u7684\u5730\u5740\uFF0C\u6307\u5411\u540C\u4E00\u4E2A
    DrinkItem\n\n\n---\n\n#\n\u56DB\u3001null \u2014\u2014 \f\u7A7A\u7684\u5F15\u7528\n\n\xB7
    `null` \u8868\u793A\"\u4E0D\u6307\u5411\u4EFB\u4F55\u5BF9\u8C61\"\n\xB7 \u5F15\u7528\u7C7B\u578B\u53D8\u91CF\u6CA1\u8D4B\u503C\u65F6\u9ED8\u8BA4\u662F
    `null`\n\xB7 \u6570\u7EC4\u521B\u5EFA\u540E\uFF0C\u6240\u6709\u683C\u5B50\u9ED8\u8BA4\u4E5F\u662F
    `null`\n\ncsharp\nDrinkItem[] slots = new DrinkItem[5];\n// \u6B64\u65F6 slots[0]
    ~ slots[4] \u5168\u662F null\n\nslots[0] = new DrinkItem();   // \u5B58\u5165\u5F15\u7528\uFF0C\u4E0D\u518D
    null\nslots[0] = null;              // \u6E05\u7A7A\uFF0C\u6062\u590D\u4E3A null\n\nif
    (slots[0] == null)         // \u5224\u65AD\u662F\u5426\u4E3A\u7A7A\n    Debug.Log(\"\u8FD9\u683C\u7A7A\u95F2\");\n\n\n---\n\n#\n\u4E94\u3001\u5B9E\u7528\u6A21\u5F0F\uFF1A\u7528\u6570\u7EC4\u505A\"\u5360\u4F4D\u6807\u8BB0\"\n\n\u8FD9\u662F\u6E38\u620F\u5F00\u53D1\u5E38\u7528\u6A21\u5F0F\uFF0C\u4E0D\u9700\u8981\u904D\u5386\u67E5\u627E\uFF0C\u76F4\u63A5\u6309\u4E0B\u6807\u8BBF\u95EE
    O(1)\uFF1A\n\ncsharp\n// \u5B9A\u4E49\nprivate DrinkItem[] cellOccupants;   //
    \u6BCF\f\u4E2A\u683C\u5B50\u5BF9\u5E94\u4E00\u4E2A\u5143\u7D20\n\n// \u521D\u59CB\u5316\ncellOccupants
    = new DrinkItem[cellCount];  // \u5168\u90E8\u521D\u59CB\u5316\u4E3A null\n\n//
    \u5360\u7528\ncellOccupants[cellIndex] = drink;   // \u5B58\u5165\u996E\u6599\u5F15\u7528\n\n//
    \u67E5\u8BE2\u662F\u5426\u7A7A\u95F2\nif (cellOccupants[i] == null)       //
    = \u7A7A\n\n// \u67E5\u8BE2\u662F\u5426\u6709\u996E\u6599\nif (cellOccupants[i]
    != null)       // = \u6709\n\n// \u91CA\u653E\ncellOccupants[srcIdx] = null;      
    // \u7F6E\u7A7A\n\n\n\u6838\u5FC3\u601D\u8DEF\uFF1A\u6570\u7EC4\u4E0B\u6807 =
    \u683C\u5B50\u7F16\u53F7\uFF0C\u6570\u7EC4\u5185\u5BB9 = \u6307\u5411\u683C\u5B50\u4E2D\u7684\u7269\u4F53\uFF08\u6216
    null\uFF09\u3002\n\n---\n\n#\n\u516D\u3001\u7ED3\u5408\u4F60\u4EE3\u7801\u4E2D\u7684\u573A\u666F\n\n\xB7
    `cellOccupants` \u662F `DrinkItem[]` \u2014 \u6BCF\u4E2A\u683C\u5B50\u5B58\u4E00\u4E2A\u996E\u6599\u7684\u5F15\u7528\n\xB7
    \u751F\u6210\u996E\u6599\u65F6 \u2192 `cellOccupants[\fcellIndex] = drink`\n\xB7
    \u79FB\u8D70\u996E\u6599\u65F6 \u2192 `cellOccupants[srcIdx] = null`\n\xB7 \u5224\u65AD\u683C\u5B50\u80FD\u5426\u653E
    \u2192 `cellOccupants[i] == null`\n\xB7 \u62FF\u5230\u683C\u5B50\u4E0A\u7684\u996E\u6599
    \u2192 `cellOccupants[nearest]`\n\n\u4E0D\u9700\u8981\u518D\u989D\u5916\u521B\u5EFA\u5E03\u5C14\u6570\u7EC4\u6765\u5224\u65AD\u5360\u7528/\u7A7A\u95F2\uFF0C\u76F4\u63A5\u7528\u5F15\u7528\u662F\u5426\u4E3A
    `null` \u5373\u53EF\u2014\u2014\u5F15\u7528\u672C\u8EAB\u5C31\u662F\u6700\u597D\u7684\u6807\u8BB0\u3002\n"
  slotCode: C3-1-07
