--- !u!114 &1901852880
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1901852878}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: daf404ac10c46324790e3afd8418ce81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: "\u5B9E\u73B0\u65B9\u6848 \xB7 06-PICO\u7684\u5BFC\u5165\u6D41\u7A0B"
  author: "VRlibrary \u9879\u76EE\u7EC4"
  summary: "\n06 PICO \u7684\u5BFC\u5165\u6D41\u7A0B(SDK 3.3.0)\n\n> \u672C\u5DE5\u7A0B\u4ECE\u96F6\u5230\u771F\u673A\u53EF\u8DD1\u7684\u5B8C\u6574\u6D41\u7A0B\u3002SDK:\u5185\u5D4C\u4E8E
    `Assets/sdk/PICO Unity Integration SDK-3.3.0-20250917`\u3002\n\n#\n\u4E00\u3001\u5DE5\u7A0B\u51C6\u5907\n\n1.
    Unity 2022.3.42f1c1 + \u6A21\u677F URP;\n2. Package Manager \u88C5:XRI 2.6.5(\u5BFC\u5165
    Starter Assets Samples)\u3001XR Hands 1.4.3\u3001XR Plugin Management 4.6.0\u3001OpenXR
    1.11.0(\u4EC5\u5305\u4F53,\u52A0\u8F7D\u5668\u7528 PICO \u7684)\u3001Input System
    1.19.0(\u63D0\u793A\u91CD\u542F\u5207\u65B0\u8F93\u5165\u7CFB\u7EDF,\u9009 Yes);\n3.
    \u62F7\u8D1D PICO SDK \u5230 `Assets/sdk/`(\u6216 Package Manager \u2192 Add
    Package From Tarball \u5B89\u88C5 .tgz \u7248)\u3002\f\n\n#\n\u4E8C\u3001XR \u63D2\u4EF6\u914D\u7F6E(Project
    Settings)\n\n1. XR Plug-in Management:Install;\n2. \u5207\u5230 Android \u6807\u7B7E\u9875
    \u2192 \u52FE\u9009 PICO(PXR_Loader);\n3. \u5E73\u53F0\u5207\u6362:`File \u2192
    Build Settings \u2192 Android \u2192 Switch Platform`;\n4. XR \u914D\u7F6E\u8D44\u4EA7\u5B58\u653E:`Assets/XR/`(XRGeneralSettingsPerBuildTarget
    / PXR_Settings / PXR_Loader)\u2014\u2014\u672C\u5DE5\u7A0B\u76F4\u63A5\u4ECE\u65E7\u5DE5\u7A0B\u6574\u76EE\u5F55\u62F7\u8D1D,GUID
    \u4E0D\u53D8\u5373\u63D2\u5373\u7528\u3002\n\n#\n\u4E09\u3001\u573A\u666F\u73A9\u5BB6\u7AEF\n\n1.
    \u62D6\u5165 XRI `XR Interaction Setup` \u9884\u5236\u4F53(Samples \u2192 Starter
    Assets \u2192 Prefabs);\n2. XR Origin \u4E0A Add Component \u2192 PXR_Manager(\f\u5EFA\u8BAE\u52FE\u9009,\u771F\u673A\u8BBE\u5907\u80FD\u529B\u5165\u53E3);\n3.
    Build Settings \u628A\u573A\u666F\u52A0\u5165 Scenes In Build\u3002\n\n#\n\u56DB\u3001Android
    \u6784\u5EFA\u53C2\u6570(Player Settings)\n\n| \u53C2\u6570 | \u503C | \u539F\u56E0
    |\n| --\xB7 | --\xB7 | --\xB7 |\n| Scripting Backend | IL2CPP | PICO \u8981\u6C42
    |\n| Target Architectures | \u4EC5 ARM64(\u53D6\u6D88 ARMv7) | PICO Store \u53EA\u6536
    64 \u4F4D |\n| Graphics API | \u53D6\u6D88 Auto,\u9996\u9009 Vulkan(GLES \u5907\u9009)
    | \u6027\u80FD\u66F4\u597D |\n| Minimum API Level | Android 10 (API 29) | PICO
    \u7CFB\u7EDF \u8981\u6C42 |\n| Color Space | Linear(\u9ED8\u8BA4) | URP \u6B63\u786E\u663E\u793A
    HDR \u53D1\u5149 |\n| MSAA | URP Asset \u91CC\f\u8BBE 4x | \u6297\u952F\u9F7F(URP
    \u4E0B PXR_Manager \u7684 MSAA \u7F6E\u7070) |\n| HDR | URP Asset \u52FE\u9009
    | Bloom \u524D\u63D0(\u672C\u5DE5\u7A0B\u53D1\u5149\u4F9D\u8D56) |\n\n#\n\u4E94\u3001\u5BFC\u51FA\u4E0E\u90E8\u7F72\n\n1.
    `File \u2192 Build Settings \u2192 Build And Run`(PICO \u7528 USB \u8FDE\u63A5\u3001\u5F00\u53D1\u8005\u6A21\u5F0F\u5F00\u542F:\u8BBE\u7F6E\u91CC\u8FDE\u70B9\u7248\u672C\u53F7\u65B9\u5F0F\u2014\u2014PICO
    \u662F\"\u5173\u4E8E\u2192\u8F6F\u4EF6\u7248\u672C\u53F7\u8FDE\u70B9 7 \u6B21\"\u5F00\u542F\u5F00\u53D1\u8005\u6A21\u5F0F,\u5177\u4F53\u6309\u673A\u578B\u6587\u6863);\n2.
    \u9996\u6B21\u771F\u673A\u8FD0\u884C,\u5934\u663E\u91CC\u5F39\"USB \u8C03\u8BD5\u6388\u6743\"\u2192
    \u5141\u8BB8;\n3. \u4E5F\u53EF `Build` \u51FA apk,\u7528 PICO \u6587\u4EF6\u7BA1\u7406\u5668\u5B89\u88C5(\u9002\u5408\u7ED9\u4ED6\u4EBA\u4F53\u9A8C)\u3002\n\n#\n\u516D\u3001\u9A8C\u8BC1\u6E05\u5355(\u771F\u673A\u7B2C\u4E00\u6B21\u8DD1\u5FC5\u67E5)\n\n\xB7
    [ ] \u53CC\u624B\u67C4\u6709\u5C04\u7EBF\u3001\u6447\u6746\u53EF\u79FB\u52A8\u3001\u6273\u673A\u53EF\u70B9;\n\xB7
    [ ] \u4F20\u9001:\u6307\u5411\u5730\u9762\u51FA\u5F27\u7EBF,\u6273\u673A\u786E\u8BA4;\n\xB7
    [ ] \u5730\u9762\u6CDB\u5149/\u9713\u8679\u53D1\u5149\u6B63\u5E38(\u82E5\u5168\u7070:URP
    Asset \u7684 HDR \u6CA1\u5F00,\u6216 Bloom Volume \u6CA1\f\u751F\u6548);\n\xB7
    [ ] \u6293\u4E66\u3001\u6263\u6273\u673A\u9605\u8BFB\u6B63\u5E38;\n\xB7 [ ] \u5E27\u7387:\u8089\u773C\u6D41\u7545\u3001\u65E0\u679C\u51BB\u611F(PICO
    4 \u4E3A 72/90Hz)\u3002\n\n#\n\u4E03\u3001\u5E38\u89C1\u95EE\u9898\n\n| \u75C7\u72B6
    | \u539F\u56E0/\u89E3\u51B3 |\n| --\xB7 | --\xB7 |\n| \u6253\u5305\u540E\u9ED1\u5C4F\u53EA\u6709\u58F0\u97F3
    | \u573A\u666F\u6CA1\u52A0\u8FDB Scenes In Build;\u6216 XR Plug-in Management
    Android \u6CA1\u52FE PICO |\n| \u7F16\u8BD1\u62A5 `Unity.XR.PXR` \u627E\u4E0D\u5230
    | SDK \u4ECE PDC \u4E0B\u8F7D\u65F6\u6587\u4EF6\u540D\u5E26 `%` \u7279\u6B8A\u5B57\u7B26
    \u2192 \u6539\u7EAF\u5B57\u6BCD\u6570\u5B57\u540D\u518D\u5BFC\u5165,\u6216\u4ECE\u5B98\u7F51\u4E0B
    |\n| \u9707\u52A8\u65E0\u53CD\u5E94 | \u6B63\u5E38\u2014\u2014\u5FC5\u987B\u771F\u673A;\u4E14
    PICO \u7528 `PXR_Input.SendHapticImpulse`,XRI \u7684 Haptic Events \u5728 PICO
    Integration SDK \u4E0B\u65E0\u6548 |\n| \u624B\u67C4\u6A21\u578B\u4E0D\u663E\u793A
    | XR Controller \u7684 Model Prefab \u7A7A, Starter\f Assets \u9ED8\u8BA4\u6709\u6A21\u578B,\u522B\u8BEF\u5220
    Controllers \u5B50\u7269\u4F53 |\n| \u6CDB\u5149\u5168\u65E0 | URP Asset HDR
    \u672A\u52FE / Global Volume \u7684 Profile \u672A\u6307\u5B9A / \u76F8\u673A
    Renderer \u7528\u9519 URP Renderer |\n\r\n---\r\n\r\n#\n\u4EBA\u5DE5\u590D\u523B\u6B65\u9AA4(PICO
    \u63A5\u5165,15 \u6B65\u7EBF\u6027\u6E05\u5355)\r\n\r\n1. Unity Hub \u5B89\u88C5
    2022.3.42f1c1(\u52FE Android Build Support + SDK/NDK + OpenJDK);\r\n2. \u65B0\u5EFA
    URP \u5DE5\u7A0B\u5E76\u6253\u5F00;\r\n3. Package Manager \u88C5:Input System(\u9009
    Yes \u5207\u6362)\u2192 XR Plugin Management \u2192 XR Interaction Toolkit(\u5BFC\u5165
    Starter Assets)\u2192 XR Hands;\r\n4. \u5B98\u7F51\u4E0B\u8F7D PICO Unity Integration
    \fSDK 3.3.0(\u6587\u4EF6\u540D\u53EA\u7528\u5B57\u6BCD\u6570\u5B57);\r\n5. SDK
    \u5BFC\u5165:Package Manager \u2192 + \u2192 Add Package From Tarball \u9009
    .tgz(\u6216\u89E3\u538B zip \u5230 Assets/sdk);\r\n6. File \u2192 Build Settings
    \u2192 Android \u2192 Switch Platform;\r\n7. Project Settings \u2192 XR Plug-in
    Management \u2192 Install;\r\n8. Android \u6807\u7B7E\u9875\u52FE PICO;\u7B49\u7F16\u8BD1,\u62A5\u9519\u5C31\u91CD\u542F\u7F16\u8F91\u5668;\r\n9.
    Player Settings:Scripting Backend = IL2CPP;Target Architectures \u53EA\u52FE
    ARM64;\u53D6\u6D88 Auto Graphics API\u3001\u9996\u9009 Vulkan;Minimum API Level
    = 29;\r\n10. \u573A\u666F\u62D6\u5165 XR Inte\fraction Setup;XR Origin \u6302
    PXR_Manager;\r\n11. Build Settings \u2192 Add Open Scenes;\r\n12. PICO \u5F00\u542F\u5F00\u53D1\u8005\u6A21\u5F0F;USB
    \u8FDE\u63A5;\u5934\u663E\u5185\u5141\u8BB8 USB \u8C03\u8BD5\u6388\u6743;\r\n13.
    Build Settings \u2192 Build And Run;\r\n14. \u6234\u4E0A\u5934\u663E\u6309 07
    \u6587\u6863\u624B\u67C4\u64CD\u4F5C\u8DD1\u4E00\u904D;\r\n15. \u5BF9\u7167 06
    \u7684\"\u9A8C\u8BC1\u6E05\u5355\"\u9010\u9879\u6253\u52FE(\u5C04\u7EBF/\u4F20\u9001/\u53D1\u5149/\u6293\u4E66/\u9605\u8BFB/\u5E27\u7387)\u3002\r\n"
  slotCode: A1-2-07
