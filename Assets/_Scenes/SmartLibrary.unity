--- !u!114 &2145169709
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2145169707}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: daf404ac10c46324790e3afd8418ce81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: "\u5B9E\u73B0\u65B9\u6848 \xB7 04-\u4E66\u672C\u600E\u4E48\u5BFC\u5165\u4E0E\u624B\u52A8\u590D\u523B"
  author: "VRlibrary \u9879\u76EE\u7EC4"
  summary: "\n04 \u4E66\u672C\u600E\u4E48\u5BFC\u5165,\u662F\u5426\u53EF\u4EE5\u4EBA\u5DE5\u624B\u52A8\u590D\u523B\n\n>
    \u7ED3\u8BBA:\u5B8C\u5168\u53EF\u4EE5\u624B\u52A8\u590D\u523B\u3002\u81EA\u52A8\u5BFC\u5165\u53EA\u662F\u6279\u91CF\u7701\u4E8B,\u4E00\u672C\u4E66\u7684\u672C\u8D28
    = \u4E00\u4E2A Cube + 4 \u4E2A\u7EC4\u4EF6 + 1 \u4E2A\u4E66\u810A\u6807\u7B7E\u3002\n\n#\n\u4E00\u3001\u4E00\u672C\u4E66\u7684\u5B8C\u6574\u7ED3\u6784(\u4EE5\u771F\u5B9E\u4E66\u4E3A\u4F8B)\n\n\nBook_0_0_0                   
    \u2190 Cube \u539F\u578B,\u7F29\u653E\u7EA6 (0.42, 0.27, 0.10)\n\u251C\u2500\u2500
    [Cube Collider]           \u2190 \u539F\u751F\u78B0\u649E\u4F53(\u6293\u53D6\u611F\u5E94)\n\u251C\u2500\u2500
    [Rigidbody]               \u2190 Use Gravity \u2713,Interpolate\n\u251C\u2500\u2500
    [XR Grab Interactable]    \u2190 Movement Type = Velocity Tracking\n\u251C\u2500\u2500
    [LibraryBook]             \u2190 \u4E66\u540D/\u4F5C\u8005/\u7B80\u4ECB(\u9605\u8BFB\u5C4F\u6570\u636E\u6E90)\n\u2514\u2500\u2500
    SpineTitle            \f    \u2190 \u4E66\u810A\u6807\u9898(TextMesh \u7AD6\u7248\u6807\u7B7E)\n   
    \u251C\u2500\u2500 [TextMesh]            \u2190 characterSize 0.015,4 \u5B57/\u884C,\u65CB\u8F6C
    Y=180\xB0\n    \u2514\u2500\u2500 LabelPlate            \u2190 \u6DF1\u8272\u5E95\u677F
    Cube(0.44 \xD7 \u7EBF\u6570\xD70.078+0.02 \xD7 0.002)\n\n\n#\n\u4E8C\u3001\u4EBA\u5DE5\u624B\u52A8\u590D\u523B\u6B65\u9AA4(Inspector
    \u5168\u64CD\u4F5C,\u7EA6 2 \u5206\u949F/\u672C)\n\n1. \u5EFA\u4E66\u4F53:Hierarchy
    \u53F3\u952E \u2192 3D Object \u2192 Cube;\u7F29\u653E\u8BBE (0.34, 0.26, 0.06);\u6446\u5728\u4E66\u67B6\u4E0A(\u8D34\u5C42\u677F);\n2.
    \u4E0A\u6750\u8D28:\u628A `Assets/Materials/M_Book0~8.mat` \u4EFB\u4E00\u62D6\u5230\u4E66\u4E0A(9
    \u79CD\u4E66\u810A\u914D\u8272);\n3. \u53EF\u6293\u53D6:Add Component \u2192
    XR Grab Interactable(\u81EA\u52A8\u5E26 Rigidbody;Movement Type\f \u9009 Velocity
    Tracking;\u53D6\u6D88 Use Gravity \u53EF\u8BA9\u5B83\u60AC\u6D6E\u4E0D\u5760);\n4.
    \u6302\u6570\u636E\u7EC4\u4EF6:Add Component \u2192 LibraryBook;\u586B\u5199:\n  
    \xB7 Title:\u4E66\u540D(\u9605\u8BFB\u5C4F\u5927\u6807\u9898)\n   \xB7 Author:\u4F5C\u8005\n  
    \xB7 Summary:\u6B63\u6587\u3002\u957F\u6587\u5206\u9875:\u5728\u60F3\u8981\u5206\u9875\u7684\u5730\u65B9\u6253
    `\\f`(\u6216\u8FD0\u884C\u65F6\u81EA\u52A8\u6BCF 160 \u5B57\u5206\u4E00\u9875);\n5.
    \u4E66\u810A\u6807\u9898(\u53EF\u9009\u4F46\u63A8\u8350):\n   \xB7 \u4E66\u4E0B\u5EFA\u5B50\u7269\u4F53
    `SpineTitle`,Add Component \u2192 Text Mesh;\n   \xB7 Character Size = 0.015,Font
    Size = 48,Anchor/Alignment = Middle/Center,\u989C\u8272\u767D;\n   \xB7 \u4E2D\u6587\u9010\u5B57\u7AD6\u6392:\u6587\u672C\u6BCF\u5B57\u540E\u6309\u56DE\u8F66(\u5982
    `\u4E09\\n\u4F53\\n\u6307\\n\u5357`);\n   \xB7 \u65CB\u8F6C Y = 180\xB0(TextMesh
    \u6587\u5B57\u4ECE -Z \u9762\u9605\u8BFB,\u4E0D\u8F6C\u4F1A\u955C\u50CF!\f);\n  
    \xB7 \u4F4D\u7F6E:Z = \u4E66\u539A\u5EA6\u4E00\u534A + 0.004(\u8D34\u7740\u4E66\u810A\u9762);\n  
    \xB7 \u52A0\u5E95\u677F:\u518D\u5EFA\u4E00\u4E2A\u8584 Cube(0.44 \xD7 0.1 \xD7
    0.002)\u505A Text \u7684\u5B50\u7269\u4F53,\u6750\u8D28\u7528 `M_LabelPlate`(\u6DF1\u85CF\u9752);\n6.
    \u53EF\u9605\u8BFB\u9A8C\u8BC1:Play \u2192 \u5C04\u7EBF\u6307\u4E66\u6263\u6273\u673A(\u6216\u6293\u624B+\u6273\u673A)\u2192
    \u9605\u8BFB\u5C4F\u5F39\u51FA \u2192 \u6309\u94AE\u7FFB\u9875\u3002\n\n#\n\u4E09\u3001\u6279\u91CF\u81EA\u52A8\u5BFC\u5165(\u4E24\u6761\u8DEF)\n\n##\n\u8DEF
    A:JSON \u5BFC\u5165(\u63A8\u8350,\u6570\u636E\u4E0E\u573A\u666F\u5206\u79BB)\n\n1.
    \u7F16\u8F91 `Assets/Data/bookdata.json`(\u6A21\u677F\u5DF2\u7ED9):\njson\n[\n 
    { \"title\": \"\u4E09\u4F53\", \"author\": \"\u5218\u6148\u6B23\", \"summary\":
    \"\u7B2C\u4E00\u9875\u5185\u5BB9\\f\u7B2C\u4E8C\u9875\u5185\u5BB9\\f\u7B2C\u4E09\u9875\u5185\u5BB9\"
    },\n  { \"slot\": \"Book_0_0_3\", \"title\": \"\u6307\u5B9A\u683C\u5B50\u653E\",
    \"author\": \"\u2026\", \"summary\": \"\u2026\" }\n]\n\n2. \u83DC\u5355 `VRLibr\fary
    \u2192 \u5BFC\u5165\u9986\u85CF\u6570\u636E(JSON)`;\n3. \u89C4\u5219:\u6309\u987A\u5E8F\u586B\u5165\u573A\u666F\u4E66\u7C4D;\u5199
    `slot` \u53EF\u6307\u5B9A\u67D0\u683C;\u81EA\u52A8\u628A\u7269\u4F53\u6539\u540D\u6210\u4E66\u540D\u3002\n\n##\n\u8DEF
    B:\u76F4\u63A5\u8BFB\u6587\u4EF6\u5939(\u672C\u5DE5\u7A0B md \u4E66\u7C4D\u7684\u505A\u6CD5)\n\n\u7F16\u8F91\u5668\u4EE3\u7801\u8BFB
    `E:\\unity\u8D44\u6599\\\u65E5\u5E38\u95EE\u9898\u5904\u7406\u7ECF\u9A8C\\*.md`:\n\xB7
    \u6587\u4EF6\u540D \u2192 \u4E66\u540D;\u5185\u5BB9 \u2192 \u6E05\u6D17 markdown
    \u7B26\u53F7\u540E\u6BCF 400 \u5B57\u63D2 `\\f`;\n\xB7 \u5206\u914D\u5230\u5404\u4E66\u67B6\u4E2D\u5C42\u7684\u663E\u773C\u683C\u4F4D(\u4E0E\u5360\u4F4D\u4E66\u4EA4\u6362\u4F4D\u7F6E);\n\xB7
    \u987A\u624B\u751F\u6210\u4E66\u810A TextMesh + \u5E95\u677F\u3002\n\u6B64\u8DEF\u8D70\u7684\u662F
    MCP \u7684 `execute_code` \u5728\u7F16\u8F91\u5668\u91CC\u76F4\u63A5\u6267\u884C\u7684
    C#,\u811A\u672C\u903B\u8F91\u89C1\u672C\u6587\u6863\u9644\u5F55\u601D\u8DEF\u5373\u53EF\u590D\u523B\u3002\n\n#\n\u56DB\u3001\u624B\u52A8\u590D\u523B
    vs \u81EA\u52A8\u5BFC\u5165\u5BF9\u7167\n\n| \u4E8B\u9879 | \u624B\u52A8 | \u81EA\u52A8(JSON/MD)
    |\n| --\xB7 | --\xB7 | --\xB7 |\n| 1~5 \u672C\u4E66 | \u2705 \u63A8\u8350,\u76F4\u89C2
    | \u6CA1\u5FC5\u8981 |\n| \u51E0\u5341\u672C\u4EE5\u4E0A | \u7D2F,\u6613\u6F0F
    | \u2705 \u63A8\u8350 |\n| \u6362\u4E66/\u66F4\u65B0\u5185\u5BB9 | \u9010\u672C\u6539
    \fInspector | \u6539 json \u91CD\u8DD1\u4E00\u6B21 |\n| \u4E66\u810A\u6807\u7B7E
    | \u624B\u52A8\u5EFA(\u6216\u590D\u5236\u73B0\u6709\u4E66\u6539\u5B57) | \u811A\u672C\u81EA\u52A8\u751F\u6210
    |\n| \u51FA\u9519\u98CE\u9669 | \u4F4E(\u6240\u89C1\u5373\u6240\u5F97) | \u987A\u5E8F\u9519\u4F4D(slot
    \u5199\u6E05\u5373\u53EF) |\n\n#\n\u4E94\u3001\u5E38\u89C1\u95EE\u9898\n\n\xB7
    \u6293\u4E0D\u8D77\u6765:XR Grab Interactable \u6CA1\u6302 / Colliders \u5217\u8868\u4E3A\u7A7A(\u9ED8\u8BA4\u7528\u7269\u4F53\u81EA\u8EAB\u78B0\u649E\u4F53\u5373\u53EF);\n\xB7
    \u6263\u6273\u673A\u6CA1\u53CD\u5E94:\u786E\u8BA4\u5C04\u7EBF\u4EA4\u4E92\u5668
    `Allow Hovered Activate` \u5DF2\u52FE(\u573A\u666F\u91CC\u4E24\u4E2A Ray Interactor
    \u5DF2\u5F00);\u6216\u5148\u6293\u624B\u518D\u6273\u673A;\n\xB7 \u4E66\u810A\u5B57\u662F\u53CD\u7684:TextMesh
    \u6CA1\u8F6C 180\xB0;\n\xB7 \u9605\u8BFB\u5C4F\u53EA\u6709 1 \u9875:\u6B63\u5E38\u2014\u2014\u4E0D\u8DB3
    3 \u9875\u4F1A\u81EA\u52A8\u8865\"\u5F85\u5F55\u5165\"\u5360\u4F4D\u9875;\u60F3\u7CBE\u786E\u5206\u9875\u5C31\u5728
    summary \u91CC\u653E `\\f`\u3002\n\r\n---\r\n\r\n#\n\u8865\u5145:\u9605\u8BFB\u529F\u80FD\u63A5\u7EBF(\u8BA9\u4E66\"\u80FD\u6253\u5F00\")\u590D\u523B\u6B65\u9AA4\r\n\r\n\u4E66\u4F53\u505A\u597D(\u89C1\u4E0A\u6587\u7B2C\u4E8C\u8282)\u540E,\u8FD8\u8981\u4E09\u6B65\u63A5\u4E0A\u9605\u8BFB\u7CFB\u7EDF:\r\n\r\n1.
    \u573A\u666F\u91CC\u6709\u4E00\u5957\u9605\u8BFB\u9762\u677F:\u9762\f\u677F Canvas
    \u6302 BookReader \u811A\u672C(\u7ED3\u6784\u89C1 05 \u6587\u6863);\u786E\u8BA4\u9762\u677F\u7269\u4F53\u4FDD\u6301\u6FC0\u6D3B\u72B6\u6001(BookReader
    \u7684 Awake \u5728\u8FD0\u884C\u65F6\u4F1A\u81EA\u52A8\u628A\u5B83\u9690\u85CF);\r\n2.
    LibraryBook \u811A\u672C\u91CC\u63A5\u6273\u673A\u4E8B\u4EF6(\u672C\u5DE5\u7A0B
    LibraryBook.cs \u5DF2\u542B,\u81EA\u5199\u65F6\u7167\u6284):\r\n   csharp\r\n  
    void OnEnable() {\r\n       grab.activated.AddListener(OnActivated);   // \u6293\u7740\u6263\u6273\u673A\r\n  
    }\r\n   private void OnActivated(ActivateEventArgs args) {\r\n       if (BookReader.Instance
    != null) BookReader.Instance.Open(this);\r\n   }\r\n   \r\n3. \u514D\u6293\u53D6\u76F4\u63A5\u8BFB:\u5DE6\u53F3\u4E24\u4E2A
    Ray Interactor \u52FE\u9009 A\fllow Hovered Activate(\u5C04\u7EBF\u6307\u4E66\u6263\u6273\u673A\u5373\u5F00,\u4E0D\u7528\u5148\u6293\u624B);\r\n4.
    \u9A8C\u6536:Play \u2192 \u5C04\u7EBF\u6307\u4E66 \u2192 \u6273\u673A \u2192
    \u9762\u677F\u5F39\u51FA \u2192 \u6309\u94AE\u7FFB\u9875 \u2192 \u5173\u95ED\u3002\r\n"
  slotCode: A1-2-08
