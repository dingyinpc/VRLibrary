--- !u!114 &1485320771
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1485320769}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: daf404ac10c46324790e3afd8418ce81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: "\u6444\u50CF\u673A_\u7F16\u8F91\u6001\u5C0F\u8FD0\u884C\u6001\u5927_\u89C6\u91CE\u4E0D\u4E00\u81F4_\u95EE\u9898\u8BB0\u5F55"
  author: "\u65E5\u5E38\u95EE\u9898\u5904\u7406\u7ECF\u9A8C"
  summary: "\n\u6444\u50CF\u673A\uFF1A\u7F16\u8F91\u6001\u89C6\u91CE\u5C0F\u3001Play
    \u540E\u89C6\u91CE\u53D8\u5927\u7684\u95EE\u9898\u8BB0\u5F55\n\n> \u9879\u76EE\uFF1A\u5B88\u62A4\u841D\u535C
    V2\uFF08Unity 2022.3\uFF0C2D \u5854\u9632\uFF09\n> \u6D89\u53CA\u63D0\u4EA4\uFF1A`35af3e8`\uFF08\u4FEE\u590D\uFF09\u3001`GameBootstrap.SetupCamera`
    / `MainMenu.EnsureCamera` / `ResultScreen.EnsureCamera`\n> \u8BB0\u5F55\u65E5\u671F\uFF1AV2.1
    \u5F00\u5DE5\u524D\n\n#\n\u4E00\u3001\u8FD9\u4E2A\u95EE\u9898\u662F\u600E\u4E48\u4EA7\u751F\u7684\n\n\xB7
    \u9879\u76EE\u6709\u4E09\u573A\u666F\uFF1A\u4E3B\u754C\u9762 Menu / \u6E38\u620F\u754C\u9762
    Mcp / \u5931\u8D25\u7ED3\u7B97 Result\u3002\n\xB7 \u65E9\u671F\u4E09\u573A\u666F\u91CC\u53EA\u653E\"\u5BBF\u4E3B\u811A\u672C\u7269\u4F53\"\uFF08\u5982
    MainMenu / GameBootstrap / ResultScreen\uFF09\uFF0C\u76F8\u673A\u6CA1\u6709\u70D8\u7119\u8FDB\u573A\u666F\u2014\u2014\u573A\u666F\u6587\u4EF6\u91CC\u8981\u4E48\u6CA1\u6709\u76F8\u673A\uFF0C\u8981\u4E48\u8EBA\u7740\u4E00\u4E2A
    Unity \u65B0\u5EFA\u573A\u666F\u65F6\u7684\u9ED8\u8BA4\u76F8\u673A\u3002\n\xB7
    \u76F8\u673A\u7684\"\u771F\u5B9E\u53C2\u6570\"\u5168\u90E8\u5199\u6B7B\u5728\u8FD0\u884C\u65F6\u4EE3\u7801\u91CC\uFF1A\u8FDB
    Play \u65F6\u7531 `EnsureCamera` / `SetupCa\fmera` \u521B\u5EFA\u6216\u8986\u76D6\u3002\n\xB7
    \u4E8E\u662F\u51FA\u73B0\u4E24\u5957\u53C2\u6570\uFF1A\n  \xB7 \u573A\u666F\u6587\u4EF6\uFF08\u7F16\u8F91\u6001\u53EF\u89C1\uFF09=
    \u65E7\u53C2\u6570 / \u9ED8\u8BA4\u53C2\u6570\n  \xB7 \u8FD0\u884C\u65F6\u4EE3\u7801\uFF08Play
    \u65F6\u751F\u6548\uFF09= \u65B0\u53C2\u6570\n\xB7 \u4E24\u5957\u53C2\u6570\u4E0D\u4E00\u81F4
    \u2192 \u7F16\u8F91\u6001\u770B\u5230\u7684\u89C6\u91CE\u4E0E Play \u540E\u7684\u5B9E\u9645\u89C6\u91CE\u4E0D\u540C\u3002\n\n#\n\u4E8C\u3001\u53D1\u73B0\u4E86\u4EC0\u4E48\n\n1.
    \u73B0\u8C61\uFF1A\u5728 Scene/Game \u89C6\u56FE\uFF08\u7F16\u8F91\u6001\uFF09\u770B\uFF0C\u76F8\u673A\u6846\u5F88\u5C0F\u3001\u89C6\u91CE\u53EA\u6709\u5B9E\u9645\u7684\u4E00\u534A\uFF1B\u70B9
    Play \u540E\u76F8\u673A\u89C6\u91CE\u77AC\u95F4\u53D8\u5927\uFF0CUI \u5168\u5C4F\u94FA\u6EE1\uFF0C\"\u8986\u76D6\u754C\u9762\u53D8\u5927\"\u3002\n2.
    \u6839\u56E0\uFF08\u63D0\u4EA4 `35af3e8` \u5B9A\u4F4D\uFF09\uFF1AMcp \u573A\u666F\u91CC\u8EBA\u7684\u662F
    Unity \u9ED8\u8BA4\u76F8\u673A\uFF08\u6B63\u4EA4 size=5\uFF09\uFF0C\u800C `GameBootstrap.SetupCamera`
    \u4E00\u8FDB Play \u5C31\u628A\u5B83\u8986\u76D6\u6210 \u6B63\u4EA4 8.5 @ (2,0,-10)
    \u2014\u2014 \u7F16\u8F91\u6001 5 vs \u8FD0\u884C\u6001 8.5\uFF0C\u5DEE\u503C\u6B63\u597D\u662F\"\u4E00\u534A\u89C6\u91CE\"\u3002\n3.
    \u5EF6\u4F38\u53D1\u73B0\uFF1AMenu / Result \u573A\u666F\u6839\u672C\u6CA1\u6709\u70D8\u7119\u76F8\u673A\uFF0C\u8FD0\u884C\u65F6\u5404\u81EA
    `EnsureCamera\f` \u5199\u6B7B \u6B63\u4EA4 5 @ (0,0,-10)\u2014\u2014\u4E09\u573A\u666F\u76F8\u673A\u53C2\u6570\u4E09\u65B9\u6F02\u79FB\uFF085
    / 8.5 / 5\uFF09\u3002\n\n#\n\u4E09\u3001\u9700\u8981\u5728\u6444\u50CF\u673A\u4E0A\u505A\u4EC0\u4E48\u4FEE\u6539\u624D\u4F1A\u51FA\u73B0\u8FD9\u4E2A\u95EE\u9898\n\n\u89E6\u53D1\u6761\u4EF6\uFF08\u53EA\u6EE1\u8DB3\u4E00\u6761\u5373\u53EF\u51FA\u73B0\"\u7F16\u8F91\u6001\u5C0F\u3001Play
    \u540E\u5927\"\uFF09\uFF1A\n\n1. \u76F8\u673A\u53C2\u6570\u7531\u4EE3\u7801\u8986\u76D6\uFF0C\u4E14\u4EE3\u7801\u53C2\u6570
    \u2260 \u573A\u666F\u6587\u4EF6\u53C2\u6570\uFF1A\n   \xB7 \u4F8B\uFF1A\u573A\u666F\u91CC
    `orthographicSize=5`\uFF08\u9ED8\u8BA4\uFF09\uFF0C\u8FD0\u884C\u65F6 `SetupCamera`
    \u6539\u6210 `8.5`\u3002\n2. \u573A\u666F\u91CC\u6CA1\u70D8\u7119\u76F8\u673A\uFF08Menu/Result
    \u73B0\u72B6\uFF09\uFF1A\n   \xB7 \u7F16\u8F91\u6001 Game \u89C6\u56FE\u65E0\u76F8\u673A\u753B\u9762\uFF0CPlay
    \u540E\u4EE3\u7801 `new GameObject(\"Main Camera\")` \u73B0\u5EFA \u2192 \u5927\u5C0F/\u4F4D\u7F6E\u662F\u4EE3\u7801\u8BF4\u4E86\u7B97\u3002\n3.
    \u83DC\u5355\u70D8\u7119\u53EA\u505A\u4E86\u4E00\u90E8\u5206\u573A\u666F\uFF08`35af3e8`
    \u53EA\u70D8\u7119 Mcp\uFF09\uFF1A\n   \xB7 \u88AB\u70D8\u7119\u7684\u573A\u666F\u7F16\u8F91\u6001==\u8FD0\u884C\u6001\uFF1B\u6CA1\u70D8\u7119\u7684\u573A\u666F\u4F9D\u65E7\u6F02\u79FB\u3002\n\n#\n\u56DB\u3001\u7ED3\u679C\u662F\u4EC0\u4E48\n\n|
    \u573A\u666F | \u7F16\u8F91\u6001\u76F8\u673A | Play \u540E\u76F8\u673A | \f\u662F\u5426\u4E00\u81F4
    |\n|---|---|---|---|\n| Mcp \u6E38\u620F | \u9ED8\u8BA4 5\uFF08\u5C0F\u6846\uFF09\u2192
    \u4FEE\u590D\u540E\u70D8\u7119 8.5 @ (2,0,-10) | 8.5 @ (2,0,-10)\uFF08`SetupCamera`\uFF09
    | \u2705 \u70D8\u7119\u540E\u4E00\u81F4 |\n| Menu \u4E3B\u754C\u9762 | \u65E0\u76F8\u673A
    | 5 @ (0,0,-10)\uFF08`EnsureCamera` \u73B0\u5EFA\uFF09 | \u274C \u7F16\u8F91\u6001\u65E0\u753B\u9762
    |\n| Result \u5931\u8D25\u7ED3\u7B97 | \u65E0\u76F8\u673A | 5 @ (0,0,-10)\uFF08`EnsureCamera`
    \u73B0\u5EFA\uFF09 | \u274C \u7F16\u8F91\u6001\u65E0\u753B\u9762 |\n\n#\n\u4E94\u3001\u5B83\u7684\u4F18\u70B9\u662F\u4EC0\u4E48\n\n\xB7
    \u8FD0\u884C\u53C2\u6570\u96C6\u4E2D\uFF1A\u76F8\u673A\u5173\u952E\u53C2\u6570\uFF08\u6B63\u4EA4/\u5C3A\u5BF8/\u4F4D\u7F6E/\u80CC\u666F\u8272\uFF09\u5728\u4EE3\u7801\u91CC\u4E00\u5904\u5B9A\u4E49\uFF0C\u903B\u8F91\u53EF\u63A7\u3001\u53EF\u7248\u672C\u7BA1\u7406\u3002\n\xB7
    \u70D8\u7119\u65B9\u6848\uFF0835af3e8\uFF09\u89E3\u51B3\u7684\u95EE\u9898\uFF1A\u7F16\u8F91\u6001\u4E5F\u80FD\u770B\u5230\u4E0E\u8FD0\u884C\u65F6\u4E00\u81F4\u7684\u89C6\u91CE\uFF0CScene
    \u89C6\u56FE\u5E03 \u5C40/\u6444\u50CF\u673A\u6784\u56FE\u6240\u89C1\u5373\u6240\u5F97\uFF0C\u4E0D\u9700\u8981\u9760\u8111\u8865\u8FD0\u884C\u7ED3\u679C\u3002\n\xB7
    \u70D8\u7119\u662F\u5E42\u7B49\u7684\uFF08\u53EF\u91CD\u590D\u6267\u884C\u3001\u53EF\u968F\u65F6\u91CD\u70D8\u7119\uFF09\uFF0C\u4E0D\u6C61\u67D3\u903B\u8F91\f\u3002\n\n#\n\u516D\u3001\u5B83\u7684\u7F3A\u70B9\u662F\u4EC0\u4E48\n\n\xB7
    \u4EE3\u7801/\u573A\u666F\u53CC\u4EFD\u53C2\u6570\uFF1A\u8FD0\u884C\u65F6\u9760\u4EE3\u7801\u8986\u76D6\uFF0C\u573A\u666F\u91CC\u5B58\u7684\u662F\"\u5047\u72B6\u6001\"\uFF0C\u7F16\u8F91\u6001\u4E0E\u8FD0\u884C\u6001\u5929\u7136\u5BB9\u6613\u4E0D\u4E00\u81F4\u3002\n\xB7
    \u4FEE\u6539\u9057\u6F0F\u9762\u5927\uFF1A\u4E09\u573A\u666F\u5404\u5199\u5404\u7684
    `EnsureCamera`\uFF085 / 8.5 / 5\uFF09\uFF0C\u6539\u4E00\u5904\u5FD8\u4E24\u5904
    \u2192 \u53C2\u6570\u6F02\u79FB\u3001\u884C\u4E3A\u4E0D\u4E00\u81F4\u3002\n\xB7
    \u65E0\u76F8\u673A\u7684\u573A\u666F\uFF1A\u7F16\u8F91\u5668\u91CC\u770B\u4E0D\u89C1\u56FE\u5C42\u7ED3\u6784/\u753B\u5E03\u5E03\u5C40\uFF0C\u8C03\u8BD5\u548C\u4EA4\u4ED8\u524D\u7684\u68C0\u67E5\u9760
    Play \u624D\u77E5\u9053\u7ED3\u679C\u3002\n\xB7 \u53EA\u70D8\u7119\u5355\u4E2A\u573A\u666F\uFF0835af3e8\uFF09\u89E3\u51B3\u4E0D\u4E86\u5168\u5C40\u95EE\u9898\uFF0C\u53CD\u800C\u7559\u4E0B\"\u4E3A\u4EC0\u4E48\u8FD9\u4E2A\u573A\u666F\u6B63\u5E38\u3001\u90A3\u4E2A\u4E0D\u6B63\u5E38\"\u7684\u65B0\u56F0\u60D1\u3002\n\n#\n\u4E03\u3001\u5BF9\u6BD4\u539F\u672C\u7684\u6280\u672F\u6765\u8BF4\uFF0C\u5B83\u7684\u4F18\u52BF\u662F\u4EC0\u4E48\n\n\u539F\u672C\u505A\u6CD5
    = \u7EAF\u4EE3\u7801\u6784\u5EFA\uFF08\u6240\u6709\u76F8\u673A/UI \u8FD0\u884C\u65F6\u4E34\u65F6\u751F\u6210\uFF09\uFF1A\n\n|
    \u7EF4\u5EA6 | \u7EAF\u4EE3\u7801\u8FD0\u884C\u65F6\u751F\u6210 | \u573A\u666F\u70D8\u7119
    + \u4EE3\u7801\u515C\u5E95\uFF08\u73B0\u5728\u7684\u65B9\u5411\uFF09 |\n|---|---|---|\n|
    \u7F16\u8F91\u6001\u53EF\u89C1\u6027 | \u4E0D\u53EF\u89C1\uFF08\u7A7A\u573A\u666F\uFF09
    | \u2705 \u76F8\u673A/\u753B\u5E03/EventSystem \u76F4\u63A5\u53EF\u89C1\u53EF\u8C03
    |\n| \u542F\u52A8\u5F00\u9500 | \u6BCF\u6B21 Play \u4E34\u65F6 AddC\fomponent
    | \u2705 \u573A\u666F\u53CD\u5E8F\u5217\u5316\uFF0C\u514D\u6784\u5EFA\u6B65\u9AA4
    |\n| \u4E00\u81F4\u6027 | \u4EE3\u7801\u53C2\u6570\u6F02\u79FB\u65E0\u611F\u77E5
    | \u2705 \u70D8\u7119=\u8FD0\u884C\u53C2\u6570\uFF0C\u6240\u89C1\u5373\u6240\u5F97
    |\n| \u56DE\u9000/\u8C03\u6574 | \u6539\u4EE3\u7801\u91CD\u7F16\u8BD1 | \u2705
    \u6539\u573A\u666F\u6216\u4EE3\u7801\u7686\u53EF\uFF0C\u70D8\u7119\u4E00\u952E\u91CD\u751F\u6210
    |\n\n#\n\u516B\u3001\u600E\u4E48\u6837\u53BB\u590D\u73B0\n\n1. \u6253\u5F00 `Assets/Scenes/Mcp.unity`
    \u2192 \u5220\u9664\u573A\u666F\u91CC\u7684 Main Camera\uFF08\u6A21\u62DF\"\u6CA1\u6709\u70D8\u7119\u76F8\u673A\"\u7684\u72B6\u6001\uFF09\u3002\n2.
    \u89C2\u5BDF Scene \u89C6\u56FE\uFF1A\u65E0\u76F8\u673A\uFF08Game \u89C6\u56FE\u4E00\u7247\u5E95\u8272/\u7A7A\u767D\uFF09\u3002\n3.
    \u70B9 Play\uFF1A`GameBootstrap.SetupCamera` \u73B0\u5EFA\u76F8\u673A\uFF08\u6B63\u4EA4
    8.5 @ (2,0,-10)\uFF09\uFF0C\u89C6\u91CE\u77AC\u95F4\u5168\u5C4F\u3001UI \u94FA\u6EE1\u3002\n4.
    \u6682\u505C Play \u9009\u4E2D Main Camera\uFF1AInspector \u91CC `Orthographic
    size` \u4ECE\u65E0\u5230 8.5 \u2014\u2014 \u7F16\u8F91\u6001 vs \u8FD0\u884C\u6001\u7684\u5DEE\u8DDD\u4E00\u76EE\u4E86\u7136\u3002\n\n\u66F4\u8F7B\u91CF\u590D\u73B0\uFF08\u4E0D\u5220\u76F8\u673A\uFF09\uFF1A\n\xB7
    \u6253\u5F00 Mcp \u573A\f\u666F \u2192 \u76F4\u63A5\u770B Game \u89C6\u56FE\u7F16\u8F91\u6001\uFF08size=5
    \u5C0F\u89C6\u91CE\uFF09\u2192 \u70B9 Play\uFF08SetupCamera \u8986\u76D6\u4E3A
    8.5 \u5927\u89C6\u91CE\uFF09\u2192 \u5BF9\u6BD4\u3002\n\n#\n\u4E5D\u3001\u540E\u7EED\u6839\u6CBB\u65B9\u5411\uFF08V2.1
    \u57FA\u5EFA P0a\uFF09\n\n\xB7 \u4E09\u573A\u666F\u7EDF\u4E00\u70D8\u7119\u57FA\u5EA7\uFF1A\u4E3B\u76F8\u673A\uFF08\u6B63\u4EA4
    8.5 @ (2,0,-10)\uFF09+ UIRoot \u753B\u5E03 + EventSystem\u3002\n\xB7 \u65B0\u5EFA
    `SceneBootstrap` \u7EDF\u4E00\u521D\u59CB\u5316\u7C7B\uFF0C\u4E09\u5165\u53E3\uFF08Menu/Mcp/Result\uFF09\u6536\u655B\u4E94\u8FDE\uFF0C\u53C2\u6570\u5168\u5C40\u552F\u4E00\u3002\n\xB7
    \u76EE\u6807\uFF1A\u7F16\u8F91\u6001 \u2261 \u8FD0\u884C\u6001\uFF0C\u76F8\u673A/\u753B\u5E03\u6F02\u79FB\u95EE\u9898\u4ECE\u6839\u4E0A\u6D88\u5931\u3002"
  slotCode: D4-1-07
