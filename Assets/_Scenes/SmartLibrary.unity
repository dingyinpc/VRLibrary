--- !u!114 &2002280031
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2002280029}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: daf404ac10c46324790e3afd8418ce81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: "\u6C99\u7BB1_MCP_\u56FD\u5185\u955C\u50CF\u6E90_\u77E5\u8BC6\u95EE\u7B54\u603B\u7ED3"
  author: "\u65E5\u5E38\u95EE\u9898\u5904\u7406\u7ECF\u9A8C"
  summary: "\n\u6C99\u7BB1\u673A\u5236 \xB7 MCP \u534F\u8BAE \xB7 \u56FD\u5185\u955C\u50CF\u6E90
    \u2014\u2014 \u77E5\u8BC6\u95EE\u7B54\u603B\u7ED3\n\n> \u672C\u6587\u4EF6\u6574\u7406\u4E86\u56F4\u7ED5
    DSH\uFF08DeepSeek Harness\uFF09 \u73AF\u5883\u7684\u4E00\u6B21\u5BF9\u8BDD\u95EE\u7B54\uFF0C\u8986\u76D6\u4E09\u5927\u4E3B\u9898\uFF1A\u6C99\u7BB1\u673A\u5236\u3001MCP
    \u534F\u8BAE\u3001\u56FD\u5185\u955C\u50CF\u6E90\uFF0C\u4EE5\u53CA\u5B83\u4EEC\u4E0E\"\u7528
    AI \u64CD\u63A7 Unity \u9879\u76EE\"\u7684\u5173\u7CFB\u3002\n> \u6574\u7406\u65F6\u95F4\uFF1A\u672C\u6587\u6863\u7531\u5BF9\u8BDD\u5185\u5BB9\u603B\u7ED3\u751F\u6210\u3002\n\n---\n\n#\n\u76EE\u5F55\n\n1.
    [\u4E09\u5927\u4E3B\u9898\u4E00\u53E5\u8BDD\u603B\u89C8](#0-\u4E09\u5927\u4E3B\u9898\u4E00\u53E5\u8BDD\u603B\u89C8)\n2.
    [\u56FD\u5185\u955C\u50CF\u6E90](#1-\u56FD\u5185\u955C\u50CF\u6E90)\n3. [MCP
    \u534F\u8BAE](#2-mcp-\u534F\u8BAE)\n4. [\u6C99\u7BB1\u673A\u5236](#3-\u6C99\u7BB1\u673A\u5236)\n5.
    [\u5173\u4E8E\"\u6C99\u7BB1\u80FD\u52A0\u901F\u4E0B\u8F7D\"\u7684\u8BEF\u533A](#4-\u5173\u4E8E\u6C99\u7BB1\u80FD\u52A0\u901F\u4E0B\u8F7D\u7684\u8BEF\u533A)\n6.
    [\u7528 MCP / \u547D\u4EE4\u884C\u64CD\u63A7 Unity \u9879\u76EE](#5-\u7528-mcp--\u547D\u4EE4\u884C\u64CD\u63A7-unity-\u9879\u76EE)\n7.
    [\u5E38\u7528\u901F\u67E5\u6E05\u5355](#6-\u5E38\u7528\u901F\u67E5\u6E05\u5355)\n\n---\n\n#\n0.
    \u4E09\u5927\u4E3B\u9898\u4E00\u53E5\u8BDD\u603B\u89C8\n\n| \u4E3B\u9898 | \u4E00\u53E5\u8BDD\u672C\u8D28
    |\n|------|-----------\f|\n| \u6C99\u7BB1\u673A\u5236 | \u4E00\u5957\"\u6743\u9650\u9694\u79BB
    + \u53EF\u56DE\u6EDA + \u5B89\u5168\u53D7\u9650\"\u7684\u6267\u884C\u73AF\u5883\uFF0C\u8D1F\u8D23\u9694\u79BB\uFF0C\u4E0D\u8D1F\u8D23\u52A0\u901F
    |\n| MCP \u534F\u8BAE | \u7EDF\u4E00\"\u6A21\u578B \u2194 \u5916\u90E8\u5DE5\u5177/\u6570\u636E\"\u8FDE\u63A5\u65B9\u5F0F\u7684\u6807\u51C6\u534F\u8BAE\uFF0C\u76F8\u5F53\u4E8E
    AI \u4E16\u754C\u7684 USB-C \u63A5\u53E3 |\n| \u56FD\u5185\u955C\u50CF\u6E90
    | \u628A\u6D77\u5916\u8F6F\u4EF6\u4ED3\u5E93\"\u7EAF\u62F7\u8D1D\"\u5230\u56FD\u5185\u670D\u52A1\u5668\uFF0C\u89E3\u51B3\u4E0B\u8F7D\u6162\u3001\u8D85\u65F6\u3001\u4E0D\u7A33\u5B9A\u95EE\u9898
    |\n\n\u4E09\u8005\u5206\u5C42\u5173\u7CFB\uFF1A\n\n\xB7 \u6C99\u7BB1 \u2192 \u5B89\u5168\u9694\u79BB\u5C42\uFF08\u7BA1\"\u6267\u884C\u73AF\u5883\u8FB9\u754C\"\uFF09\n\xB7
    MCP \u2192 \u534F\u8BAE\u96C6\u6210\u5C42\uFF08\u7BA1\"\u6A21\u578B\u4E0E\u5DE5\u5177\u7684\u5BF9\u63A5\u65B9\u5F0F\"\uFF09\n\xB7
    \u56FD\u5185\u955C\u50CF\u6E90 \u2192 \u7F51\u7EDC\u57FA\u5EFA\u5C42\uFF08\u7BA1\"\u4F9D\u8D56\u83B7\u53D6\u7684\u901A\u9053\"\uFF09\n\n---\n\n#\n1.
    \u56FD\u5185\u955C\u50CF\u6E90\n\n##\n1.1 \u5B83\u5230\u5E95\u662F\u4EC0\u4E48\n\n\"\u955C\u50CF\uFF08mirror\uFF09\"\u5C31\u662F\u628A\u539F\u7248\u8F6F\u4EF6\u4ED3\u5E93\u5B8C\u6574\u590D\u5236\u4E00\u4EFD\u653E\u5230\u56FD\u5185\u670D\u52A1\u5668\uFF0C\u7528\u6765\u89E3\u51B3\u56FD\u5185\u76F4\u8FDE\u6D77\u5916\u6E90\uFF08npm\u3001PyPI\u3001GitHub
    \u7B49\uFF09\u65F6\u6162\u3001\u8D85\u65F6\u3001\u4E0D\u7A33\u5B9A\u7684\u95EE\u9898\u3002\u901F\u5EA6\u5DEE\u5F02\u5F80\u5F80\u8FBE\u4E00\u4E2A\u6570\u91CF\u7EA7\u3002\n\n##\n1.2
    \"\u7EAF\u955C\u50CF\"\u7684\u7406\u89E3\u662F\u5426\u6B63\u786E\uFF1F\n\n\u65B9\u5411\u6B63\u786E\uFF0C\u4F46\u6709\u4E09\u70B9\u8865\u5145\uFF1A\n\n1.
    \u6587\u4EF6\u5185\u5BB9 = \u7EAF\u62F7\u8D1D \u2705\uFF1A\u4ECE\f\u955C\u50CF\u4E0B\u8F7D\u7684\u5305\u4E0E\u5B98\u65B9\u6E90\u5B57\u8282\u5B8C\u5168\u4E00\u81F4\u3002\n2.
    \u4F46\u5B58\u5728\"\u540C\u6B65\u65F6\u6548\" \u26A0\uFE0F\uFF1A\u955C\u50CF\u7AD9\u662F\u5B9A\u65F6\u4ECE\u5B98\u65B9\u6E90\u62C9\u53D6\u66F4\u65B0\uFF0C\u5B58\u5728\u5EF6\u8FDF\u3002\u5185\u5BB9\u76F8\u540C\uFF0C\u4F46\"\u65B0\"\u7684\u7A0B\u5EA6\u53EF\u80FD\u4E0D\u540C\u3002\n3.
    \u5B58\u5728\u6781\u5C11\"\u975E\u7EAF\u955C\u50CF\"\u4F8B\u5916\uFF1A\u4E2A\u522B\u955C\u50CF\u4E3A\u5408\u89C4/\u8BBF\u95EE\u63A7\u5236\u53EF\u80FD\u5C4F\u853D\u6216\u66FF\u6362\u4E2A\u522B\u5305\uFF08\u4E3B\u6D41\u6E05\u534E\u3001\u963F\u91CC\u3001npmmirror
    \u57FA\u672C\u5E72\u51C0\uFF09\u3002\n\n##\n1.3 \u5B89\u5168\u515C\u5E95\n\n\u955C\u50CF\u6BD5\u7ADF\u662F\u7B2C\u4E09\u65B9\u670D\u52A1\u5668\uFF0C\u4E25\u8C28\u505A\u6CD5\u662F\u4FDD\u7559\u5B98\u65B9\u6E90\u7684
    checksum / \u5B8C\u6574\u6027\u6821\u9A8C\uFF08npm lockfile\u3001pip hash \u6821\u9A8C\uFF09\uFF0C\u5373\u4F7F\u955C\u50CF\u88AB\u7BE1\u6539\u4E5F\u80FD\u53D1\u73B0\u3002\n\n##\n1.4
    \u5E38\u89C1\u955C\u50CF\u6E90\u4E0E\u914D\u7F6E\n\n| \u7C7B\u522B | \u5B98\u65B9\u6E90
    | \u56FD\u5185\u955C\u50CF | \u914D\u7F6E\u793A\u4F8B |\n|------|--------|----------|----------|\n|
    Python | PyPI | \u6E05\u534E TUNA\u3001\u963F\u91CC\u4E91\u3001\u4E2D\u79D1\u5927
    | `pip install x -i https://pypi.tuna.tsinghua.edu.cn/simple` |\n| \fNode | npm
    | \u6DD8\u5B9D npmmirror | `npm config set registry https://registry.npmmirror.com`
    |\n| \u4EE3\u7801\u6258\u7BA1 | GitHub | Gitee\u3001ghproxy | \u4ED3\u5E93\u8FC1\u79FB
    / \u4EE3\u7406\u52A0\u901F |\n| \u5BB9\u5668 | Docker Hub | \u963F\u91CC\u4E91
    ACR\u3001DaoCloud\u3001\u4E2D\u79D1\u5927 | `daemon.json` \u914D `registry-mirrors`
    |\n| \u7CFB\u7EDF | Ubuntu apt | \u6E05\u534E\u3001\u963F\u91CC\u4E91\u3001\u7F51\u6613
    | \u66FF\u6362 `sources.list` |\n| \u5176\u4ED6 | Homebrew/Maven/crates/go |
    \u6E05\u534E/\u963F\u91CC\u5747\u6709 | \u6539 registry |\n\n##\n1.5 \u4F7F\u7528\u6CE8\u610F\u4E8B\u9879\n\n1.
    \u5B89\u5168\u4FE1\u4EFB\uFF1A\u5B89\u5168\u654F\u611F\u9879\u76EE\u5EFA\u8BAE\u6821\u9A8C\u5305\u7B7E\u540D/checksum\u3002\n2.
    \u65F6\u6548\u6027\uFF1A\u540C\u6B65\u6709\u5EF6\u8FDF\uFF0C\u6781\u65B0\u7248\u672C\u53EF\u80FD\u6682\u65F6\u6CA1\u6709\uFF0C\u5FC5\u8981\u65F6\u56DE\u9000\u5B98\u65B9\u6E90\u3002\n3.
    \u653F\u7B56\f\u53D8\u66F4\uFF1A\u4E2A\u522B\u955C\u50CF\u7AD9\u53EF\u80FD\u5173\u95ED/\u53D8\u66F4\uFF0C\u9700\u5173\u6CE8\u53EF\u7528\u72B6\u6001\u3002\n4.
    \u9009\"\u8FD1\"\u539F\u5219\uFF1A\u591A\u7AD9\u5BF9\u6BD4\uFF0C\u9009\u5EF6\u8FDF\u4F4E\u3001\u7A33\u5B9A\u3001\u53E3\u7891\u597D\u7684\u3002\n\n---\n\n#\n2.
    MCP \u534F\u8BAE\n\n##\n2.1 \u4E00\u53E5\u8BDD\u7406\u89E3\n\nMCP\uFF08Model
    Context Protocol\uFF0C\u6A21\u578B\u4E0A\u4E0B\u6587\u534F\u8BAE\uFF09\u662F
    Anthropic \u5728 2024 \u5E74\u5E95\u63D0\u51FA\u7684\u5F00\u653E\u534F\u8BAE\uFF0C\u7EDF\u4E00\"\u5927\u6A21\u578B
    \u2194 \u5916\u90E8\u5DE5\u5177/\u6570\u636E\u6E90\"\u7684\u8FDE\u63A5\u65B9\u5F0F\uFF0C\u76F8\u5F53\u4E8E
    AI \u4E16\u754C\u7684 USB-C \u63A5\u53E3\u2014\u2014\u5199\u4E00\u6B21\u5DE5\u5177\uFF0C\u5904\u5904\u53EF\u7528\u3002\n\n##\n2.2
    \u67B6\u6784\n\n\u7ECF\u5178\u5BA2\u6237\u7AEF-\u670D\u52A1\u7AEF\u6A21\u578B\uFF0C\u5E95\u5C42\u4F20\u8F93\u7528
    JSON-RPC 2.0\uFF08\u8DD1\u5728 stdio \u6216 Streamable HTTP \u4E0A\uFF09\uFF1A\n\n\n\u250C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510  
    MCP   \u250C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\n\u2502  
    \u4E3B\u673A Host   \u2502 \u25C4\u2500\u2500\u2500\u2500\u2500\u25BA \u2502 
    MCP \u670D\u52A1\u5668   \u2502\n\u2502  (AI \u5E94\u7528/\u6A21\u578B) \u2502 
    JSON-RPC \u2502  (\u63D0\u4F9B\u5DE5\u5177/\u8D44\u6E90)\u2502\n\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518
    \f 2.0    \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\n\n\n\xB7
    Host\uFF08\u4E3B\u673A\uFF09\uFF1A\u8FD0\u884C\u6A21\u578B\u7684 AI \u5E94\u7528\uFF08Claude
    Desktop\u3001VS Code\u3001DSH \u7B49\uFF09\u3002\n\xB7 Client\uFF08\u5BA2\u6237\u7AEF\uFF09\uFF1A\u4E3B\u673A\u5185\u90E8\u8FDE\u63A5\u670D\u52A1\u5668\u7684\u7EC4\u4EF6\u3002\n\xB7
    Server\uFF08\u670D\u52A1\u5668\uFF09\uFF1A\u66B4\u9732\u5DE5\u5177/\u8D44\u6E90/\u63D0\u793A\u7684\u72EC\u7ACB\u8FDB\u7A0B\u6216\u670D\u52A1\u3002\n\n##\n2.3
    \u4E09\u79CD\u6838\u5FC3\u80FD\u529B\u539F\u8BED\n\n1. Tools\uFF08\u5DE5\u5177\uFF09\uFF1A\u6A21\u578B\u53EF\u8C03\u7528\u7684\u51FD\u6570\uFF0C\u6709\u660E\u786E\u8F93\u5165/\u8F93\u51FA
    schema\u3002\n2. Resources\uFF08\u8D44\u6E90\uFF09\uFF1A\u53EF\u8BFB\u53D6\u7684\u4E0A\u4E0B\u6587\u6570\u636E\uFF08\u6587\u4EF6\u3001\u6570\u636E\u5E93\u3001\u6587\u6863\uFF09\u3002\n3.
    Prompts\uFF08\u63D0\u793A\uFF09\uFF1A\u53EF\u590D\u7528\u7684\u63D0\u793A\u6A21\u677F\u3002\n\n##\n2.4
    \u4E00\u6B21\u771F\u5B9E\u8C03\u7528\u957F\u4EC0\u4E48\u6837\n\n\n\u5217\u5DE5\u5177
    \u2192 \u770B\u8BF4\u660E\u4E66 \u2192 \u586B\u53C2\u6570 \u2192 \u5F97\u7ED3\u679C\n\n\u7B2C1\u6B65
    \u5217\u51FA\u53EF\u7528\u5DE5\u5177    \u2192 [{name:\"read_file\",...}, {name:\"run_command\",...},
    ...]\n\u7B2C2\u6B65 \u9009\u5DE5\u5177\u5E76\u770Bschema \u2192 run_command \u53C2\u6570
    = { com\fmand, workdir? }\n\u7B2C3\u6B65 \u586B\u53C2\u6570\u8C03\u7528     
    \u2192 {\"command\":\"node --version\",\"workdir\":\"\u9879\u76EE\u76EE\u5F55\"}\n\u7B2C4\u6B65
    \u670D\u52A1\u5668\u8FD4\u56DE\u7ED3\u679C   \u2192 \"v20.11.1\"\n\n\n##\n2.5
    \u76F4\u89C2\u7C7B\u6BD4\n\n\xB7 \u6CA1\u6709 MCP\uFF1A\u6BCF\u6765\u4E00\u4E2A\u65B0\u8BBE\u5907/\u5DE5\u5177\u90FD\u8981\u5199\u4E00\u5957\u79C1\u6709\u96C6\u6210\uFF0C\u683C\u5F0F\u8FD8\u4E0D\u7EDF\u4E00\u3002\n\xB7
    \u6709 MCP\uFF1A\u6240\u6709\u5DE5\u5177\u7EDF\u4E00\"\u7535\u6E90\u63D2\u5934
    + \u52A8\u6001\u8BF4\u660E\u4E66\"\uFF0C\u5373\u63D2\u5373\u7528\u3002\n\n##\n2.6
    MCP \u9020\u6210\u7684\"\u7ED3\u679C\"\n\n\u628A\u6A21\u578B\u4ECE\"\u53EA\u4F1A\u8BF4\"\u53D8\u6210\"\u4F1A\u505A\"\u2014\u2014\u80FD\u771F\u6B63\u8BFB\u5199\u6587\u4EF6\u3001\u6267\u884C\u547D\u4EE4\u3001\u8BBF\u95EE\u6570\u636E\uFF0C\u7ED9\u51FA\u6709\u5B9E\u9645\u4F9D\u636E\u3001\u53EF\u88AB\u9A8C\u8BC1\u7684\u7ED3\u679C\uFF0C\u800C\u975E\u51ED\u7A7A\u731C\u6D4B\u3002\n\n\u5173\u952E\u6F84\u6E05\uFF1AMCP
    \u2260 \u64CD\u63A7\u9F20\u6807\uFF08GUI\uFF09\u3002 MCP \u662F\"\u7ED3\u6784\u5316\u8C03\u7528\u5DE5\u5177/\u547D\u4EE4/API\"\uFF0C\u5C5E\u4E8E\u5DE5\u5177\u96C6\u6210\u5C42\uFF1B\u771F\u6B63\"\u52A8\u9F20\u6807\u3001\u70B9\u6309\u94AE\u3001\u770B\u5C4F\u5E55\"\u662F\u53E6\u4E00\u5957\"\u8BA1\u7B97\u673A\u4F7F\u7528
    / GUI \u81EA\u52A8\u5316\"\u673A\u5236\uFF08\u5982 Anthropic Computer Use\u3001pyautogui\uFF09\u3002\n\n---\n\n#\n3.
    \u6C99\u7BB1\u673A\u5236\n\n##\n3\f.1 \u4E00\u53E5\u8BDD\u672C\u8D28\n\n\u6C99\u7BB1\u662F\u4E00\u5957\u6743\u9650\u9694\u79BB
    + \u53EF\u56DE\u6EDA + \u5B89\u5168\u53D7\u9650\u7684\u6267\u884C\u73AF\u5883\uFF0C\u6838\u5FC3\u76EE\u6807\u662F\u9694\u79BB\uFF0C\u4E0D\u662F\u52A0\u901F\u3002\n\n##\n3.2
    \u4E09\u5927\u6838\u5FC3\u4EF7\u503C\n\n1. \u9694\u79BB\uFF08Isolation\uFF09\uFF1A\u6BCF\u4E2A\u4EFB\u52A1\u6709\u72EC\u7ACB\u6587\u4EF6\u7CFB\u7EDF/\u73AF\u5883/\u72B6\u6001\uFF0C\u4EFB\u52A1
    A \u51FA\u9519\u4E0D\u5F71\u54CD\u4EFB\u52A1 B\u3002\n2. \u56DE\u6EDA\uFF08Rollback
    / Cleanup\uFF09\uFF1A\u51FA\u95EE\u9898\u76F4\u63A5\u6574\u4F53\u91CD\u7F6E\u5230\u5E72\u51C0\u72B6\u6001\uFF0C\u4E0D\u7559\u6B8B\u7559\u3002\n3.
    \u5B89\u5168\uFF08Security\uFF09\uFF1A\u53D7\u9650\u8FD0\u884C\uFF0C\u672A\u6388\u6743\u64CD\u4F5C\u88AB\u6321\u4F4F\uFF0C\u4FDD\u62A4\u5BBF\u4E3B\u3002\n\n##\n3.3
    DSH \u4E2D\u7684\u6743\u9650\u6A21\u5F0F\uFF08\u4ECE\u7A84\u5230\u5BBD\uFF09\n\n|
    \u6A21\u5F0F | \u542B\u4E49 | \u80FD\u505A\u4EC0\u4E48 |\n|------|------|----------|\n|
    read-only\uFF08\u53EA\u8BFB\uFF09 | \u53EA\u80FD\u8BFB\uFF0C\u4E0D\u80FD\u6539
    | \u8BFB\u6587\u4EF6\u3001\u53EA\u8BFB\u547D\u4EE4\u3001glob/grep/read |\n| workspace-write\uFF08\u5DE5\u4F5C\u533A\u5199\uFF09
    | \u53EF\u6539\u5DE5\u4F5C\u533A\u6587\u4EF6 | \u5199/\u7F16\u8F91\u5F53\u524D\u9879\u76EE\u76EE\u5F55
    |\n| danger-full-access\uFF08\u5B8C\u5168\u8BBF\u95EE\uFF09 | \u653E\u5F00\u6240\u6709\u9650\u5236
    | \u4EFB\u610F\u8DEF\f\u5F84\u3001\u4EFB\u610F\u547D\u4EE4 |\n\n##\n3.4 \u6838\u5FC3\u673A\u5236\uFF1A\"\u5148\u62D2\u7EDD\u3001\u518D\u5347\u7EA7\"\uFF08deny
    then escalate\uFF09\n\n\xB7 \u64CD\u4F5C\u89E6\u53D1\u5F53\u524D\u6743\u9650\u4E0D\u5141\u8BB8\u7684\u8BBF\u95EE
    \u2192 \u8FD4\u56DE\u62D2\u7EDD\u6807\u8BB0\uFF0C\u5982\n  `[sandbox: file access
    denied under <mode> mode]`\u3002\n\xB7 \u8FD9\u662F\u6709\u610F\u7684\u653F\u7B56\u8FB9\u754C\uFF0C\u4E0D\u662F
    bug\u3002\n\xB7 \u5BF9\u8FD9\u4E00\u4E2A\u547D\u4EE4\u7533\u8BF7\u4E00\u6B21\u66F4\u5BBD\u6743\u9650\uFF08`sandbox_permissions`
    + \u4E00\u53E5 justification\uFF09\uFF0C\u7528\u6237\u6279\u51C6\u540E\u91CD\u8BD5\u3002\n\xB7
    \u4E0D\u9884\u5224\u3001\u4E0D\u7ED5\u9053\u3001\u62D2\u7EDD\u540E\u624D\u5347\u7EA7\u3002\n\n##\n3.5
    \u4E24\u4E2A\u503C\u5F97\u6CE8\u610F\u7684\u7EA6\u675F\n\n\xB7 \u8FDB\u7A0B\u901A\u4FE1\u9650\u5236\uFF1A\u6C99\u7BB1\u5185\u8FDB\u7A0B\u65E0\u6CD5\u6253\u5F00\u547D\u540D\u7BA1\u9053\uFF08named
    pipes\uFF09\uFF0C\u7528\u7BA1\u9053\u6355\u83B7\u5B50\u8FDB\u7A0B\u8F93\u51FA\uFF08Node
    `stdio:'pipe'`\uFF09\u4F1A EPERM\uFF1B\u7528 `inherit`/`ignore` \u5219\u6B63\u5E38\u3002\n\xB7
    \u6267\u884C\u6A21\u5F0F\u9650\u5236\uFF1A\u53EA\u8BFB\u6A21\u5F0F\u4E0B PowerShell
    \u8DD1\u5728 ConstrainedLanguage \u6A21\u5F0F\uFF0C\u90E8\u5206 \f.NET \u9759\u6001\u8C03\u7528\uFF08`[System.IO.*]::`\u3001`Add-Type`\u3001COM\u3001\u53CD\u5C04\uFF09\u62A5
    \"only core types\" \u9519\u8BEF\uFF1Bworkspace-write \u901A\u5E38 FullLanguage\u3002\n\n##\n3.6
    \u5E38\u89C1\u8BEF\u89E3\u7EA0\u6B63\uFF08\u91CD\u8981\uFF09\n\n| \u8BEF\u89E3
    | \u771F\u76F8 |\n|------|------|\n| \u6C99\u7BB1\u80FD\u4FDD\u8BC1\u5185\u5B58\u4E0D\u6CC4\u6F0F
    | \u274C \u4E0D\u80FD\"\u6CBB\u597D\"\u6CC4\u6F0F\uFF1B\u53EA\u80FD\u9650\u5236\u5185\u5B58\u4E0A\u9650
    + \u9500\u6BC1\u65F6\u5F7B\u5E95\u56DE\u6536 |\n| \u6C99\u7BB1\u80FD\u89E3\u51B3\u62A2\u5E26\u5BBD
    | \u274C \u6C99\u7BB1\u5171\u7528\u540C\u4E00\u6761\u7269\u7406\u7F51\u7EDC\uFF0C\u7167\u6837\u62A2\u5E26\u5BBD
    |\n| \u6C99\u7BB1\u80FD\u89E3\u51B3\u5E76\u884C\u4E0B\u8F7D\u65F6\u7684\u5185\u5B58\u6CC4\u6F0F
    | \u274C \u6C99\u7BB1\u53EA\u662F\"\u515C\u5E95\"\uFF0C\u963B\u6B62\u4E0D\u4E86\u6CC4\u6F0F\u672C\u8EAB
    |\n| \u6C99\u7BB1\u80FD\u52A0\u901F\u4E0B\u8F7D | \u274C \u6C99\u7BB1\u662F\u9694\u79BB\uFF0C\u4E0D\u662F\u52A0\u901F\u5668\uFF08\u8BE6\u89C1\u7B2C
    4 \u8282\uFF09 |\n\n\u6C99\u7BB1\u771F\u6B63\u9694\u79BB\u7684\u662F\u72B6\u6001/\u73AF\u5883\u51B2\u7A81\uFF08\u6587\u4EF6\u3001\u914D\u7F6E\u3001\u7AEF\u53E3\u3001\u4F9D\u8D56\uFF09\uFF0C\u4E0D\u662F\u5E26\u5BBD/\u5185\u5B58\u3002\n\n---\n\n#\n4.
    \u5173\u4E8E\"\u6C99\u7BB1\u80FD\u52A0\u901F\u4E0B\u8F7D\"\u7684\u8BEF\u533A\n\n##\n4.1
    \u7ED3\u8BBA\n\n\"\u591A\u5F00\u51E0\u4E2A\u6C99\u7BB1\u5C31\u80FD\u628A\u9879\u76EE\u6587\u4EF6\u66F4\u5FEB\u4E0B\u8F7D\u4E0B\u6765\"\u2014\u2014\u4E0D\u6B63\u786E\u3002
    \u6C99\u7BB1\u4E0D\u662F\u4E0B\u8F7D\f\u52A0\u901F\u5668\u3002\n\n##\n4.2 \u4E3A\u4EC0\u4E48\u4E0D\u5BF9\n\n1.
    \u6C99\u7BB1\u4E0D\u63D0\u4F9B\u989D\u5916\u5E26\u5BBD\u3002\u4E0B\u8F7D\u901F\u5EA6\u53D6\u51B3\u4E8E\u7F51\u7EDC\u5E26\u5BBD\u548C\u4E0B\u8F7D\u6E90\u51FA\u53E3\u901F\u5EA6\uFF0C\u5F00\u591A\u5C11\u6C99\u7BB1\u90FD\u4E0D\u6539\u53D8\u8FD9\u6761\u94FE\u8DEF\u3002\n2.
    \u591A\u5F00\u6C99\u7BB1\u53CD\u800C\u66F4\u6162\uFF1A\u5404\u81EA\u5360\u5185\u5B58/CPU/\u78C1\u76D8\uFF0C\u62A2\u8D44\u6E90
    + \u91CD\u590D\u4E0B\u8F7D\u540C\u4E00\u4EFD\u6587\u4EF6\u3002\n3. \u6C99\u7BB1\u7684\u6B63\u786E\u4F5C\u7528\u662F\"\u9694\u79BB\u5730\u5E76\u884C\u505A\u4E0D\u540C\u7684\u4E8B\"\uFF0C\u4E0D\u662F\u52A0\u901F\u5355\u4E2A\u4EFB\u52A1\u3002\n\n##\n4.3
    \"\u5FEB\"\u4ECE\u54EA\u6765\uFF1F\u2014\u2014 \u662F\"\u5E76\u884C\"\uFF0C\u4E0D\u662F\"\u6C99\u7BB1\"\n\n|
    \u573A\u666F | \u6B63\u786E\u505A\u6CD5 | \u4E3A\u4EC0\u4E48\u5FEB |\n|------|----------|----------|\n|
    \u5355\u4E2A\u5927\u6587\u4EF6 | \u591A\u7EBF\u7A0B/\u5206\u7247\u4E0B\u8F7D
    | \u5207\u6210 N \u6BB5\u540C\u65F6\u4E0B\u8F7D |\n| \u9879\u76EE\u591A\u4E2A\u6A21\u5757
    | \u5E76\u884C\u6784\u5EFA\u4E0D\u540C\u6A21\u5757 | \u6BCF\u6A21\u5757\u72EC\u7ACB\u8DD1\uFF0C\u540C\u65F6\u5F00\u5DE5
    |\n| \u591A\u4E2A\u72EC\u7ACB\u4EFB\u52A1 | \u5E76\u884C\u8DD1\u591A\u4E2A\u4EFB\u52A1
    | \u6BCF\u4EFB\u52A1\u4E00\u4E2A\u6C99\u7BB1\uFF0C\u540C\u65F6\u8FDB\u884C |\n\n>
    \"\u5E76\u884C\"\u80FD\u52A0\u901F\uFF08\u5229\u7528\u591A\u6838/\u591A\u5E26\u5BBD\uFF09\uFF0C\"\u6C99\u7BB1\"\u8D1F\u8D23\u9694\u79BB\uFF0C\u4E8C\u8005\u5E38\u642D\u914D\u51FA\u73B0\uFF0C\u6545\u6613\u88AB\u8BEF\u8BA4\u4E3A\"\u6C99\u7BB1\u80FD\u52A0\u901F\"\u3002\u5E76\u884C\u7684\u662F\"\u4E0D\u540C\u6587\u4EF6/\u4EFB\u52A1\"\uFF0C\u4E0D\u662F\"\u540C\u4E00\u4E2A\u6587\u4EF6\"\uFF1B\u74F6\u9888\u5728\u7F51\u7EDC\u65F6\uFF0C\u5E76\f\u884C\u4E5F\u6551\u4E0D\u4E86\uFF08\u5E26\u5BBD\u5171\u4EAB\uFF09\u3002\n\n##\n4.4
    \"\u5199\u4E24\u4E2A\u6587\u4EF6 / \u5199\u540C\u4E00\u6587\u4EF6\"\u7684\u6B63\u786E\u7406\u89E3\n\n\xB7
    \u4E24\u4E2A\u6C99\u7BB1\u5404\u5199\u4E0D\u540C\u6587\u4EF6 \u2192 \u2705 \u5E76\u884C\u6709\u6548\uFF0C\u901F\u5EA6\u53EF\u63A5\u8FD1\u53CC\u500D\uFF08\u524D\u63D0\uFF1A\u74F6\u9888\u5728\u672C\u5730\u78C1\u76D8/CPU\uFF0C\u800C\u975E\u7F51\u7EDC\uFF09\u3002\n\xB7
    \u4E24\u4E2A\u6C99\u7BB1\u5199\u540C\u4E00\u6587\u4EF6 \u2192 \u274C \u6CA1\u6709\"\u53CC\u500D\u901F\"\uFF1A\n 
    \xB7 \u9694\u79BB\u6A21\u578B\u4E0B = \u5404\u5199\u5404\u7684\u526F\u672C\uFF0C\u4E0D\u5408\u5E76\uFF1B\n 
    \xB7 \u5171\u4EAB\u6302\u8F7D\u4E0B = \u5E76\u53D1\u51B2\u7A81\uFF0C\u4F1A\u635F\u574F\u3002\n 
    \xB7 \u540C\u4E00\u4EFD\u6570\u636E\u5199\u540C\u4E00\u6587\u4EF6\uFF0C\u7269\u7406\u4E0A\u53EA\u80FD\u4E32\u884C\u3002\n\n##\n4.5
    \u4E09\u6761\u94C1\u5F8B\n\n1. \u5E76\u884C\u7684\u662F\u4E0D\u540C\u7684\u6587\u4EF6/\u4EFB\u52A1\uFF0C\u4E0D\u662F\u540C\u4E00\u4E2A\u6587\u4EF6\u3002\n2.
    \u52A0\u901F\u9760\u5E76\u884C\uFF0C\u6C99\u7BB1\u53EA\u8D1F\u8D23\u9694\u79BB\u3002\n3.
    \u74F6\u9888\u5728\u7F51\u7EDC\u65F6\uFF0C\u5E76\u884C\u4E5F\u6551\u4E0D\u4E86\uFF08\u5E26\u5BBD\u5171\u4EAB\uFF09\u3002\n\n##\n4.6
    \u5B9E\u64CD\uFF1A\u5230\u5E95\u600E\u4E48\"\u591A\u7EBF\u7A0B / \u5E76\u884C\"\u4E0B\u8F7D\n\n>
    \u627F\u63A5\u4E0A\u6587\uFF1A\"\u591A\u7EBF\u7A0B\"\u548C\"\u5E76\u884C\"\u662F\u4E24\u79CD\u4E0D\u540C\u7684\u4E8B\uFF0C\u65B9\u5411\u4E0D\u540C\uFF0C\u7528\u7684\u5DE5\u5177\u4E5F\u4E0D\u540C\u3002\n\n|
    \u9700\u6C42 | \u6B63\u786E\u7684\u505A\u6CD5 | \u7528\u4EC0\u4E48 | \u5173\u952E\u70B9
    |\n|------|-----------|--------|--------|\n| \u5355\u4E2A\u5927\u6587\u4EF6 |
    \u5206\u7247\u591A\u7EBF\u7A0B\u4E0B\u8F7D\uFF08\u628A\f\u540C\u4E00\u6587\u4EF6\u5207
    N \u6BB5\u540C\u65F6\u4E0B\uFF09 | aria2\u3001IDM\u3001Motrix\u3001\u8FC5\u96F7
    | \u4F9D\u8D56\u670D\u52A1\u5668\u652F\u6301\u5206\u6BB5\uFF08Range \u8BF7\u6C42\uFF09\uFF1B\u4E0D\u652F\u6301\u5219\u6551\u4E0D\u4E86
    |\n| \u591A\u4E2A\u6587\u4EF6 / \u591A\u4E2A\u5305 | \u540C\u65F6\u5F00 N \u6761\u8FDE\u63A5\u4E0B\u8F7D\u4E0D\u540C\u6587\u4EF6
    | `aria2c -j8`\u3001`wget -i \u5217\u8868.txt`\u3001\u5305\u7BA1\u7406\u5668
    | pip / npm \u9ED8\u8BA4\u5DF2\u5E76\u53D1\uFF0C\u65E0\u9700\u624B\u52A8\u5F00\u7EBF\u7A0B
    |\n| \u591A\u4E2A\u72EC\u7ACB\u4EFB\u52A1\uFF08DSH \u573A\u666F\uFF09 | \u6BCF\u4E2A\u4EFB\u52A1\u5355\u72EC\u4E00\u4E2A\u6C99\u7BB1/\u540E\u53F0
    job \u540C\u65F6\u8DD1 | \u4EFB\u52A1 A\u2192\u6C99\u7BB11\uFF0C\u4EFB\u52A1
    B\u2192\u6C99\u7BB12 \u2026 | \u6BCF\u6C99\u7BB1\u5904\u7406\u4E0D\u540C\u6587\u4EF6\uFF0C\u4E92\u4E0D\u5E72\u6270
    |\n| \u74F6\u9888\u662F\u7F51\u901F | \u6362\u4EFB\u4F55\"\u5E76\u884C\"\u90FD\u6CA1\u7528
    | \u2014 | \u5148\u6362\u56FD\u5185\u955C\u50CF\u6E90\uFF08\u89C1\u7B2C 1 \u8282\uFF09
    |\n\n\u5E38\u7528\u547D\u4EE4\u901F\u67E5\n\nbash\n\n\u5355\u4E2A\u5927\u6587\u4EF6\uFF0C\u5206
    16 \u6BB5\u300116 \u8FDE\u63A5\u5E76\u53D1\u4E0B\naria2c -x16 -s16 -j16 \"\u4E0B\u8F7D\u5730\u5740\"\n\n\n\u591A\u4E2A\u6587\u4EF6\uFF0C\u540C\u65F6\u5E76\u53D1\u4E0B
    8 \u4E2A\naria2c -j8 a.iso b.iso c.iso\n\n\n\u4ECE\u5217\u8868\u6587\u4EF6\u6279\u91CF\u4E0B\u8F7D\nwge\ft
    -i url\u5217\u8868.txt\n\n\n\u843D\u5730\u8981\u70B9\n1. \u5355\u5927\u6587\u4EF6\u63D0\u901F
    \u2192 \u7528 aria2/IDM\uFF0C\u4E0D\u9760\u6C99\u7BB1\u3002\n2. \u4E00\u5806\u6587\u4EF6\u63D0\u901F
    \u2192 \u7528\u5E76\u53D1\u8FDE\u63A5 / \u5305\u7BA1\u7406\u5668\u5E76\u53D1\u3002\n3.
    DSH \u91CC\u8DD1\u591A\u4E2A\u72EC\u7ACB\u4EFB\u52A1 \u2192 \u6BCF\u4E2A\u4EFB\u52A1\u4E00\u4E2A\u6C99\u7BB1/\u540E\u53F0
    job\uFF0C\u5404\u7BA1\u5404\u7684\u4E0D\u540C\u6587\u4EF6\u3002\n4. \u5E26\u5BBD\u5171\u4EAB\u662F\u786C\u8FB9\u754C\uFF1A\u6240\u6709\u6C99\u7BB1\u5171\u4E00\u6839\u7F51\u7EBF\u3001\u540C\u4E00\u4E2A\u4E0B\u8F7D\u6E90\u65F6\uFF0C\u5E76\u884C\u4E5F\u4E0D\u7FFB\u500D\u3002\n\n---\n\n#\n5.
    \u7528 MCP / \u547D\u4EE4\u884C\u64CD\u63A7 Unity \u9879\u76EE\n\n##\n5.1 \u6838\u5FC3\u7ED3\u8BBA\n\n>
    MCP \u4E0D\u4F1A\u8BA9\u4F60\"\u7528\u9F20\u6807\u64CD\u63A7\u4E00\u5207\"\uFF0C\u4F46\u4E5F\u4E0D\u9700\u8981\u9F20\u6807\u2014\u2014Unity
    \u7684\u9884\u5236\u4F53\u3001\u573A\u666F\u3001\u6253\u5305\u3001\u88C5\u5305\u90FD\u6709
    API/\u547D\u4EE4\u884C\u63A5\u53E3\uFF0C\u53EF\u5C01\u88C5\u6210 MCP \u5DE5\u5177\u8BA9
    AI \u81EA\u52A8\u8C03\u7528\u3002\u800C\u4E14\u6743\u9650\u6C99\u7BB1\u4F9D\u7136\u751F\u6548\uFF0CMCP
    \u4E0D\u4F1A\u53D8\u6210\"\u7ED5\u8FC7\u4F60\u63A7\u5236\u7684\u6F0F\u6D1E\"\u3002\n\n##\n5.2
    \u4E09\u4E2A\u5C42\u9762\u7684\u80FD\u529B\uFF08\u522B\u6DF7\u4E3A\u4E00\u8C08\uFF09\n\n|
    \u5C42\u9762 | \u673A\u5236 | \u80FD\u505A\u4EC0\u4E48 | \u4EE3\u8868 |\n|------|------|----------|------|\n|
    \u2460 \u6539\u4EE3\u7801/\u6587\u4EF6 | \u5DE5\u4F5C\u533A + \f\u6C99\u7BB1\u6743\u9650
    | \u8BFB\u5199\u9879\u76EE\u6587\u4EF6 | opencode\u3001DSH |\n| \u2461 \u8C03\u7528\u5DE5\u5177/API
    | MCP | \u7ED3\u6784\u5316\u8C03\u7528\u547D\u4EE4/API/\u6570\u636E | MCP server
    |\n| \u2462 \u64CD\u63A7\u9F20\u6807/GUI | \u8BA1\u7B97\u673A\u4F7F\u7528\uFF08computer
    use\uFF09 | \u79FB\u52A8\u9F20\u6807\u3001\u70B9\u51FB\u3001\u770B\u5C4F\u5E55
    | Anthropic Computer Use\u3001pyautogui |\n\n##\n5.3 Unity \u81EA\u52A8\u5316\u5BF9\u7167\u8868\uFF08API/\u547D\u4EE4\u884C\uFF0C\u975E\u9F20\u6807\uFF09\n\n|
    \u9700\u6C42 | Unity \u81EA\u52A8\u5316\u65B9\u5F0F |\n|------|------------------|\n|
    \u521B\u5EFA\u9884\u5236\u4F53 | `PrefabUtility.SaveAsPrefabAsset()` |\n| \u4F7F\u7528\u5DE5\u5177/\u83DC\u5355
    | `EditorApplication.ExecuteMenuItem()` |\n| \u4E0B\u8F7D\u5916\u90E8\u7EC4\u4EF6
    | `UnityEditor.PackageManager.Client.Add(\"\u5305\u540D\")` |\n|\f \u6DFB\u52A0\u573A\u666F
    | `EditorSceneManager.NewScene()` |\n| \u6253\u5305\u6E38\u620F | `BuildPipeline.BuildPlayer()`
    / \u547D\u4EE4\u884C `Unity -batchmode -quit -executeMethod \u6253\u5305\u65B9\u6CD5`
    |\n\n##\n5.4 \u547D\u4EE4\u884C\u8D70\u6D41\u7A0B\uFF08\u793A\u4F8B\uFF09\n\n\n\u7B2C1\u6B65
    Unity -batchmode -executeMethod CreatePrefab   \u2192 \u521B\u5EFA\u9884\u5236\u4F53\n\u7B2C2\u6B65
    Unity -batchmode -executeMethod AddScene      \u2192 \u6DFB\u52A0\u573A\u666F\n\u7B2C3\u6B65
    Unity -batchmode -quit -executeMethod BuildPlayer \u2192 \u6253\u5305\u5B8C\u6210\n\u7ED3\u679C\uFF1A\u6E38\u620F
    .exe \u5DF2\u8F93\u51FA\u5230\u76EE\u5F55 \u2705\n\n\n##\n5.5 MCP vs \"\u76F4\u63A5\u6539\u811A\u672C/\u914D\u7F6E\"\uFF1A\u6700\u5927\u533A\u522B\u662F\u4EC0\u4E48\n\n\xB7
    \u5BF9\"\u6539\u811A\u672C\u3001\u6539\u914D\u7F6E\"\u8FD9\u7C7B\uFF1AMCP \u4E0E\u76F4\u63A5\u547D\u4EE4\u884C\u51E0\u4E4E\u6CA1\f\u6709\u533A\u522B\uFF0CMCP
    \u662F\u591A\u4F59\u7684\u3002\n\xB7 \u771F\u6B63\u7684\u533A\u522B\u5728\u4E09\u79CD\u60C5\u51B5\uFF1A\n 
    1. \u6CA1\u6709\u547D\u4EE4\u884C\u63A5\u53E3\u3001\u53EA\u6709 API/\u5DE5\u5177\u7684\u4E1C\u897F
    \u2014\u2014 \u624D\u662F MCP \u7528\u6B66\u4E4B\u5730\uFF08\u5982 Unity \u90E8\u5206\u7F16\u8F91\u5668\u64CD\u4F5C\uFF09\u3002\n 
    2. \u6807\u51C6\u5316\u3001\u53EF\u590D\u7528\u3001\u8DE8\u5DE5\u5177\uFF1A\u540C\u4E00\u7EC4\u5DE5\u5177\u4EFB\u4F55\u652F\u6301
    MCP \u7684 AI \u90FD\u80FD\u76F4\u63A5\u7528\uFF0C\u5199\u4E00\u6B21\u5904\u5904\u53EF\u7528\u3002\n 
    3. \u628A\u5371\u9669/\u9700\u7CBE\u7EC6\u63A7\u5236\u7684\u64CD\u4F5C\u5C01\u88C5\u6210\"\u53D7\u63A7\u5DE5\u5177\"\uFF0C\u66F4\u5B89\u5168\u53EF\u7BA1\u7406\u3002\n\n>
    \u4E00\u53E5\u8BDD\uFF1A\u4F60\u76F4\u63A5\u6539\u811A\u672C = \u4EB2\u624B\u62FF\u5200\uFF1BMCP
    = \u628A\u5200\u5C01\u88C5\u8FDB\"\u53D7\u63A7\u5DE5\u5177\u7BB1\"\uFF0C\u8BA9\u4EFB\u4F55
    AI \u6309\u7EDF\u4E00\u89C4\u5219\u4F7F\u7528\u3002\u5BF9\u5DF2\u80FD\u7528\u547D\u4EE4\u884C\u7684\uFF1A\u6CA1\u533A\u522B\uFF1B\u5BF9\u53EA\u9760\u547D\u4EE4\u884C\u505A\u4E0D\u4E86/\u4E0D\u8BE5\u88F8\u8DD1\u7684\uFF1AMCP
    \u63D0\u4F9B\"\u6807\u51C6\u3001\u53EF\u590D\u7528\u3001\u53D7\u63A7\"\u63A5\u5165\u3002\n\n---\n\n#\n6.
    \u5E38\u7528\u901F\u67E5\u6E05\u5355\n\n\xB7 \u955C\u50CF\u914D\u7F6E\u901F\u67E5\n 
    \xB7 npm\uFF1A`npm config set registry https://registry.npmmirror.com`\n  \xB7
    pip\uFF1A`pip install x -i https://pypi.tuna.\ftsinghua.edu.cn/simple`\n\xB7
    \u6C99\u7BB1\u4F7F\u7528\u901F\u67E5\uFF08DSH\uFF09\n  \xB7 \u62D2\u7EDD\u6807\u8BB0
    \u2192 \u5BF9\u5177\u4F53\u547D\u4EE4\u7533\u8BF7\u4E00\u6B21\u5347\u7EA7 + \u7406\u7531
    \u2192 \u6279\u51C6\u540E\u91CD\u8BD5\n  \xB7 \u53EA\u8BFB/\u5DE5\u4F5C\u533A\u5199/\u5B8C\u5168\u8BBF\u95EE
    \u4E09\u6863\u6743\u9650\n\xB7 MCP \u8C03\u7528\u56DB\u6B65\uFF1A\u5217\u5DE5\u5177
    \u2192 \u770B schema \u2192 \u586B\u53C2\u6570 \u2192 \u5F97\u7ED3\u679C\n\xB7
    Unity \u81EA\u52A8\u5316\u4E09\u8FDE\uFF1A`-batchmode`\u3001`-executeMethod`\u3001`BuildPipeline.BuildPlayer`\n\n---\n\n*\u6587\u6863\u751F\u6210\u81EA\u4E0E
    AI \u7684\u5BF9\u8BDD\u95EE\u7B54\uFF0C\u4F9B\u65E5\u5E38\u5B66\u4E60\u4E0E\u67E5\u9605\u3002*\n"
  slotCode: B2-1-05
