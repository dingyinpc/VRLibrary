--- !u!114 &922204939
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 922204937}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: daf404ac10c46324790e3afd8418ce81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: "\u5B9E\u73B0\u65B9\u6848 \xB7 01-\u7528\u5230\u7684\u7EC4\u4EF6\u4EE5\u53CA\u4F5C\u7528"
  author: "VRlibrary \u9879\u76EE\u7EC4"
  summary: "\n01 \u7528\u5230\u7684\u7EC4\u4EF6\u4EE5\u53CA\u4F5C\u7528\n\n> \u5168\u90E8\u7EC4\u4EF6\u57FA\u4E8E
    XR Interaction Toolkit 2.6.5(XRI)+ PICO Unity Integration SDK 3.3.0,Unity 2022.3.42
    + URP 14\u3002\n\n#\n\u4E00\u3001\u73A9\u5BB6\u7AEF(\u6765\u81EA XRI Starter
    Assets \u7684 `XR Interaction Setup` \u9884\u5236\u4F53)\n\n| \u7EC4\u4EF6 /
    \u7269\u4F53 | \u4F4D\u7F6E | \u4F5C\u7528 |\n| --\xB7 | --\xB7 | --\xB7 |\n|
    XR Origin (XR Rig) | Setup \u6839\u4E0B | \u73A9\u5BB6\u672C\u4F53\u7684\"\u79FB\u52A8\u8F7D\u4F53\"\u3002\u5934\u663E\u76F8\u673A
    + \u53CC\u624B\u624B\u67C4\u90FD\u6302\u5728\u5B83\u4E0B\u9762,\u79FB\u52A8/\u65CB\u8F6C\u6574\u4E2A
    Rig \u5373\u79FB\u52A8\u73A9\u5BB6 |\n| Main Camera | XR Origin/Camera Offset
    | \u5934\u663E\u89C6\u91CE\u3002KioskTeleporter \u4F20\u9001\u65F6\u7528\u5B83\u505A\"\u4EBA\u773C\u4F4D\u7F6E\"\u8865\u507F
    |\n| Left/Right Controller | \fCamera Offset \u4E0B | \u5DE6\u53F3\u624B\u67C4\u903B\u8F91\u7269\u4F53,\u5404\u6302
    XR Controller(\u8F93\u5165\u52A8\u4F5C\u7ED1\u5B9A) |\n| XR Ray Interactor |
    \u6BCF\u4E2A\u624B\u67C4\u4E0B | \u5C04\u7EBF\u4EA4\u4E92:\u9009\u4E2D\u8FDC\u5904\u7269\u4F53\u3001\u70B9
    UI\u3001\u4F20\u9001\u3002\u5DF2\u5F00\u542F Allow Hovered Activate(\u6307\u7740\u4E66\u6263\u6273\u673A\u76F4\u63A5\u9605\u8BFB)
    |\n| XR Direct Interactor | \u6BCF\u4E2A\u624B\u67C4\u4E0B | \u8FD1\u8DDD\u76F4\u63A5\u6293\u53D6(SphereCast
    \u611F\u5E94),\u6293\u4E66\u62FF\u4E66\u9760\u5B83 |\n| XR Poke Interactor |
    \u6BCF\u4E2A\u624B\u67C4\u4E0B | \u624B\u6307/\u624B\u67C4\u6233\u52A8(UI \u6309\u94AE\u6309\u538B\u6548\u679C)
    |\n| XR Interaction Manager | Setup \u6839 | \u5168\u5C40\u4EA4\u4E92\u4EF2\u88C1\u5668,\u8C03\u5EA6\u6240\u6709
    Interactor/Interactable \u7684 Hover/Select/Activate,\u573A\u666F\u91CC\u53EA\u4FDD\u7559\u4E00\u4E2A
    |\n| Input Action Manager | Setup \u6839 | \f\u542F\u7528 XRI Default Input Actions
    \u52A8\u4F5C\u914D\u7F6E(\u624B\u67C4\u952E\u4F4D/\u4F20\u9001/\u65CB\u8F6C\u5168\u5728\u91CC\u9762)
    |\n| Event System (XR UI Input Module) | Setup \u6839 | \u8BA9\u5C04\u7EBF\u80FD\"\u70B9\u51FB\"\u4E16\u754C\u7A7A\u95F4
    UI(\u914D\u5408 TrackedDeviceGraphicRaycaster) |\n| Character Controller + Locomotion
    System | XR Origin / Setup | \u79FB\u52A8\u7CFB\u7EDF\u5E95\u5EA7:\u8FDE\u7EED\u79FB\u52A8(\u6447\u6746)\u3001\u91CD\u529B\u3001\u4E0E\u4F20\u9001
    Provider \u534F\u540C |\n| Teleportation Provider | Setup \u5185 | \u4F20\u9001\u6267\u884C\u5668;\u5730\u9762
    TeleportationArea \u4E0E 4 \u4E2A\u53D1\u5149\u951A\u70B9 TeleportationAnchor
    \u90FD\u7531\u5B83\u5B8C\u6210\u843D\u4F4D |\n| ActionBasedControllerManager
    | \u6BCF\u4E2A\u624B\u67C4\u4E0B | Start\fer Assets \u793A\u4F8B\u811A\u672C:\u5C04\u7EBF\u6293\u53D6\u65F6\u81EA\u52A8\u7981\u7528\u4F20\u9001\u3001\u5E73\u6ED1\u79FB\u52A8/\u77AC\u79FB\u5207\u6362\u7B49
    |\n| XR Device Simulator(\u7F16\u8F91\u5668\u4E13\u7528) | \u8FD0\u884C\u65F6\u81EA\u52A8\u751F\u6210
    | \u65E0\u5934\u663E\u65F6\u7528\u952E\u76D8\u9F20\u6807\u6A21\u62DF\u5934\u663E+\u53CC\u624B\u67C4(\u89C1
    07 \u6587\u6863) |\n\n#\n\u4E8C\u3001PICO \u7AEF\n\n| \u7EC4\u4EF6 | \u4F4D\u7F6E
    | \u4F5C\u7528 |\n| --\xB7 | --\xB7 | --\xB7 |\n| PXR_Manager | XR Origin \u4E0A
    | PICO SDK \u603B\u5F00\u5173:\u624B\u90E8\u8DDF\u8E2A\u3001\u900F\u89C6\u3001\u6CE8\u89C6\u70B9\u6E32\u67D3\u7B49\u5168\u5728\u8FD9\u91CC\u52FE\u9009
    |\n| PXR_Loader | XR Plug-in Management(Android) | \u8BA9 Android \u6784\u5EFA\u8D70
    PICO \u8FD0\u884C\u65F6(\u5BF9\u5E94 XR GeneralSettings \u914D\u7F6E\u8D44\u4EA7
    `Assets/XR/`) |\n\n#\n\u4E09\u3001\u573A\u666F\u4EA4\u4E92\u7269\u4F53\u7AEF\n\n|
    \u7EC4\u4EF6 | \u6302\u8F7D | \u4F5C\u7528 |\n| --\xB7 | --\xB7 | --\xB7 |\n|
    XR Grab Interactable | \f\u6BCF\u672C\u4E66 | \u8BA9\u4E66\u53EF\u88AB\u6293\u53D6/\u6254\u51FA\u3002Movement
    Type = Velocity Tracking(\u79FB\u52A8\u4E2D\u53D7\u7269\u7406\u5F71\u54CD),\u81EA\u52A8\u5E26
    Rigidbody |\n| XR Socket Interactor | \u670D\u52A1\u53F0\u5F52\u8FD8\u53E3 |
    \u53D1\u5149\u611F\u5E94\u533A:\u4E66\u9760\u8FD1\u81EA\u52A8\u5438\u9644,\u914D\u5408
    Sphere Collider(Is Trigger) |\n| TeleportationArea | \u5730\u9762 Plane | \u5C04\u7EBF\u4F20\u9001\u7684\"\u53EF\u7AD9\u533A\u57DF\"
    |\n| TeleportationAnchor | 4 \u4E2A\u53D1\u5149\u5706\u76D8 | \u5B9A\u70B9\u4F20\u9001:\u5165\u53E3/\u4E66\u67B6\u533A/\u9605\u8BFB\u533A/\u670D\u52A1\u53F0,\u4F20\u9001\u540E\u671D\u5411
    = \u951A\u70B9\u671D\u5411 |\n| TrackedDeviceGraphicRaycaster | \u6BCF\u4E2A
    UI Canvas | XRI \u7248 GraphicRaycaster,\u8BA9\u5C04\u7EBF/\u6233\u52A8\u80FD\u547D\u4E2D\u4E16\u754C\u7A7A\u95F4
    UI |\n| XRSimpleInteractable / Button | \u5404 UI | \f\u6309\u94AE\u70B9\u51FB(XR
    UI Input Module \u7EDF\u4E00\u5904\u7406) |\n\n#\n\u56DB\u3001\u81EA\u5199\u811A\u672C(`Assets/Scripts/`)\n\n|
    \u811A\u672C | \u6302\u8F7D | \u4F5C\u7528 |\n| --\xB7 | --\xB7 | --\xB7 |\n|
    LibraryBook.cs | \u6BCF\u672C\u4E66 | \u4E66\u7C4D\u6570\u636E(title/author/summary)+
    \u60AC\u505C\u653E\u5927 + \u6293\u53D6\u65F6\u4FE1\u606F\u5C4F\u663E\u793A +
    \u6263\u6273\u673A\u6253\u5F00\u9605\u8BFB\u9762\u677F |\n| BookReader.cs | BookReaderPanel
    | \u9605\u8BFB\u9762\u677F\u63A7\u5236\u5668:\u5206\u9875(\\f \u6216 160 \u5B57/\u9875)\u3001\u7FFB\u9875\u52A8\u753B(\u534F\u7A0B\u6A2A\u5411\u6536\u62E2\u2192\u5C55\u5F00)\u3001\u9762\u677F\u8F7B\u8DDF\u968F\u73A9\u5BB6(\u8DDD\u79BB
    1.55m) |\n| BookReturnSocket.cs | \u5F52\u8FD8\u53E3 | Socket \u5438\u9644\u4E8B\u4EF6
    \u2192 \u5F52\u8FD8\u8BA1\u6570 + \u72B6\u6001\u5C4F\u6587\u5B57\u66F4\u65B0
    |\n| LibraryUIController.cs | \u4E2D\u592E\u5BFC\u89C8\u53F0 | \u4FE1\u606F\u5C4F\u72B6\u6001\u6587\u672C;\u4E09\u4E2A\u6309\u94AE(\u8FDB\u5165\u56FE\u4E66\u9986/\u667A\u80FD\u68C0\u7D22/\u5F52\u8FD8\u670D\u52A1)\u7684\u54CD\u5E94
    |\n|\f KioskTeleporter.cs | \u4E2D\u592E\u5BFC\u89C8\u53F0 | \"\u8FDB\u5165\u56FE\u4E66\u9986\"\u6309\u94AE\u70B9\u51FB
    \u2192 \u4F20\u9001\u73A9\u5BB6\u5230\u4E66\u67B6\u533A\u3002\u7528\u76F8\u673A\u4F4D\u7F6E/\u671D\u5411\u505A\u8865\u507F,\u4FDD\u8BC1\"\u4EBA\"\u843D\u5230\u76EE\u6807\u70B9
    |\n| HoloOrbiter.cs | 5 \u4E2A\u73AF\u7ED5\u5149\u7C92 | \u7ED5\u4E2D\u5FC3\u65CB\u8F6C
    + \u4E0A\u4E0B\u6D6E\u52A8 + \u81EA\u8F6C\u7684\u79D1\u5E7B\u88C5\u9970 |\n\n#\n\u4E94\u3001\u7F16\u8F91\u5668\u811A\u672C(`Assets/Editor/`)\n\n|
    \u811A\u672C | \u4F5C\u7528 |\n| --\xB7 | --\xB7 |\n| VRLibrarySetup.cs | \u4E00\u952E\u751F\u6210\u6574\u4E2A\u573A\u666F(\u83DC\u5355
    VRLibrary/\u4E00\u952E\u642D\u5EFA);EnsurePXRManager \u8865\u6302;SwitchToAndroid
    \u5207\u5E73\u53F0 |\n| BookDataImporter.cs | \u4ECE `Assets/Data/bookdata.json`
    \u6279\u91CF\u586B\u4E66\u540D/\u4F5C\u8005/\u7B80\u4ECB\u5230\u573A\u666F\u4E66\u7C4D
    |\n| SkyboxSunSync.cs | \u8BA9\u5929\u7A7A\u76D2\u6708\u4EAE\u65B9\u5411(_MoonDir)\u59CB\u7EC8\u4E0E\u573A\u666F
    Directional \fLight \u5BF9\u9F50(\u5149\u5F71\u4E00\u81F4) |\n| ReloadProbe.cs
    / TriggerReload.cs | \u8C03\u8BD5\u7528\u63A2\u9488,\u53EF\u5220 |\n\n#\n\u516D\u3001\u5305\u4F9D\u8D56(Packages/manifest.json)\n\n\ncom.unity.inputsystem       
    1.19.0   \u8F93\u5165\u7CFB\u7EDF(XRI \u4F9D\u8D56)\ncom.unity.render-pipelines.universal
    14.0.11  URP \u6E32\u67D3\u7BA1\u7EBF\ncom.unity.xr.interaction.toolkit 2.6.5  
    \u4EA4\u4E92\u6846\u67B6\ncom.unity.xr.hands           1.4.3    \u624B\u90E8\u6570\u636E(\u5907\u7528)\ncom.unity.xr.management     
    4.6.0    XR \u63D2\u4EF6\u7BA1\u7406\ncom.unity.xr.openxr          1.11.0   OpenXR(PICO
    \u8D70 PXR_Loader,\u4E0D\u542F\u7528\f OpenXR Loader)\ncom.coplaydev.unity-mcp     
    (\u5185\u5D4C)    MCP \u6865\u63A5,\u4F9B AI \u52A9\u624B\u63A7\u5236\u7F16\u8F91\u5668(\u53EF\u9009)\nPICO
    Unity Integration SDK 3.3.0      \u5185\u5D4C\u4E8E Assets/sdk\n\n\r\n---\r\n\r\n#\n\u4EBA\u5DE5\u590D\u523B\u6B65\u9AA4(\u7EC4\u4EF6\u5C42,\u7167\u505A\u5373\u53EF)\r\n\r\n1.
    \u88C5\u5305\u987A\u5E8F(Package Manager \u2192 Unity Registry):Input System(\u5F39\u7A97\u5207\u65B0\u8F93\u5165\u7CFB\u7EDF\u9009
    Yes)\u2192 XR Plugin Management \u2192 XR Interaction Toolkit 2.6.5(\u5BFC\u5165
    Samples:Starter Assets\u3001XR Device Simulator)\u2192 XR Hands 1.4.3;\r\n2.
    \u62D6\u73A9\u5BB6\u7AEF:Project \u7A97\u53E3 `Samples \u2192 XR Interaction
    Toolkit \u2192 2.6.5 \f\u2192 Starter Assets \u2192 Prefabs \u2192 XR Interaction
    Setup`,\u62D6\u5165\u573A\u666F,\u65CB\u8F6C Y=180\xB0 \u6446\u6B63;\r\n3. \u7EC4\u4EF6\u6811\u81EA\u68C0(\u5C55\u5F00\u786E\u8BA4,\u7F3A\u54EA\u4E2A\u8865\u54EA\u4E2A):\r\n  
    \xB7 XR Origin \u2192 Camera Offset \u2192 Main Camera / Left Controller / Right
    Controller;\r\n   \xB7 \u6BCF\u4E2A\u624B\u67C4\u4E0B:Ray Interactor(XRRayInteractor)+
    Direct Interactor(XRDirectInteractor)+ Poke Interactor;\r\n   \xB7 \u6839\u4E0B:XR
    Interaction Manager(\u552F\u4E00)+ Input Action Manager + Event System(XR UI
    Input Module);\r\n4. PICO \u7EC4\u4EF6:XR Origin \u4E0A Add Comp\fonent \u2192
    PXR_Manager;\r\n5. \u5192\u70DF\u6D4B\u8BD5:\u5EFA\u4E00\u4E2A Cube,Add Component
    \u2192 XR Grab Interactable \u2192 Play,\u6293\u624B\u80FD\u62FF\u8D77\u5373\u73A9\u5BB6\u7AEF\u7EC4\u4EF6\u9F50\u5168;\r\n6.
    \u7F3A\u4EF6\u75C7\u72B6\u5BF9\u7167:\u70B9\u4E0D\u4E86 UI \u2192 \u67E5 Event
    System \u548C Canvas \u7684 TrackedDeviceGraphicRaycaster;\u6293\u4E0D\u4E86
    \u2192 \u67E5\u7269\u4F53\u6709\u6CA1\u6709 Collider + XR Grab Interactable;\u4F20\u9001\u65E0\u6548
    \u2192 \u67E5 Teleportation Area/Anchor \u548C Locomotion System\u3002\r\n"
  slotCode: A1-1-01
