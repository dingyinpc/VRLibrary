    |\n| Transition | \u6309\u94AE\u6548\u679C\uFF0C\u9009 Color Tint \u5C31\u662F\u9F20\u6807\u653E\u4E0A\u53BB\u53D8\u989C\u8272
    |\n| OnClick() | \u70B9\u51FB\u6309\u94AE\u65F6\u6267\u884C\u7684\u64CD\u4F5C\u5217\u8868
    |\n\n##\nOnClick() \u4E8B\u4EF6\u7684\u8BBE\u7F6E\u6B65\u9AA4\n\n\u8FD9\u662F
    Button \u6700\u6838\u5FC3\u7684\u90E8\u5206\uFF0C\u8BF7\u4E25\u683C\u6309\u7167\u4EE5\u4E0B\u6B65\u9AA4\u64CD\u4F5C\uFF1A\n\n1.
    \u70B9\u51FB OnClick() \u4E0B\u65B9\u7684 `+` \u6309\u94AE\n   > [\u5728\u6B64\u5904\u63D2\u5165\u622A\u56FE\uFF1A\u70B9\u51FB
    + \u53F7\u7684\u4F4D\u7F6E]\n\n2. \u4ECE Hierarchy \u4E2D\u62D6\u5165\u4E00\u4E2A\u6302\u8F7D\u4E86\u811A\u672C\u7684
    GameObject\n   > [\u5728\u6B64\u5904\u63D2\u5165\u622A\u56FE\uFF1A\u62D6\u5165\u5BF9\u8C61\u7684\u64CD\u4F5C]\n\n3.
    \u5728\u53F3\u4FA7\u4E0B\u62C9\u83DC\u5355\u9009\u62E9\u811A\u672C\u540D\u79F0
    \u2192 \u518D\u9009\u62E9\u811A\u672C\u4E2D\u7684 \u516C\u5F00\u65B9\u6CD5\uFF08public
    \u65B9\u6CD5\uFF09\n   > [\u6B64\u5904\u63D2\u5165\u622A\u56FE\uFF1A\u9009\u62E9\u65B9\u6CD5\u7684\u83DC\u5355]\n\n\u8BF7\u8BB0\u4F4F\uFF1A
    \u53EA\u6709 `public` \u7684\u65B9\u6CD5\u624D\u4F1A\u51FA\u73B0\u5728\u8FD9\u4E2A\u83DC\u5355\u4E2D\uFF01\n\n#\n3.3
    \u573A\u666F\u5207\u6362\u811A\u672C\u2014\u2014SceneSwitcher\n\n\u9700\u8981\u521B\u5EFA\u7684\u811A\u672C\u6587\u4EF6\uFF1A
    \f\u4E00\u4E2A\u540D\u4E3A `SceneSwitcher` \u7684 C\n\u811A\u672C\n\n\u9700\u8981\u5199\u7684\u65B9\u6CD5\uFF08\u544A\u8BC9\u540C\u5B66\u65B9\u6CD5\u540D\u548C\u529F\u80FD\u5373\u53EF\uFF09\uFF1A\n\n|
    \u8981\u5199\u7684\u65B9\u6CD5 | \u529F\u80FD |\n|-----------|------|\n| `GoToGame()`
    | \u8C03\u7528 `SceneManager.LoadScene(\"Game\")` \u52A0\u8F7D\u6E38\u620F\u573A\u666F
    |\n| `GoToStart()` | \u8C03\u7528 `SceneManager.LoadScene(\"Start\")` \u52A0\u8F7D\u5F00\u59CB\u573A\u666F
    |\n| `GoToExit()` | \u8C03\u7528 `SceneManager.LoadScene(\"Exit\")` \u52A0\u8F7D\u7ED3\u675F\u573A\u666F
    |\n\n\u9700\u8981\u5F15\u7528\u7684\u547D\u540D\u7A7A\u95F4\uFF1A `UnityEngine.SceneManagement`\n\n\u5176\u4ED6\u77E5\u8BC6\u70B9\uFF1A\n\xB7
    \u811A\u672C\u5FC5\u987B\u5199\u5728 `Start()` \u6216 `Update()` \u5916\u9762\u7684\u5B9A\u4E49\u4E2D\uFF08\u4F5C\u4E3A\u72EC\u7ACB\u65B9\u6CD5\uFF09\n\xB7
    \u65B9\u6CD5\u5FC5\u987B\u662F `public` \u624D\u80FD\u5728 Button \u7684 OnClick
    \u83DC\u5355\u4E2D\u627E\f\u5230\n\xB7 \u573A\u666F\u540D\u5FC5\u987B\u548C `Build
    Settings` \u4E2D\u6DFB\u52A0\u7684\u573A\u666F\u540D\u5B8C\u5168\u4E00\u81F4\uFF08\u533A\u5206\u5927\u5C0F\u5199\uFF09\n\n##\n\u573A\u666F\u5207\u6362\u811A\u672C\u7684\u7528\u6CD5\n\n1.
    \u5C06 SceneSwitcher \u811A\u672C\u6302\u8F7D\u5230\u4E00\u4E2A\u7A7A\u7269\u4F53\u4E0A\uFF08\u6BD4\u5982\u53EB
    \"SceneManager\" \u7684\u7A7A\u7269\u4F53\uFF09\n2. \u5728\u81EA\u5DF1\u573A\u666F\u7684
    Button \u7684 OnClick() \u4E2D\uFF1A\n   \xB7 \u628A \"SceneManager\" \u7269\u4F53\u62D6\u5165\u4E8B\u4EF6\u69FD\n  
    \xB7 \u9009\u62E9 `SceneSwitcher` \u2192 `GoToGame()`\uFF08\u6216\u5BF9\u5E94\u65B9\u6CD5\uFF09\n\n>
    [\u5728\u6B64\u5904\u63D2\u5165\u622A\u56FE\uFF1AOnClick \u914D\u7F6E\u5B8C\u6210\u540E
    Inspector \u7684\u6837\u5B50]\n\n#\n3.4 \u6E38\u620F\u7ED3\u675F Panel \u7684\u5236\u4F5C\n\nPanel
    \u662F UI \u5BB9\u5668\uFF0C\u7528\u6765\u5728\u6E38\u620F\u7ED3\u675F\u65F6\u663E\u793A\"\u91CD\u65B0\u6E38\u73A9\"\u548C\"\u9000\u51FA\"\u6309\u94AE\u3002\n\n##\n\u521B\u5EFA\u6B65\u9AA4\n\n1.
    \u521B\u5EFA Panel\uFF1A Hierarchy \u53F3\u952E \u2192 `UI` \u2192 `Panel`\n  
    \xB7 \u4F1A\u81EA\u52A8\u653E\u5728 Canvas \u4E0B\n   \xB7 > [\u5728\u6B64\u5904\u63D2\u5165\u622A\u56FE\uFF1A\u521B\u5EFA
    Pa\fnel]\n\n2. \u8BBE\u7F6E Panel \u521D\u59CB\u9690\u85CF\uFF1A\n   \xB7 \u9009\u4E2D
    Panel \u2192 Inspector \u6700\u9876\u90E8\u6709\u4E00\u4E2A\u590D\u9009\u6846\n  
    \xB7 \u53D6\u6D88\u52FE\u9009 \u2192 Panel \u5728\u6E38\u620F\u5F00\u59CB\u65F6\u4E0D\u53EF\u89C1\n  
    \xB7 > [\u5728\u6B64\u5904\u63D2\u5165\u622A\u56FE\uFF1A\u53D6\u6D88\u52FE\u9009
    Panel]\n\n3. \u5728 Panel \u4E0B\u521B\u5EFA\u4E24\u4E2A Button\uFF1A\n   \xB7
    \u53F3\u952E Panel \u2192 `UI` \u2192 `Button` \u2192 \u521B\u5EFA\"\u91CD\u65B0\u6E38\u73A9\"\n  
    \xB7 \u53F3\u952E Panel \u2192 `UI` \u2192 `Button` \u2192 \u521B\u5EFA\"\u9000\u51FA\"\n\n4.
    \u8BBE\u7F6E Button \u7684\u6587\u5B57\uFF1A\n   \xB7 \u6BCF\u4E2A Button \u4E0B\u6709\u4E00\u4E2A\u5B50\u7269\u4F53
    Text\uFF08\u6216 TextMeshPro\uFF09\n   \xB7 \u9009\u4E2D\u5B83 \u2192 \u5728
    Text \u7EC4\u4EF6\u4E2D\u4FEE\u6539\u6587\u5B57\u5185\u5BB9\n\n5. \u8BBE\u7F6E
    Button \u7684\u70B9\u51FB\u4E8B\u4EF6\uFF1A\n   \xB7 \u9009\u4E2D\"\u91CD\u65B0\u6E38\u73A9\"\u6309\u94AE
    \u2192 OnClick() \u2192 \u62D6\u5165 SceneManager \u7269\u4F53 \u2192 \u9009
    `SceneSwitcher.GoToGame()`\f\n   \xB7 \u9009\u4E2D\"\u9000\u51FA\"\u6309\u94AE
    \u2192 OnClick() \u2192 \u62D6\u5165 SceneManager \u7269\u4F53 \u2192 \u9009
    `SceneSwitcher.GoToExit()`\n\n##\n\u5982\u4F55\u8BA9 Panel \u663E\u793A\u51FA\u6765\n\n\u5728\u6E38\u620F\u903B\u8F91\u811A\u672C\u4E2D\uFF08\u540E\u9762\u4F1A\u5199\uFF09\uFF1A\n\xB7
    \u9700\u8981\u5148\u83B7\u53D6\u5230 Panel \u5BF9\u8C61\u7684\u5F15\u7528\uFF08\u58F0\u660E\u4E00\u4E2A
    `public GameObject panel` \u53D8\u91CF\uFF09\n\xB7 \u7136\u540E\u5728 Inspector
    \u4E2D\u628A Panel \u62D6\u5165\n\xB7 \u6761\u4EF6\u6EE1\u8DB3\u65F6\u8C03\u7528
    `panel.SetActive(true)` \u663E\u793A\n\xB7 \u8C03\u7528 `panel.SetActive(false)`
    \u9690\u85CF\n\n---\n\n\n\u7B2C\u56DB\u90E8\u5206\uFF1A\u8DEF\u7EBF\u9009\u62E9\u4E0E\u524D\u7F6E\u51C6\u5907\n\n\u5728\u5F00\u59CB\u5199\u6E38\u620F\u903B\u8F91\u4E4B\u524D\uFF0C\u4F60\u9700\u8981\u5148\u4E86\u89E3\u4E24\u6761\u4E0D\u540C\u7684\u5B9E\u73B0\u8DEF\u7EBF\uFF0C\u5E76\u505A\u597D\u5171\u4EAB\u7684\u524D\u7F6E\u51C6\u5907\u5DE5\u4F5C\u3002\n\n#\n4.1
    \u4E24\u6761\u8DEF\u7EBF\u5BF9\u6BD4\n\n\u65B9\u5757\u78B0\u649E\u68C0\u6D4B\uFF08\u5224\u65AD\u65B9\u5757\u662F\u5426\u78B0\u5230\u5730\u9762/\u5899\u58C1/\u5DF2\u6709\u65B9\u5757\uFF09\u6709\u4E24\u79CD\u5B9E\u73B0\u65B9\u5F0F\uFF1A\n\n|
    \u5BF9\u6BD4\u9879 | \u8DEF\u7EBFA\uFF1A\u78B0\u649E\u4F53+\u6807\u7B7E\u6CD5
    | \u8DEF\u7EBFB\uFF1A\u4EE3\u7801\u4F4D\u7F6E\u68C0\u67E5 |\n|-----\f---|---------------------|-------------------|\n|
    \u68C0\u6D4B\u65B9\u5F0F | \u7269\u7406\u5F15\u64CE\u81EA\u52A8\u68C0\u6D4B\u78B0\u649E\uFF0C\u901A\u8FC7
    Tag \u6807\u7B7E\u8BC6\u522B\u78B0\u649E\u5BF9\u8C61\u7C7B\u578B | \u5728\u4EE3\u7801\u4E2D\u4E3B\u52A8\u8BA1\u7B97\u5750\u6807\uFF0C\u5224\u65AD\u6BCF\u4E2A\u5B50\u7269\u4F53\u7684\u4F4D\u7F6E\u662F\u5426\u5408\u6CD5
    |\n| \u9700\u8981 Tag \u6807\u7B7E | \u9700\u8981\u2014\u2014\u7ED9\u5730\u9762/\u5899\u58C1\u8BBE\u7F6E\u6807\u7B7E
    | \u4E0D\u9700\u8981 |\n| \u5B50\u7269\u4F53 BoxCollider2D | \u5FC5\u987B\u6DFB\u52A0\u2014\u2014\u78B0\u649E\u68C0\u6D4B\u4F9D\u8D56\u5B83
    | \u53EF\u9009\u2014\u2014\u68C0\u6D4B\u4E0D\u4F9D\u8D56\u7269\u7406\u78B0\u649E
    |\n| \u79FB\u52A8\u65B9\u5F0F | \u79FB\u52A8\u65B9\u5F0F\u4F1A\u5F71\u54CD\u78B0\u649E\u662F\u5426\u89E6\u53D1\uFF08\u6CE8\u610F\u70B9\uFF09
    | \u65E0\u9650\u5236 |\n| \u4F18\u70B9 | \u7269\u7406\u5F15\u64CE\u81EA\u52A8\u5904\u7406\u63A5\u89E6\u68C0\u6D4B\uFF0C\u78B0\u649E\u903B\u8F91\u96C6\u4E2D
    | \u5B8C\u5168\u53EF\u63A7\uFF0C\u4E0D\u4F9D\u8D56\u7269\u7406\u7CFB\u7EDF\uFF0C\u884C\u4E3A\u53EF\u9884\u6D4B
    |\n| \u7F3A\u70B9 | \u79FB\u52A8\u548C\u78B0\u649E\u76F8\u4E92\u5173\u8054\uFF0C\u9009\u9519\u79FB\u52A8\u65B9\u5F0F\u78B0\u649E\u4F1A\u5931\u6548
    | \u9700\u8981\u81EA\u5DF1\u5B9E\u73B0\u5B8C\u6574\u7684\u68C0\u6D4B\u903B\u8F91\uFF0C\u4EE3\u7801\u91CF\u8F83\u591A
    |\n\n#\n4.2 \u5982\u4F55\u9009\u62E9\n\n\u9009\u8DEF\u7EBFA\uFF08\u78B0\u649E\u4F53+\u6807\u7B7E\u6CD5\uFF09\uFF0C\u5982\u679C\u4F60\u5E0C\u671B\uFF1A\n\xB7
    \u5229\u7528 Unity \u7269\u7406\u5F15\u64CE\u81EA\u52A8\u68C0\u6D4B\u78B0\u649E\n\xB7
    \u7528 Tag \u533A\u5206\u5730\u9762\f\u3001\u5899\u58C1\u548C\u5DF2\u6709\u65B9\u5757\n\xB7
    \u63A5\u53D7\"\u79FB\u52A8\u65B9\u5F0F\u4F1A\u5F71\u54CD\u78B0\u649E\u89E6\u53D1\"\u8FD9\u4E2A\u7EA6\u675F\n\n\u9009\u8DEF\u7EBFB\uFF08\u4EE3\u7801\u4F4D\u7F6E\u68C0\u67E5\uFF09\uFF0C\u5982\u679C\u4F60\u5E0C\u671B\uFF1A\n\xB7
    \u5B8C\u5168\u7528\u4EE3\u7801\u63A7\u5236\u4E00\u5207\uFF0C\u4E0D\u4F9D\u8D56\u7269\u7406\u7CFB\u7EDF\n\xB7
    \u79FB\u52A8\u65B9\u5F0F\u4E0D\u53D7\u4EFB\u4F55\u9650\u5236\n\xB7 \u81EA\u5DF1\u5B9E\u73B0\u4F4D\u7F6E\u5408\u6CD5\u6027\u7684\u5224\u65AD\u903B\u8F91\n\n>
    \u9009\u597D\u540E\uFF0C\u76F4\u63A5\u8DF3\u5230\u5BF9\u5E94\u7684\u7AE0\u8282\u9605\u8BFB\uFF1A\n>
    \xB7 \u8D70\u8DEF\u7EBFA \u2192 \u8DF3\u5230 \u7B2C\u4E94\u90E8\u5206\n> \xB7
    \u8D70\u8DEF\u7EBFB \u2192 \u8DF3\u5230 \u7B2C\u516D\u90E8\u5206\n>\n> \u4E0B\u9762\u7684
    4.3~4.5 \u8282\u662F\u4E24\u6761\u8DEF\u7EBF\u5171\u7528\u7684\u524D\u7F6E\u51C6\u5907\uFF0C\u5FC5\u987B\u5148\u770B\u5B8C\u3002\n\n---\n\n#\n4.3
    \u9884\u5236\u4F53\u7C7B\uFF08PrefabClass\uFF09\u2014\u2014\u4E24\u6761\u8DEF\u7EBF\u5171\u7528\n\n\u8FD9\u4E2A\u7C7B\u4E0D\u662F\u5B8C\u6574\u7684\u6E38\u620F\u903B\u8F91\u811A\u672C\uFF0C\u800C\u662F\u6570\u636E\u5BB9\u5668\u3002\u4F60\u53EF\u4EE5\u628A\u5B83\u60F3\u8C61\u6210\"\u67097\u4E2A\u683C\u5B50\u7684\u6536\u7EB3\u76D2\"\uFF0C\u6BCF\u683C\u653E\u4E00\u79CD\u65B9\u5757\u9884\u5236\u4F53\u3002\n\n\u521B\u5EFA\u811A\u672C\uFF1A
    Project \u7A97\u53E3\u53F3\u952E \u2192 `Create` \u2192 `C\nScript` \u2192 \u547D\u540D\u4E3A
    `PrefabClass`\n\n\u811A\u672C\u5185\u5BB9\uFF1A\n\xB7 \u5B9A\u4E49\u4E00\u4E2A
    `public` \u7684 `GameObject[]` \u6570\u7EC4\uFF08\u6E38\u620F\u5BF9\u8C61\u6570\u7EC4\uFF09\n\xB7
    \u6570\u7EC4\u957F\u5EA6\u8BBE\u4E3A `7`\n\xB7 \u8FD9\u4E2A\u811A\u672C\u4E0D\u9700\u8981\f\u5199
    `Start()` \u6216 `Update()` \u65B9\u6CD5\n\n\u7528\u6CD5\uFF1A\n1. \u5728 Hierarchy
    \u521B\u5EFA\u4E00\u4E2A\u7A7A\u7269\u4F53\uFF0C\u547D\u540D\u4E3A \"PrefabHolder\"\n2.
    \u628A `PrefabClass` \u811A\u672C\u62D6\u5230\u8FD9\u4E2A\u7A7A\u7269\u4F53\u4E0A\n3.
    \u5728 Inspector \u4E2D\u4F1A\u51FA\u73B0\u4E00\u4E2A\u6570\u7EC4\u53D8\u91CF\uFF0C\u5C55\u5F00\u5B83\n4.
    \u628A Project \u7A97\u53E3\u4E2D\u7684 7 \u4E2A\u9884\u5236\u4F53\u62D6\u5165\u6570\u7EC4\u7684
    7 \u4E2A\u683C\u5B50\n\n> [\u5728\u6B64\u5904\u63D2\u5165\u622A\u56FE\uFF1AInspector
    \u4E2D\u6570\u7EC4\u5C55\u5F00\u7684\u6837\u5B50\uFF0C7 \u4E2A\u69FD\u4F4D\u90FD\u5DF2\u62D6\u5165\u9884\u5236\u4F53]\n\n\u540D\u8BCD\u89E3\u91CA\uFF1A\n\xB7
    \u6570\u7EC4\uFF08Array\uFF09\uFF1A\u53EF\u4EE5\u5B58\u591A\u4E2A\u76F8\u540C\u7C7B\u578B\u6570\u636E\u7684\u5BB9\u5668\uFF0C\u7528\u7F16\u53F7
    0~N-1 \u8BBF\u95EE\n\xB7 GameObject\uFF1AUnity \u4E2D\u6240\u6709\u7269\u4F53\u7684\u57FA\u7C7B\uFF0C\u7528\u8FD9\u4E2A\u7C7B\u578B\u53EF\u4EE5\u5B58\u4EFB\u4F55\u7269\u4F53\n\n#\n4.4
    \u6750\u8D28\u7C7B\uFF08MaterialClass\uFF09\u2014\u2014\u4E24\u6761\u8DEF\u7EBF\u5171\u7528\n\n>
    \u26A0\uFE0F \u91CD\u8981\u8BF4\u660E\uFF1A \u4E0D\u80FD\u76F4\u63A5\u7528 Sprite
    \u8C03\u7528 `SetTile`\u3002\u5FC5\u987B\u628A Sprite \u5148\u505A\u6210 Tile\uFF08\u74E6\u7247\u8D44\u6E90\uFF09\uFF0C\u518D\u7528
    `SetTile` \u7ED8\u5236\f\u5230 Tilemap \u4E0A\u3002\u6240\u4EE5 MaterialClass
    \u5B58\u50A8\u7684\u662F Tile \u6570\u7EC4\uFF0C\u800C\u4E0D\u662F Sprite \u6570\u7EC4\u3002\n\n\u521B\u5EFA\u811A\u672C\uFF1A
    \u547D\u540D\u4E3A `MaterialClass`\n\n\u811A\u672C\u5185\u5BB9\uFF1A\n\xB7 \u5B9A\u4E49\u4E00\u4E2A
    `public` \u7684 `Tile[]` \u6570\u7EC4\uFF08\u6CE8\u610F\u662F Tile \u4E0D\u662F
    Sprite\uFF09\n\xB7 \u6570\u7EC4\u957F\u5EA6\u8BBE\u4E3A `4`\n\n\u7528\u6CD5\uFF1A\n1.
    \u521B\u5EFA\u7A7A\u7269\u4F53 \"MaterialHolder\"\n2. \u6302\u8F7D `MaterialClass`
    \u811A\u672C\n3. \u628A\u63D0\u524D\u505A\u597D\u7684 4 \u4E2A Tile \u8D44\u6E90\u4ECE
    Project \u62D6\u5165\u6570\u7EC4\u7684 4 \u4E2A\u683C\u5B50\n\n> [\u5728\u6B64\u5904\u63D2\u5165\u622A\u56FE\uFF1AMaterialClass
    \u7684 Inspector\uFF0C4 \u4E2A Tile \u69FD\u4F4D]\n\n#\n4.5 \u5982\u4F55\u628A\u8D34\u56FE\u505A\u6210
