    \u2502                   \u2502\n\u2502                   \u2502                 
    \u2502   SpriteRenderer  \u2502\n\u2502                   \u2502                 
    \u2502   ...             \u2502\n\u251C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\n\u2502                                                         
    \u2502\n\u2502   Project (\u9879\u76EE\u6587\u4EF6\u7A97\u53E3)          Game
    (\u6E38\u620F\u9884\u89C8\u7A97\u53E3)    \u2502\n\u2502                        
    \f                                 \u2502\n\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\n\n\n>
    [\u5728\u6B64\u5904\u63D2\u5165 Unity 2022.3 \u754C\u9762\u622A\u56FE\uFF0C\u6807\u6CE8\u56DB\u4E2A\u4E3B\u8981\u7A97\u53E3\u7684\u4F4D\u7F6E]\n\n|
    \u7A97\u53E3\u540D\u79F0 | \u4F5C\u7528 |\n|---------|------|\n| Hierarchy\uFF08\u5C42\u7EA7\u9762\u677F\uFF09
    | \u5F53\u524D\u573A\u666F\u4E2D\u6240\u6709\u7269\u4F53\u7684\u5217\u8868\uFF0C\u9009\u4E2D\u4E00\u4E2A\u7269\u4F53\uFF0CInspector
