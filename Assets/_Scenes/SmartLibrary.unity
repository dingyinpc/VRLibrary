--- !u!114 &1872315070
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1872315068}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: daf404ac10c46324790e3afd8418ce81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: "\u5B9E\u73B0\u65B9\u6848 \xB7 03-\u706F\u5149\u7684\u4F7F\u7528"
  author: "VRlibrary \u9879\u76EE\u7EC4"
  summary: "\n03 \u706F\u5149\u7684\u4F7F\u7528\n\n> \u573A\u666F\u706F\u5149\u5206
    5 \u5C42:\u73AF\u5883\u57FA\u8C03 \u2192 \u4E3B\u5149 \u2192 \u529F\u80FD\u5C04\u706F
    \u2192 \u6C1B\u56F4\u70B9\u5149 \u2192 \u81EA\u53D1\u5149\u4F53(\u89C1 08 \u6587\u6863)\u3002\n>
    \u5F53\u524D\u5B9E\u65F6\u706F\u603B\u6570\u7EA6 13 \u76CF,PICO \u771F\u673A\u53EF\u8DD1(U
    Additional Lights = Per Pixel \u4E0A\u9650\u5185)\u3002\n\n#\n\u4E00\u3001\u706F\u5149\u6E05\u5355(\u573A\u666F\u5B9E\u9645\u503C)\n\n|
    \u706F\u5149 | \u7C7B\u578B | \u4F4D\u7F6E/\u671D\u5411 | \u989C\u8272 | \u5F3A\u5EA6
    | \u804C\u8D23 |\n| --\xB7 | --\xB7 | --\xB7 | --\xB7 | --\xB7 | --\xB7 |\n|
    Directional Light | \u5E73\u884C\u5149 | Euler(55, -35, 0) | \u51B7\u767D (0.72,
    0.82, 1) | 0.55 | \u5168\u573A\u4E3B\u5149+\u9634\u5F71,\u65B9\u5411\u4E0E\u5929\u7A7A\u76D2\u6708\u4EAE\u4E00\u81F4(SkyboxSunSync)
    |\n| ShelfSpot_0~3 \xD74 | \u805A\u5149\u706F | \u4E66\u67B6\u524D\u4E0A\u65B9
    (-14.5, 5.2, z),Euler(52, 90, 0) | \u9752 (0.45, 0.9,\f 1) | 1.1,\u89D2 58\xB0
    | \u7167\u4EAE\u4E66\u67B6\u5C42\u677F\u4E0E\u4E66\u810A |\n| KioskLight | \u70B9\u5149
    | \u5BFC\u89C8\u53F0\u4E0A\u65B9 (0, 3.2, 0) | \u54C1\u7EA2 (1, 0.45, 0.9) |
    1.2,\u8303\u56F4 14 | \u4E2D\u592E\u533A\u54C1\u7EA2\u6C1B\u56F4 |\n| DeskLight
    | \u70B9\u5149 | \u670D\u52A1\u53F0\u4E0A\u65B9 (0, 2.6, -15) | \u9752 | 1.4,\u8303\u56F4
    9 | \u5F52\u8FD8\u53E3\u4F5C\u4E1A\u7167\u660E |\n| TablePoint \xD73 | \u70B9\u5149
    | \u6BCF\u5F20\u9605\u8BFB\u684C\u4E0A\u65B9 (y 3.5) | \u9752 | 1.6,\u8303\u56F4
    4.5 | \u9605\u8BFB\u684C\u9762\u5149 |\n| ShelfLight \xD74(\u5DF2\u5220) | \u70B9\u5149
    | \u2014 | \u2014 | \u2014 | \u88AB ShelfSpot \u53D6\u4EE3\u540E\u5220\u9664(\u7701
    4 \u76CF\u5B9E\u65F6\u706F) |\n\n#\n\u4E8C\u3001\u5E03\u5149\u601D\u8DEF(\u5206\u5C42)\n\n1.
    \u4F4E\u5F3A\u5EA6\u4E3B\u5149\u6253\u5E95:Directional 0.55 \u53EA\u7ED9\u8F6E\u5ED3\u548C\u9634\u5F71,\u591C\u666F\u9760\u73AF\u5883\u8272;\n2.
    \u73AF\u5883\u5149\u6241\u5E73\u5316:`Lighting \u2192 Environment \u2192 Am\fbient
    \u2192 Flat`,\u989C\u8272 (0.10, 0.12, 0.16)\u2014\u2014\u6CA1\u6709 Bake \u4E5F\u5747\u5300;\n3.
    \u529F\u80FD\u533A\u5206\u533A\u7167\u660E:\u6BCF\u4E2A\u529F\u80FD\u533A\u72EC\u7ACB\u5149\u6E90(\u4E66\u67B6\u5C04\u706F/\u684C\u706F/\u670D\u52A1\u53F0\u706F),\u8272\u6E29\u7EDF\u4E00\u9752\u8272\u7CFB,\u54C1\u7EA2\u53EA\u7ED9\u4E2D\u592E\u53F0\u505A\u91CD\u70B9\u8272;\n4.
    \u53D1\u5149\u4F53\u8865\u5149:\u5927\u91CF\"\u706F\"\u5176\u5B9E\u662F\u81EA\u53D1\u5149\u6750\u8D28(\u706F\u5E26/\u706F\u7BB1/\u540A\u9876\u5149\u683C,\u89C1
    08 \u6587\u6863),\u4E0D\u5360\u5B9E\u65F6\u706F\u540D\u989D\u2014\u2014\u8FD9\u662F\u706F\u591A\u800C\u4E0D\u5361\u7684\u5173\u952E;\n5.
    \u96FE\u6548\u515C\u5E95:`RenderSettings.fog = Exponential, 0.014`,\u6DF1\u84DD\u96FE\u8272
    (0.015, 0.025, 0.045),\u628A\u8FDC\u5904\u538B\u8FDB\u9ED1\u6697,\u9690\u85CF\"\u706F\u7167\u4E0D\u5230\u7684\u6B7B\u533A\"\u3002\n\n#\n\u4E09\u3001\u8E29\u8FC7\u7684\u5751(\u771F\u5B9E\u6559\u8BAD)\n\n1.
    \u4E66\u67B6\u8FC7\u66DD\u53D1\u767D:\u6700\u521D ShelfSpot \u5F3A\u5EA6 2.2
    + \u4E66\u67B6\u6750\u8D28\u91D1\u5C5E\u5EA6 0.6 \u2192 \u53CD\u5C04\u540A\u9876\u767D\u5149\u683C,\u6574\u67B6\u60E8\u767D\u3002\n  
    \u4FEE\u590D:\u2460\u5C04\u706F\u964D\u5230 1.1\u3001\u5149\u9525\u89D2\u6269\u5230
    58\xB0(\u67D4\u5316);\u2461\u4E66\u67B6\u6750\u8D28\u91D1\u5C5E\u5EA6 0.6\u21920.15\u3001\u5149\u6CFD
    0.4\u21920.2\u3002\n   \u7ED3\u8BBA\f:\u6DF1\u8272\u573A\u666F\u91CC,\u6750\u8D28\u91D1\u5C5E\u5EA6\u6BD4\u706F\u5149\u5F3A\u5EA6\u66F4\u5BB9\u6613\u9020\u6210\u8FC7\u66DD\u3002\n2.
    \u706F\u4E0D\u662F\u8D8A\u591A\u8D8A\u597D:\u6BCF\u76CF\u5B9E\u65F6\u706F\u90FD\u8FDB
    URP \u7684\u9010\u50CF\u7D20\u5149\u6E90\u961F\u5217;\u80FD\u88AB\u81EA\u53D1\u5149+\u6CDB\u5149\u66FF\u4EE3\u7684\u706F\u4E00\u5F8B\u5220\u6389\u3002\n3.
    \u9634\u5F71\u53EA\u5F00\u4E3B\u5149:Directional Soft Shadows;\u70B9\u5149/\u805A\u5149\u706F\u5168\u5173\u9634\u5F71(\u771F\u673A\u7701\u4E00\u534A\u6E32\u67D3\u5F00\u9500)\u3002\n\n#\n\u56DB\u3001\u590D\u523B\u6B65\u9AA4\n\n1.
    Lighting \u7A97\u53E3:Environment \u2192 Skybox Material \u62D6\u5165 M_CyberNightSky;Ambient
    Source = Color(0.10, 0.12, 0.16);Fog \u52FE\u9009 Exponential 0.014;\n2. \u5EFA
    Directional Light:\u65CB\u8F6C (55,-35,0),\u5F3A\u5EA6 0.55,\u51B7\u767D,Soft
    Shadows;\n3. \u6309\"\u706F\u5149\u6E05\u5355\"\u8868\u9010\u76CF\u5EFA Point/Spot,\u6CE8\u610F
    Spot \u9700\u8981\u6446\u597D\u671D\u5411(\u4E66\u67B6\u5C04\u706F\u671D\u4E66\u67B6\u659C\u4E0B);\n4.
    \u5168\u90E8\u706F\u5149\u4FDD\u6301\u9ED8\u8BA4\"\u65E0\u9634\u5F71\"(\u9664\u4E3B\f\u5149);\n5.
    \u8DD1\u4E00\u904D\u573A\u666F,\u54EA\u4E2A\u533A\u57DF\u6697\u5C31\u8865\u81EA\u53D1\u5149\u6761(\u800C\u4E0D\u662F\u52A0\u70B9\u5149)\u3002\n\r\n---\r\n\r\n#\n\u4EBA\u5DE5\u590D\u523B\u6B65\u9AA4(\u706F\u5149,\u7167\u505A\u5373\u53EF)\r\n\r\n1.
    \u4E3B\u5149:Hierarchy \u53F3\u952E \u2192 Light \u2192 Directional Light;\u65CB\u8F6C
    (55, -35, 0);Intensity 0.55;\u989C\u8272 (0.72, 0.82, 1);Shadow Type = Soft Shadows(\u5168\u573A\u666F\u552F\u4E00\u5F00\u9634\u5F71\u7684\u706F);\r\n2.
    \u73AF\u5883\u5149:`Window \u2192 Rendering \u2192 Lighting \u2192 Environment`
    \u2192 Environment Lighting \u2192 Source = Color,\u989C\u8272 (0.10, 0.12, 0.16);\r\n3.
    \u96FE:\u540C\u7A97\u53E3 \u2192 Fog \u52FE\u9009 \u2192 Mode = Exponential,Density
    0.014,\u989C\u8272 (0.015, 0.025, 0.045);\r\n4. \u4E66\u67B6\u5C04\u706F \xD74:\u53F3\f\u952E
    \u2192 Light \u2192 Spot Light,\u4F9D\u6B21\u653E (-14.5, 5.2, -9/-3/3/9),\u65CB\u8F6C
    (52, 90, 0);Angle 58,Range 9,Intensity 1.1,\u989C\u8272 (0.45, 0.9, 1);Shadow
    Type = None;\r\n5. \u70B9\u5149\u4E09\u7EC4:KioskLight(0,3.2,0)\u54C1\u7EA2 1.2/\u8303\u56F414;DeskLight(0,2.6,-15)\u9752
    1.4/\u8303\u56F49;TablePoint\xD73 \u6BCF\u684C\u4E0A\u65B9(13, 3.5, -7/0/7)\u9752
    1.6/\u8303\u56F44.5;Shadow \u5168 None;\r\n6. \u9A8C\u6536:\u591C\u89C6\u6C1B\u56F4\u6210\u7ACB\u3001\u4E66\u67B6\u4EAE\u800C\u4E0D\u8FC7\u66DD;\u82E5\u4E66\u67B6\u60E8\u767D\u2014\u2014\u5148\u964D\u6750\u8D28\u91D1\u5C5E\u5EA6(0.15)\u518D\u964D\u706F,\u522B\u4E00\u5473\u52A0\u706F\u3002\r\n"
