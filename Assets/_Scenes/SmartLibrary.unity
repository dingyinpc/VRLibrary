--- !u!114 &2107705168
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2107705166}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: daf404ac10c46324790e3afd8418ce81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: "\u526A\u6620\u81EA\u52A8\u5316\u63A2\u6D4B\u62A5\u544A"
  author: "\u65E5\u5E38\u95EE\u9898\u5904\u7406\u7ECF\u9A8C"
  summary: "\n\u526A\u6620\uFF08JianYing\uFF09\u5168\u81EA\u52A8\u5B57\u5E55/\u5BFC\u51FA
    \u2014\u2014 \u73AF\u5883\u63A2\u6D4B\u62A5\u544A\n\n> \u63A2\u6D4B\u65F6\u95F4\uFF1A2026-08-30
    \uFF5C \u63A2\u6D4B\u65B9\u5F0F\uFF1APowerShell \u672C\u673A\u626B\u63CF + Windows
    UIA \u5B9E\u65F6\u63A2\u9488\n\n#\n\u4E00\u3001\u63A2\u6D4B\u7ED3\u679C\u6C47\u603B\n\n|
    \u68C0\u67E5\u9879 | \u7ED3\u679C | \u5BF9\u81EA\u52A8\u5316\u7684\u5F71\u54CD
    |\n|---|---|---|\n| \u526A\u6620\u7248\u672C | 11.3.0.14362\uFF08`C:\\Users\\18689\\AppData\\Local\\JianyingPro`\uFF09\uFF0C\u63A2\u6D4B\u65F6\u6B63\u5728\u8FD0\u884C
    | \u7248\u672C\u5F88\u65B0\uFF0C\u8349\u7A3F\u6CE8\u5165\u8DEF\u7EBF\u57FA\u672C\u5C01\u6B7B\uFF086.0
    \u8D77 `draft_content.json` \u52A0\u5BC6\uFF09 |\n| \u7A97\u53E3 UIA \u63A7\u4EF6\u6811
    | \u6839\u7A97\u53E3\"\u526A\u6620\u4E13\u4E1A\u7248\"\u4E0B 0 \u4E2A\u5B50\u5143\u7D20\u30010
    \u4E2A\u5B50\u7A97\u53E3 | \u274C \u65E0\u6CD5\u6309\u63A7\u4EF6\u540D\u627E\u6309\u94AE\uFF0C\u53EA\u80FD\"\u56FE\u50CF\u8BC6\u522B
    + \u5750\u6807\u70B9\u51FB + \u5FEB\u6377\u952E\" |\n| \u8349\u7A3F\u76EE\u5F55
    | `D:\\\u526A\u8F91\\\u526A\u6620\\JianyingPro Drafts`\uFF08`currentCustomDraftPath`\uFF0C\u5F53\f\u524D\u4E3A\u7A7A\uFF09
    | \u76EE\u5F55\u5B58\u5728\u53EF\u7528\u4F5C\u72B6\u6001\u54E8\u5175\uFF1A\u5373\u4F7F\u5185\u5BB9\u52A0\u5BC6\uFF0Cmtime/size
    \u53D8\u5316\u4E5F\u80FD\u5224\u65AD\"\u8BC6\u522B\u5B8C\u6210/\u4FDD\u5B58\u5B8C\u6210\"
    |\n| \u5C4F\u5E55 | \u7269\u7406 1920\xD71080\uFF0C\u7CFB\u7EDF\u7F29\u653E 125%
    | \u81EA\u52A8\u5316\u811A\u672C\u5FC5\u987B\u58F0\u660E DPI-aware\uFF0C\u5750\u6807\u9700\u6309
    1536\xD7864 \u903B\u8F91\u50CF\u7D20\u5904\u7406 |\n| Python \u73AF\u5883 | \u53EA\u6709\u5FAE\u8F6F\u5546\u5E97\u5360\u4F4D
    stub\uFF0C\u4E0D\u53EF\u7528\uFF1B\u65E0 winget | \u9700\u8981\u5148\u5B89\u88C5
    Python 3.10+\uFF08\u8D70\u5B98\u7F51\u5B89\u88C5\u5305\u6216 embeddable zip\uFF09
    |\n| \u667A\u80FD\u5B57\u5E55\u4F1A\u5458 | \u672A\u9A8C\u8BC1\uFF08\u7528\u6237\u8BA1\u5212\u9700\u8981\u65F6\u518D\u4E70\u4F1A\u5458\uFF09
    | \u526A\u6620\"\u667A\u80FD\u5B57\u5E55\"\u9700\u767B\u5F55\u4F1A\u5458\u8D26\u53F7
    |\n\n#\n\u4E8C\u3001\u4E09\u6761\u9884\u8BBE\u8DEF\u7EBF\u7684\u88C1\u51B3\n\n\xB7
    \u8DEF\u7EBF A\uFF08pyJianYingDraft \u8349\u7A3F\u6CE8\u5165 + \u5C11\u91CF\u70B9\u51FB\uFF09\uFF1A\u274C
    \u4E0D\u53EF\u884C\u3002\u8BE5\u5E93\u53EA\u517C\u5BB9\u526A\u6620 \u22645.9
    \u7684\u660E\u6587\u8349\u7A3F\uFF0C\u5F53\u524D 11.3 \u8349\u7A3F\u5DF2\u52A0\u5BC6\u3002\u9664\u975E\u964D\u7EA7\u88C5
    5.9 \u5E76\u5173\u81EA\u52A8\u66F4\u65B0\uFF08\u5B98\u65B9\u5DF2\u4E0D\u63D0\u4F9B\u8001\u7248\u672C\uFF09\u3002\n\xB7
    \u8DEF\u7EBF B\uFF08\u7EAF UI \u81EA\u52A8\u5316\uFF0C\u517C\u5BB9\u5F53\u524D\u7248\f\u672C\uFF09\uFF1A\u2705
    \u63A8\u8350\u4E3B\u8DEF\u7EBF\u3002\u6280\u672F\u6808\uFF1APython + pyautogui/pywin32
    + OpenCV \u6A21\u677F\u5339\u914D\u3002\u8981\u70B9\uFF1A\n  \xB7 \u6309\u94AE\u5B9A\u4F4D\u5168\u90E8\u7528\"\u622A\u56FE\u6A21\u677F\u5339\u914D\"\uFF0C\u4E0D\u4F9D\u8D56\u63A7\u4EF6\u6811\uFF1B\n 
    \xB7 \u80FD\u8D70\u5FEB\u6377\u952E\u7684\u8D70\u5FEB\u6377\u952E\uFF08\u65B0\u5EFA\u3001\u5BFC\u5165\u3001\u5BFC\u51FA\u3001\u9009\u4E2D\u5168\u90E8\u7247\u6BB5\u7B49\uFF09\uFF0C\u51CF\u5C11\u56FE\u50CF\u5339\u914D\u9762\uFF1B\n 
    \xB7 \u6587\u4EF6\u9009\u62E9\u6846\u662F\u7CFB\u7EDF\u539F\u751F\u5BF9\u8BDD\u6846\uFF0C\u63A7\u4EF6\u7EA7\u53EF\u81EA\u52A8\u5316\uFF0C\u4E0D\u53D7\u526A\u6620\u81EA\u7ED8
    UI \u5F71\u54CD\uFF1B\n  \xB7 \u8BC6\u522B\u5B8C\u6210\u5224\u5B9A\uFF1A\u8F6E\u8BE2\u8349\u7A3F\u76EE\u5F55\u6587\u4EF6
    mtime/size + \u5BF9\u754C\u9762\u5C40\u90E8\u622A\u56FE\u505A\u6A21\u677F\u5339\u914D\uFF08\u53CC\u4FDD\u9669\uFF09\u3002\n\xB7
    \u8DEF\u7EBF C\uFF08\u672C\u5730 Whisper + \u7ED5\u5F00\u526A\u6620\uFF09\uFF1A\u2705
    \u4F5C\u4E3A\u515C\u5E95/\u5BF9\u7167\u7EC4\u3002\u82E5 B \u7684\u8BC6\u522B\u7B49\u5F85/\u5BFC\u51FA\u73AF\u8282\u4E0D\u7A33\uFF0C\u53EF\u6539\u6210\"\u526A\u6620\u53EA\u505A\u5BFC\u51FA\u524D\u7684\u6210\u7247\uFF0C\u5B57\u5E55\u7528
    faster-whisper \u672C\u5730\u751F\u6210 SRT \u518D\u70E7\u5F55\"\u3002\u4F1A\u5458\u8D39\u4E5F\u7701\u4E86\u3002\n\n#\n\u4E09\u3001\u76EE\u6807\u5168\u81EA\u52A8\u6D41\u7A0B\uFF08\u8DEF\u7EBF
    B \u8BBE\u8BA1\u7A3F\uFF09\n\n\n[\u76D1\u63A7\u6587\u4EF6\u5939\uFF0C\u53D1\u73B0
