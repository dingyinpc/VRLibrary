--- !u!114 &2088537166
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2088537164}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: daf404ac10c46324790e3afd8418ce81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: "\u62D6\u62FD\u6280\u672F\u5BF9\u6BD4"
  author: "\u65E5\u5E38\u95EE\u9898\u5904\u7406\u7ECF\u9A8C"
  summary: "\n\u62D6\u62FD\u6280\u672F\u5BF9\u6BD4\uFF1A\u5C4F\u5E55\u589E\u91CF
    vs \u5750\u6807\u8F6C\u6362\n\n---\n\n#\n\u4E00\u53E5\u8BDD\u603B\u7ED3\n\n|
    \u65E7\u65B9\u6848 | \u65B0\u65B9\u6848 |\n|--------|--------|\n| `rt.position
    += (Vector3)eventData.delta` | `RectTransformUtility.ScreenPointToLocalPointInRectangle`
    |\n\n\u65B0\u65B9\u6848\u7684\u4F18\u70B9\uFF1A\u4E0D\u53D7 Canvas \u7F29\u653E\u5F71\u54CD\u3001\u4E0D\u4F9D\u8D56\u5E27\u7387\u3001\u4E0D\u6F0F\u5E27\u3001\u4E0D\u4F1A\u98DE\u51FA\u53BB\u3002\n\n---\n\n#\n\u4E24\u79CD\u65B9\u6848\u56FE\u89E3\n\n##\n\u65E7\u65B9\u6848\uFF1A\u5C4F\u5E55\u50CF\u7D20\u589E\u91CF\n\ntext\n                   
    \u5C4F\u5E55\u7A7A\u95F4 (Screen Space)\n  \u250C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\n 
    \u2502                                            \u2502\n  \u2502   \u9F20\u6807\u4ECE
    A(100,200) \u2192 B(120,230)   \f        \u2502\n  \u2502   delta = (20, 30)    
    \u2190 \u50CF\u7D20\u589E\u91CF          \u2502\n  \u2502                                           
    \u2502\n  \u2502   rt.position += (20, 30)                  \u2502\n  \u2502  
    \u2191 \u76F4\u63A5\u52A0\u5230\u4E16\u754C\u5750\u6807\u4E0A                     
    \u2502\n  \u2502                                            \u2502\n  \u2502  
    \u95EE\u9898\uFF1A                                     \u2502\n  \u2502   \u2460
    Canvas \u7F29\u653E\u56E0\u5B50 = 2 \u65F6\uFF0C                     \u2502\n 
    \u2502      \u5B9E\u9645\u79FB\u52A8\u5E94\u8BE5\u53EA\u6709 (10, 15)                   
    \u2502\n  \u2502      \u5374\u79FB\u52A8\u4E86 (20, 30\f) \u2192 \u98DE\u51FA\u53BB\u4E86               
    \u2502\n  \u2502   \u2461 \u5982\u679C\u67D0\u5E27 delta \u5F02\u5E38\u5927\uFF08\u9F20\u6807\u77AC\u79FB\uFF09           
    \u2502\n  \u2502      \u7269\u4F53\u76F4\u63A5\u8DF3\u5230\u5C4F\u5E55\u5916                          
    \u2502\n  \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\n\n\n\u95EE\u9898\u6839\u6E90\uFF1A`eventData.delta`
    \u662F\u5C4F\u5E55\u50CF\u7D20\u589E\u91CF\uFF0C\u4F46 `rt.position` \u662F\u4E16\u754C\u5750\u6807\uFF08\u6216
    UI \u5750\u6807\uFF09\u3002\u5F53 Canvas \u6709\u7F29\u653E\u65F6\uFF0C\u4E24\u8005\u5355\u4F4D\u4E0D\u7EDF\u4E00\uFF0C\u50CF\u7D20\u589E\u91CF\u76F4\u63A5\u52A0\u5230\u4E16\u754C\u5750\u6807\u4E0A\u5C31\u4F1A\u653E\u5927/\u7F29\u5C0F\u4F4D\u79FB\u91CF\uFF0C\u5BFC\u81F4\u7269\u4F53\u8DDF\u4E0D\u4E0A\u9F20\u6807\u6216\u8DD1\u8FC7\u5934\u3002\n\n---\n\n##\n\u65B0\u65B9\u6848\uFF1A\u5C4F\u5E55\u5750\u6807
    \u2192 \u672C\u5730\u5750\u6807\n\ntext\n                    \u5C4F\u5E55\u7A7A\u95F4
    (Screen Space)\n  \u250C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\n 
    \u2502  mo\fuse.screenPos = (500, 300)              \u2502\n  \u2502       \u2502                                   
    \u2502\n  \u2502       \u2502  RectTransformUtility.             \u2502\n  \u2502      
    \u2502  ScreenPointToLocalPointInRectangle\u2502\n  \u2502       \u2502  (parentRt,
    screenPos, camera)     \u2502\n  \u2502       \u25BC                                   
    \u2502\n  \u2502  parent \u672C\u5730\u5750\u6807 = (200, -150)             \u2502\n 
    \u2502       \u2502                                    \u2502\n  \u2502      
    \u2502  rt.anchoredPos\fition = local + off \u2502\n  \u2502       \u25BC                                   
    \u2502\n  \u2502  \u7269\u4F53\u7CBE\u786E\u8DDF\u968F\u9F20\u6807 \u2199                        
    \u2502\n  \u2502                                            \u2502\n  \u2502 
    Canvas \u7F29\u653E = 2                           \u2502\n  \u2502  \u5185\u90E8\u81EA\u52A8\u9664\u4EE5\u4E86\u7F29\u653E\u56E0\u5B50                      
    \u2502\n  \u2502  \u7ED3\u679C\u6C38\u8FDC\u51C6\u786E                               
    \u2502\n  \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\n\n\n\u5173\u952E
    API\uFF1A\n\ncsharp\nRectTransformUtility.ScreenPointToLocalPointInRecta\fngle(\n   
    RectTransform parent,      // \u7236\u7EA7 RectTransform\uFF08drinkPanel\uFF09\n   
    Vector2 screenPoint,       // \u9F20\u6807\u5C4F\u5E55\u5750\u6807\n    Camera
    cam,                // \u6E32\u67D3 Camera\uFF08Overlay \u4F20 null\uFF09\n   
    out Vector2 localPoint     // \u8F6C\u6362\u540E\u7684\u7236\u7EA7\u672C\u5730\u5750\u6807\n);\n\n\n---\n\n#\n\u5BF9\u6BD4\u8868\u683C\n\n|
    \u7EF4\u5EA6 | `+= delta`\uFF08\u65E7\uFF09 | `ScreenPointToLocalPoint`\uFF08\u65B0\uFF09
    |\n|------|-----------------|-------------------------------|\n| \u5750\u6807\u7A7A\u95F4
    | \u4E16\u754C\u5750\u6807\u76F4\u63A5\u52A0\u5C4F\u5E55\u50CF\u7D20 | \u5C4F\u5E55
    \u2192 \u7236\u7EA7\u672C\u5730\u5750\u6807\u7EDF\u4E00\u6362\u7B97 |\n| Canvas
    \u7F29\u653E | \u53D7\u5F71\u54CD\uFF0C\u4F4D\u79FB\u4F1A\u88AB\u7F29\u653E\u56E0\u5B50\u653E\u5927
    \f| \u81EA\u52A8\u5904\u7406\uFF0C\u4E0D\u53D7\u5F71\u54CD |\n| \u9F20\u6807\u77AC\u79FB
    | \u5355\u5E27 delta \u8FC7\u5927 \u2192 \u7269\u4F53\u98DE\u8D70 | \u6BCF\u5E27\u91CD\u65B0\u8BA1\u7B97\u7EDD\u5BF9\u4F4D\u7F6E\uFF0C\u4E0D\u4F1A\u98DE
    |\n| \u6F0F\u5E27 | \u4E22\u5E27\u540E delta \u7D2F\u52A0\u9519\u8BEF | \u6BCF\u5E27\u6839\u636E\u9F20\u6807\u5F53\u524D\u4F4D\u7F6E\u5B9A\u4F4D\uFF0C\u4E0D\u7D2F\u79EF\u8BEF\u5DEE
    |\n| \u591A Canvas \u6A21\u5F0F | ScreenSpaceCamera / WorldSpace \u4E0B\u884C\u4E3A\u9519\u8BEF
    | \u4E09\u79CD\u6A21\u5F0F\u5747\u6B63\u5E38\u5DE5\u4F5C |\n| \u5B9E\u73B0\u590D\u6742\u5EA6
    | 1 \u884C | 4 \u884C\uFF08\u542B offset \u8BB0\u5F55\uFF09 |\n\n---\n\n#\n\u4E3A\u4EC0\u4E48\u65E7\u65B9\u6848\u4F1A\"\u98DE\u51FA\u53BB\"\n\n\u5173\u952E\u5728
    Canvas \u7684 Scale Factor\uFF1A\n\ntext\n\u5047\u8BBE\uFF1A\n  Canvas Scaler
    \u7684 Scale Factor = 2\n  \u9F20\u6807\u5728\u5C4F\u5E55\u79FB\u52A8\u4E86 10
    \u50CF\u7D20\n\n\u65E7\u65B9\u6848\uFF1A\n  delta = (10, 0)\n  rt.position +=
    (10, 0)\n  \u2192 \u7269\u4F53\u5728 UI \u7A7A\u95F4\u79FB\u52A8\u4E86 20 \u4E2A\u5355\u4F4D\uFF08\u56E0\u4E3A\u7F29\u653E\uFF09\n 
    \u2192 \u9F20\u6807\u5B9E\u9645\u53EA\u79FB\u52A8\u4E86 10 \u50CF\u7D20\n  \u2192
    \u7269\u4F53\f\u6BD4\u9F20\u6807\u5FEB\u4E00\u500D \u2192 \"\u98DE\u51FA\u53BB\u4E86\"\n\n\u65B0\u65B9\u6848\uFF1A\n 
    ScreenPointToLocalPointInRectangle \u5185\u90E8\u8BA1\u7B97\u65F6\n  \u81EA\u52A8\u9664\u4EE5
    Scale Factor = 2\n  \u2192 localPoint \u6B63\u786E\u5F97\u5230 5 \u4E2A\u5355\u4F4D\n 
    \u2192 \u7269\u4F53\u79FB\u52A8 5 \u4E2A\u5355\u4F4D\n  \u2192 \u9F20\u6807\u79FB\u52A8
    10 \u50CF\u7D20\u6B63\u597D\u5BF9\u5E94 UI \u7A7A\u95F4 5 \u4E2A\u5355\u4F4D\n 
    \u2192 \u5B8C\u7F8E\u540C\u6B65\n\n\n---\n\n#\n\u6838\u5FC3\u4EE3\u7801\u89E3\u6790\n\ncsharp\nprivate
    Vector2 dragOffset;  // \u2190 \u65B0\u589E\uFF1A\u9F20\u6807\u4E0E\u7269\u4F53\u7684\u504F\u79FB\u91CF\n\npublic
    void OnBeginDrag(PointerEventData eventData)\n{\n    // \u628A\u9F20\u6807\u5F53\u524D\u5C4F\u5E55\u5750\u6807\u8F6C\u6210
    drinkPanel \u7684\u672C\u5730\u5750\u6807\n    RectTransformUtility.ScreenPointToLocalPointInRectangle(\n       
    parentRt,             \f              // drinkPanel \u7684 RectTransform\n       
    eventData.position,                  // \u9F20\u6807\u5C4F\u5E55\u5750\u6807\n       
    canvas.worldCamera,                 // \u5F53\u524D Canvas \u7684 Camera\n       
    out Vector2 localPoint              // \u6362\u7B97\u540E\u7684\u672C\u5730\u5750\u6807\n   
    );\n\n    // \u8BB0\u5F55\u7269\u4F53\u5F53\u524D\u4F4D\u7F6E\u4E0E\u9F20\u6807\u4F4D\u7F6E\u4E4B\u95F4\u7684\u5DEE\u503C\n   
    dragOffset = rt.anchoredPosition \xB7 localPoint;\n\n    cg.blocksRaycasts =
    false;\n    cg.alpha = 0.8f;\n    board.OnDrinkDragStart(this);\n}\n\npublic
    void OnDrag\f(PointerEventData eventData)\n{\n    // \u6BCF\u5E27\u91CD\u65B0\u8BA1\u7B97\u9F20\u6807\u5728
    drinkPanel \u672C\u5730\u5750\u6807\u4E2D\u7684\u4F4D\u7F6E\n    if (RectTransformUtility.ScreenPointToLocalPointInRectangle(\n           
    parentRt, eventData.position, canvas.worldCamera, out Vector2 localPoint))\n   
    {\n        // \u7269\u4F53\u4F4D\u7F6E = \u9F20\u6807\u672C\u5730\u5750\u6807
    + \u504F\u79FB\u91CF\uFF08\u4FDD\u6301\u6309\u4E0B\u65F6\u7684\u76F8\u5BF9\u4F4D\u7F6E\uFF09\n       
    rt.anchoredPosition = localPoint + dragOffset;\n    }\n}\n\n\n\u5173\u952E\u7406\u89E3\uFF1A\n\xB7
    `anchoredPosition` \u662F\u76F8\u5BF9\u4E8E\u7236\u7EA7 `drinkPanel` \u7684\u5750\u6807\n\xB7
    `ScreenPointToLocalPointInR\fectangle` \u4E5F\u76F8\u5BF9 `drinkPanel` \u6362\u7B97\n\xB7
    \u4E24\u8005\u5728\u540C\u4E00\u5750\u6807\u7CFB\u4E0B\u8FD0\u7B97\uFF0C\u6C38\u8FDC\u51C6\u786E\n\xB7
    `dragOffset` \u4FDD\u8BC1\u7269\u4F53\u4E0D\u4F1A\"\u8DF3\"\u5230\u9F20\u6807\u4F4D\u7F6E\uFF0C\u800C\u662F\u4FDD\u6301\u5728\u6309\u4E0B\u65F6\u76F8\u5BF9\u9F20\u6807\u7684\u4F4D\u7F6E\n\n---\n\n#\n\u7B80\u5355\u7C7B\u6BD4\n\n|
    | \u65E7\u65B9\u6848 | \u65B0\u65B9\u6848 |\n|--|--------|--------|\n| \u6BD4\u55BB
    | \"\u6211\u63A8\u4E86\u4F60\u4E00\u628A\uFF0C\u529B\u6C14\u6709\u591A\u5927\u53D6\u51B3\u4E8E\u6211\u624B\u6296\u5F97\u591A\u5389\u5BB3\"
    | \"\u6211\u7684\u624B\u4E00\u76F4\u642D\u5728\u4F60\u80A9\u8180\u4E0A\uFF0C\u4F60\u6C38\u8FDC\u5728\u6211\u624B\u7684\u4F4D\u7F6E\"
    |\n| \u7ED3\u679C | \u6709\u65F6\u63A8\u591A\u4E86\uFF0C\u6709\u65F6\u63A8\u5C11\u4E86
    | \u6C38\u8FDC\u7CBE\u51C6\u8DDF\u968F |\n"
  slotCode: B2-1-07
