--- !u!114 &1841887154
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1841887152}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: daf404ac10c46324790e3afd8418ce81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: "\u5B9E\u73B0\u65B9\u6848 \xB7 09-\u4ECE\u96F6\u5F00\u59CB\u9010\u6B65\u642D\u5EFA\u6307\u5357"
  author: "VRlibrary \u9879\u76EE\u7EC4"
  summary: "\n09 \u4ECE\u96F6\u5F00\u59CB\u9010\u6B65\u642D\u5EFA\u6307\u5357(\u7167\u7740\u505A\u5373\u53EF\u590D\u523B)\n\n>
    \u672C\u6307\u5357\u6309\u771F\u5B9E\u642D\u5EFA\u987A\u5E8F\u7F16\u6392,\u6BCF\u4E00\u6B65\u7ED9\u51FA\u3010\u505A\u4EC0\u4E48
    / \u5173\u952E\u53C2\u6570 / \u9A8C\u6536\u6807\u51C6\u3011\u3002\n> \u7EC6\u8282\u539F\u7406\u5728
    01~08 \u5404\u6587\u6863\u4E2D,\u6B65\u9AA4\u91CC\u6807\u6CE8\u4E86(\u8BE6\u89C1
    0X)\u3002\n> \u5168\u7A0B\u9884\u8BA1 3~5 \u5C0F\u65F6(\u4E0D\u542B PICO SDK
    \u4E0B\u8F7D)\u3002\n\n#\n\u9636\u6BB5 0:\u73AF\u5883\u51C6\u5907(\u7EA6 20 \u5206\u949F)\n\n\u6B65\u9AA4
    0.1 \u5B89\u88C5 Unity\n\xB7 Unity Hub \u5B89\u88C5 2022.3.42f1c1(LTS),\u52FE\u9009\u6A21\u5757:Android
    Build Support(\u542B Android SDK/NDK + OpenJDK)\u3001Windows Build Support\u3002\n\n\u6B65\u9AA4
    0.2 \u65B0\u5EFA\u5DE5\u7A0B\n\xB7 Hub \u2192 New Project \u2192 \u6A21\u677F
    Universal 3D(URP) \u2192 \u5DE5\u7A0B\u540D `VRlibrary` \u2192 Create\u3002\n\n\u6B65\u9AA4
    0.3 \u5B89\u88C5\u5305(Package Manager \u2192 Unity Registry)\n| \u5305\u540D\f
    | \u7248\u672C | \u9644\u5E26\u64CD\u4F5C |\n| --\xB7 | --\xB7 | --\xB7 |\n|
    XR Interaction Toolkit | 2.6.5 | Samples \u91CC\u5BFC\u5165 Starter Assets(\u5FC5)\u3001XR
    Device Simulator(\u7F16\u8F91\u5668\u952E\u76D8\u6D4B\u8BD5\u7528) |\n| XR Hands
    | 1.4.3 | \u53EF\u9009 |\n| Input System | 1.19.0 | \u5F39\u7A97\u5207\u65B0\u8F93\u5165\u7CFB\u7EDF\u9009
    Yes(\u81EA\u52A8\u91CD\u542F\u7F16\u8F91\u5668) |\n\n\u9A8C\u6536:Package Manager
    \u91CC 4 \u4E2A\u5305\u65E0\u62A5\u9519;`File \u2192 Build Settings` \u80FD\u770B\u5230
    Android \u5E73\u53F0\u3002\n\n#\n\u9636\u6BB5 1:PICO SDK \u63A5\u5165(\u7EA6
    30 \u5206\u949F)\n\n\u6B65\u9AA4 1.1 \u5BFC\u5165 SDK:\u5B98\u7F51\u4E0B\u8F7D
    PICO Unity Integration SDK 3.3.0(.tgz \u8D70 Package Manager \u2192 Add Package
    From Tarball;\fzip \u5219\u89E3\u538B\u5230 `Assets/sdk/`)\u3002\n\n\u6B65\u9AA4
    1.2 \u5207\u5E73\u53F0:Build Settings \u2192 Android \u2192 Switch Platform\u3002\n\n\u6B65\u9AA4
    1.3 XR \u63D2\u4EF6:Project Settings \u2192 XR Plug-in Management \u2192 Install
    \u2192 Android \u6807\u7B7E\u9875\u52FE PICO\u3002\n(\u52FE\u5B8C\u82E5 PXR \u76F8\u5173\u7F16\u8BD1\u62A5\u9519,\u91CD\u542F\u4E00\u6B21\u7F16\u8F91\u5668\u8BA9
    SDK \u5B8C\u6210\u521D\u59CB\u5316\u3002)\n\n\u6B65\u9AA4 1.4 Android \u53C2\u6570(Player
    Settings):IL2CPP;\u4EC5 ARM64;\u53D6\u6D88 Auto Graphics API\u3001\u9996\u9009
    Vulkan;Minimum API Level 29\u3002(\u8BE6\u89C1 06)\n\n\u9A8C\u6536:XR Plug-in
    Management Android \u9875 PICO \u5DF2\u52FE\u3001\u65E0\u7EA2\u8272\u8B66\u544A\u3002\n\n#\n\u9636\u6BB5
    2:\u73A9\u5BB6\u7AEF(\u7EA6 10 \u5206\u949F)\n\n\u6B65\u9AA4 2.1:\u62D6\u5165
    `Samples \u2192 XR In\fteraction Toolkit \u2192 Starter Assets \u2192 Prefabs
    \u2192 XR Interaction Setup` \u5230\u573A\u666F (0,0,7),\u65CB\u8F6C Y=180(\u9762\u5411
    -Z)\u3002\n\n\u6B65\u9AA4 2.2:XR Origin \u4E0A Add Component \u2192 PXR_Manager\u3002\n\n\u6B65\u9AA4
    2.3(\u952E\u76D8\u6D4B\u8BD5):\u786E\u8BA4 XR Device Simulator sample \u5DF2\u5BFC\u5165;Project
    Settings \u2192 XR Plug-in Management \u2192 XR Interaction Toolkit \u2192 \u52FE
    Use XR Device Simulator In Scenes(\u82E5\u8BBE\u7F6E\u9875\u6CA1\u6709\u8BE5\u9009\u9879,\u628A
    sample \u91CC\u7684 `XRDeviceSimulatorSettings.asset` \u653E\u5230 Resources
    \u76EE\u5F55\u5E76\u6307\u5B9A\u6A21\u62DF\u5668\u9884\u5236\u4F53)\u3002\n\n\u9A8C\u6536:Play
    \u540E\u5DE6\u4E0B\u89D2\u51FA\u73B0 XR Devic\fe Simulator \u9762\u677F,WASD
    \u53EF\u8D70\u3001\u53F3\u952E\u4E3A\u6273\u673A\u3002\n\n#\n\u9636\u6BB5 3:\u573A\u9986\u9AA8\u67B6(\u7EA6
    60 \u5206\u949F)\n\n\u6B65\u9AA4 3.1 \u5730\u9762:Plane \u7F29\u653E (4,1,4)(=40m\xD740m);\u6750\u8D28\u6DF1\u7070\u84DD
    (0.045,0.055,0.075) \u91D1\u5C5E 0.55;\u6302 Teleportation Area\u3002\n\n\u6B65\u9AA4
    3.2 \u5730\u9762\u7F51\u683C:\u7EC6\u957F Cube(0.05\xD70.02\xD740)\u6CBF X/Z
    \u6BCF 4m \u4E00\u6761,\u6750\u8D28\u4E3A\u9752\u8272\u81EA\u53D1\u5149(\u89C1
    08;\u5148\u6309 08 \u628A Bloom \u5EFA\u597D,\u5426\u5219\u6B64\u65F6\u4E0D\u53D1\u5149)\u3002\n\n\u6B65\u9AA4
    3.3 \u56F4\u5899:\u56DB\u9762 Cube(40\xD74\xD70.4)\u4F4D\u4E8E \xB119.8,\u6750\u8D28\u6DF1\u7070;\u9876\u90E8\u5185\u6CBF\u52A0\u9752/\u54C1\u7EA2\u53D1\u5149\u6536\u8FB9\u6761\u3002\n\n\u6B65\u9AA4
    3.4 \u540A\u9876:6\xD76 \u7F51\u683C,\u6DF1\u8272\u677F 5.4\xD70.15\xD75.4 @y5.6
    + \u5185\u5D4C\u53D1\u5149\u767D\u683C 4.4\xD70.06\xD74.4 @y5.5\u3002\n\n\u6B65\u9AA4
    3.5 \u706F\u5149:\u6309 03 \u6587\u6863\u6E05\u5355\u5E03\u706F(\u4E3B\u5E73\u884C\u5149
    0.55 + \u4E66\u67B6\u5C04\u706F + \u5206\u533A\u70B9\u5149);Li\fghting \u2192
    Ambient = Flat (0.10,0.12,0.16);Fog = Exponential 0.014\u3002\n\n\u6B65\u9AA4
    3.6 \u5899\u9762\u88C5\u9970(\u53EF\u9009):\u88C5\u9970\u677F + \u53D1\u5149\u7AD6\u7F1D
    + \u9876\u90E8\u94C6\u9489\u706F\u70B9,\u53C2\u8003\u573A\u666F WallDecor\u3002\n\n\u6B65\u9AA4
    3.7 \u7ED3\u6784\u67F1\u4E0E\u95E8\u62F1(\u53EF\u9009):\u56DB\u89D2 (\xB116.5,\xB116.5)
    \u7ED3\u6784\u67F1;\u5165\u53E3 (0,9.5) \u95E8\u62F1\u6A2A\u6881+\u540A\u724C\u3002\n\n\u9A8C\u6536:Play
    \u540E\u6DF1\u8272\u573A\u9986\u3001\u9713\u8679\u53D1\u5149\u3001\u96FE\u6548\u6C1B\u56F4\u5B8C\u6574\u3002\n\n#\n\u9636\u6BB5
    4:\u4E66\u67B6\u4E0E\u4E66(\u7EA6 60 \u5206\u949F)\n\n\u6B65\u9AA4 4.1 \u5355\u7EC4\u4E66\u67B6(\u5EFA\u5B8C\u540E\u590D\u5236
    3 \u4EFD\u6446\u5230 z=-9/-3/3/9,\u65CB\u8F6C Y=90 \u9762\u5411\u623F\u95F4):\n\xB7
    \u80CC\u677F 5.6\xD73.2\xD70.08;\u56DB\u6839\u7ACB\u67F1;3 \u5C42\u5C42\u677F
    5.5\xD70.06\xD70.45(y=0.35/1.25/2.15);\n\xB7 \u6BCF\u5C42\u524D\u6CBF\u9752\u8272\u706F\u6761;\u9876\u90E8\u706F\u7BB1
    5.7\xD70.15\xD70.5(\u767D\u8272\u81EA\u53D1\u5149);\u7AEF\u5934\u6302\u5206\u533A\u724C(\u89C1
    05 \u7684 TextMesh \u505A\u6CD5,\u8BB0\u5F97 Y \u8F6C 1\f80\xB0)\u3002\n\n\u6B65\u9AA4
    4.2 \u5355\u672C\u4E66(\u8BE6\u89C1 04 \u6587\u6863\"\u624B\u52A8\u590D\u523B\"):\n\xB7
    Cube \u7F29\u653E (0.34,0.26,0.06),9 \u8272\u4E66\u810A\u6750\u8D28\u4EFB\u9009;\n\xB7
    XR Grab Interactable(Velocity Tracking)+ Rigidbody;\n\xB7 LibraryBook \u811A\u672C,\u586B
    title/author/summary;\n\xB7 \u4E66\u810A TextMesh \u6807\u7B7E(characterSize
    0.015,Y \u8F6C 180\xB0)+ \u6DF1\u8272\u5E95\u677F;\n\xB7 \u590D\u5236\u6446\u6EE1(\u6BCF\u5C42
    8 \u672C,\u5C42\u95F4\u9519\u4F4D\u6296\u52A8\u66F4\u81EA\u7136)\u3002\n\n\u6B65\u9AA4
    4.3 \u6279\u91CF\u5BFC\u5165\u771F\u5B9E\u5185\u5BB9:\u7F16\u8F91 `Assets/Data/bookdata.json`
    \u2192 \u83DC\u5355 `VRLibrary \u2192 \u5BFC\u5165\u9986\u85CF\u6570\u636E(JSON)`\u3002\n\n\u9A8C\u6536:Play
    \u2192 \u6293\u4E66\u987A\u624B\u3001\u6263\u6273\u673A\u5F39\u51FA\u9605\u8BFB\u5C4F(\u9605\u8BFB\u5C4F\u5728\u9636\u6BB5
    5 \u5EFA)\u3002\n\n#\n\u9636\u6BB5 5:\u5C4F\u5E55\u7CFB\u7EDF(\u7EA6 60 \u5206\u949F)\n\n\u6B65\u9AA4
    5.1 \u4E2D\u592E\u5BFC\u89C8\u5C4F(\u8BE6\u89C1 05):\n\xB7 \u5BFC\u89C8\u53F0\u5706\f\u67F1\u5E95\u5EA7(\u534A\u5F84
    0.3 \u9AD8 1.0)+ \u54C1\u7EA2\u5149\u73AF;\n\xB7 \u5B50\u7269\u4F53\u5EFA Canvas(WorldSpace,760\xD7460,scale
    0.0024,\u4F4D\u7F6E\u5EA7\u4E0A\u65B9 2.05m,\u65CB\u8F6C -8/180/0)+ TrackedDeviceGraphicRaycaster;\n\xB7
    \u6807\u9898/\u526F\u6807\u9898/\u72B6\u6001 Text(Legacy Text,LegacyRuntime.ttf)+
    3 \u4E2A\u6309\u94AE;\n\xB7 \u6302 LibraryUIController,\u72B6\u6001 Text \u62D6\u5165
    statusText\u3002\n\n\u6B65\u9AA4 5.2 \u9605\u8BFB\u9762\u677F:\u540C\u6CD5\u5EFA
    660\xD7600 Canvas(scale 0.0022,pivot \u5E95\u90E8),\u7ED3\u6784=\u6807\u9898/\u4F5C\u8005/\u6B63\u6587/\u9875\u7801/\u4E0A\u4E00\u9875/\u5173\u95ED/\u4E0B\u4E00\u9875;\u6302
    BookReader,\u6309\u94AE\u7ED1 PrevPage/NextPage/Close;\u7269\u4F53\u4FDD\u6301\u6FC0\u6D3B(Awake
    \u4F1A\u81EA\u52A8\u9690\u85CF)\u3002\n\n\u6B65\u9AA4 5.3 \u5F52\u8FD8\u53E3\u72B6\u6001\u5C4F:\u670D\u52A1\u53F0\u4E0A
    620\xD7220 \u5C0F Can\fvas,Text \u4EA4\u7ED9 BookReturnSocket\u3002\n\n\u9A8C\u6536:Play
    \u2192 \u5C04\u7EBF\u70B9\u6309\u94AE\u6709\u60AC\u505C\u53D8\u8272;\u6293\u4E66\u6263\u6273\u673A\u5F39\u51FA\u9605\u8BFB\u5C4F\u3002\n\n#\n\u9636\u6BB5
    6:\u4F20\u9001\u4E0E\u5F52\u8FD8(\u7EA6 30 \u5206\u949F)\n\n\u6B65\u9AA4 6.1:\u5730\u9762
    Teleportation Area(\u9636\u6BB5 3.1 \u5DF2\u6302);4 \u4E2A\u53D1\u5149\u5706\u76D8(Cylinder
    \u538B\u6241+\u81EA\u53D1\u5149\u5708)\u5206\u522B\u6302 Teleportation Anchor,\u653E\u5728\u5165\u53E3
    (0,0,10)\u3001\u4E66\u67B6 (-13,0,0)\u3001\u9605\u8BFB\u533A (10,0,0)\u3001\u670D\u52A1\u53F0
    (0,0,-12.5)\u3002\n\n\u6B65\u9AA4 6.2 \u6309\u94AE\u4F20\u9001:\u5EFA\u7A7A\u7269\u4F53
    `Dest_ShelfArea`(-12.5,0,3,Y=-90);\u5BFC\u89C8\u53F0\u6302 KioskTeleporter(origin=XR
    Origin,destination=Dest_ShelfArea);\"\u8FDB\u5165\u56FE\u4E66\u9986\"\u6309\u94AE
    onClick \u8FFD\u52A0 TeleportToDestination\u3002\n\n\u6B65\u9AA4 6.3 \u670D\u52A1\u53F0\u5F52\u8FD8\u53E3\f:\u53F0\u4F53
    + \u9876\u90E8\u53D1\u5149\u5708;\u7A7A\u7269\u4F53\u6302 XR Socket Interactor(Sphere
    Collider Is Trigger r=0.18)+ BookReturnSocket(statusText \u62D6\u72B6\u6001\u5C4F
    Text);\u53E3\u5916\u56F4\u54C1\u7EA2\u5149\u73AF\u3002\n\n\u6B65\u9AA4 6.4 \u5C04\u7EBF\u60AC\u505C\u5F00\u4E66:\u4E24\u4E2A
    Ray Interactor \u52FE Allow Hovered Activate\u3002\n\n\u9A8C\u6536:\u70B9\"\u8FDB\u5165\u56FE\u4E66\u9986\"\u76F4\u63A5\u843D\u5230\u4E66\u67B6\u524D;\u4E66\u653E\u8FDB\u611F\u5E94\u5708\u8BA1\u6570;\u6307\u4E66\u6263\u6273\u673A\u80FD\u5F00\u3002\n\n#\n\u9636\u6BB5
    7:\u5929\u7A7A\u76D2\u4E0E\u6C1B\u56F4\u6536\u5C3E(\u7EA6 20 \u5206\u949F)\n\n\u6B65\u9AA4
    7.1:\u5BFC\u5165 `CyberNightSky.shader`,\u5EFA `M_CyberNightSky`,Lighting \u2192
    Environment \u2192 Skybox Material \u62D6\u5165;\u53C2\u6570\u53C2\u8003 02(\u6708\u4EAE\u5C3A\u5BF8
    0.033)\u3002\n\n\u6B65\u9AA4 7.2:\u786E\u8BA4 SkyboxSunSync \u7F16\u8F91\u5668\u811A\u672C\u5728\u5DE5\u7A0B(\u6708\u4EAE\u65B9\u5411\u968F\u4E3B\u5149)\u3002\n\n\u6B65\u9AA4
    7\f.3 \u6C1B\u56F4\u4EF6(\u53EF\u9009):\u5BFC\u89C8\u53F0\u73AF\u7ED5\u5149\u7C92(HoloOrbiter)\u3001\u9605\u8BFB\u684C\u53F0\u706F\u3001\u5899\u9762\u94C6\u9489\u3002\n\n\u9A8C\u6536:\u8D70\u8FDB\u573A\u9986\u2014\u2014\u591C\u7A7A\u6708\u4EAE\u900F\u8FC7\u540A\u9876\u8FB9\u7F18\u7684\u7F1D\u9699\u53EF\u89C1\u3001\u9713\u8679\u6CDB\u5149\u3001\u96FE\u6548\u7EB5\u6DF1\u3002\n\n#\n\u9636\u6BB5
    8:\u771F\u673A\u5BFC\u51FA(\u7EA6 30 \u5206\u949F + \u7F16\u8BD1)\n\n\u6309 06
    \u6587\u6863:\u6838\u5BF9 IL2CPP/ARM64/Vulkan/API29 \u2192 Build And Run \u2192
    \u771F\u673A\u6309 07 \u7684\u624B\u67C4\u64CD\u4F5C\u9A8C\u8BC1\u5168\u6D41\u7A0B\u3002\n\n#\n\u9644:\u6574\u5957\u5DE5\u7A0B\u7684\u7269\u4F53/\u7EC4\u4EF6\u901F\u67E5\n\n\u642D\u5EFA\u4E2D\u4EFB\u4F55\u7EC4\u4EF6\u7684\u7528\u9014\u3001\u53C2\u6570\u51FA\u5904,\u67E5:\n\xB7
    \u7EC4\u4EF6\u4E0E\u811A\u672C \u2192 `01-\u7528\u5230\u7684\u7EC4\u4EF6\u4EE5\u53CA\u4F5C\u7528.md`\n\xB7
    \u53D1\u5149\u4E0D\u751F\u6548 \u2192 `08-\u81EA\u53D1\u5149\u6548\u679C\u539F\u7406.md`(HDR
    + Bloom \u4E09\u5C42)\n\xB7 \u5C4F\u5E55\u70B9\u4E0D\u52A8 \u2192 `05-\u5C4F\u5E55\u7684\u5236\u4F5C.md`
    \u7B2C\u4E94\u8282\u94FE\u8DEF\u6392\u67E5\n\xB7 \u4E66\u76F8\u5173\u4E00\u5207
    \u2192 `04-\u4E66\u672C\u600E\u4E48\u5BFC\u5165\u4E0E\u624B\u52A8\u590D\u523B.md`\n"
  slotCode: B2-1-06
