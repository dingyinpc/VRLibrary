  summary: "\n\u7F16\u8BD1\u9519\u8BEF\uFF1ACellState \u672A\u5305\u542B \"Empty\"
    \u7684\u5B9A\u4E49 \u2014\u2014 \u679A\u4E3E\u88AB\u8BEF\u5199\u6210 MonoBehaviour
    \u7C7B\n\n> \u9879\u76EE\uFF1A\u732B\u5496\u7ECF\u8425\uFF08Unity\uFF09\n> \u573A\u666F\uFF1A\u68CB\u76D8\u683C\u72B6\u6001\u7CFB\u7EDF\u6539\u9020\uFF08BoardGrowth\uFF09\uFF0C\u7167\u6587\u6863\u6B65\u9AA4\u5B9E\u73B0\u65F6\u51FA\u73B0\u3002\n>
    \u9519\u8BEF\u7801\uFF1ACS1061\uFF08\u6210\u5458\u7F3A\u5931\uFF09\u2014\u2014\u4E0D\u662F
    CS0246\uFF08\u7C7B\u578B\u627E\u4E0D\u5230\uFF09\u3002\n\n#\n\u4E00\u3001\u95EE\u9898\u73B0\u8C61\n\n\u5728
    `BoardCellRegistry.cs` \u91CC\u5199\u4E86\uFF1A\n\ncsharp\nprivate readonly CellState[]
    States = new CellState[TotalCellCount];\n\n\n\u5E76\u5728\u903B\u8F91\u91CC\u6253\u7B97\u4F7F\u7528
    `CellState.Empty` \u4F5C\u4E3A\u72B6\u6001\u503C\uFF0C\u7F16\u8BD1\u5668\u62A5\uFF1A\n\ntext\n\"CellState\"
    \u672A\u5305\u542B \"Empty\" \u7684\u5B9A\u4E49\n\n\n\u6587\u4EF6\u660E\u660E\u5B58\u5728\u3001\u7C7B\u540D\u4E5F\u6B63\u786E\uFF0C\u4F46\u679A\u4E3E\u6210\u5458\u5C31\u662F\u627E\u4E0D\u5230\u3002\n\n#\n\u4E8C\u3001\u6392\u67E5\u8FC7\u7A0B\n\n1.
    \u5148\u786E\u8BA4 `CellState` \u7C7B\u578B\u662F\u5426\u5B58\u5728 \u2192 \u5B58\u5728\uFF08\u6709
    CellStat\fe.cs \u6587\u4EF6\uFF09\uFF1B\n2. \u518D\u770B\u5B83\u662F\"\u4EC0\u4E48\u5F62\u6001\"\uFF1A\u6253\u5F00\u6587\u4EF6\u53D1\u73B0\u2014\u2014\n\ncsharp\npublic
    class CellState : MonoBehaviour      // \u2190 \u662F\u3010\u7C7B\u3011\uFF0C\u4E0D\u662F\u679A\u4E3E\uFF01\n{\n   
    public enum CellStateType { Locked, Empty, ItemOccupied, ReservedForTutorial
    }\n}\n\n\n3. \u5BF9\u6BD4\u4F7F\u7528\u5904\u7684\u8BED\u4E49\uFF1A`CellState.Empty`
    \u671F\u671B `Empty` \u662F\"\u679A\u4E3E\u6210\u5458\"\uFF0C\u800C\u5B9E\u9645
    `Empty` \u88AB\u5D4C\u5957\u8FDB\u4E86 `CellStateType`\uFF0C\u4E14\u7C7B\u4E0A\u6CA1\u6709\u4EFB\u4F55\u53EB
    `Empty` \u7684\u6210\u5458\u3002\n\n#\n\u4E09\u3001\u6839\u56E0\n\n\u7C7B\u578B\u5F62\u6001\uFF08enum
    vs class\uFF09\u4E0E\u8C03\u7528\u65B9\u8BED\u4E49\u4E0D\u4E00\u81F4\u3002\n\n\xB7
    \u8BBE\u8BA1\u6587\u6863\u8981\u6C42\uFF1A`CellState` \u662F\u7EAF\u679A\u4E3E\uFF0C`CellState.Empty`
    \u662F\u679A\u4E3E\u5E38\u91CF\u3002\n\xB7 \u5B9E\u9645\u5B9E\u73B0\uFF1A`CellState`
    \u88AB\u5199\u6210\u4E86 MonoBeha\fviour \u7C7B\uFF0C\u5E76\u628A\u679A\u4E3E\u5D4C\u5957\u6539\u540D\u6210\u4E86
    `CellStateType`\u3002\n\xB7 \u4E8E\u662F\uFF1A\n  \xB7 `CellState` \u8FD9\u4E2A\u540D\u5B57\u5B58\u5728\uFF08\u6240\u4EE5\u4E0D\u62A5\"\u627E\u4E0D\u5230\u7C7B\u578B\"\uFF0C\u62A5\u7684\u662F\"\u4E0D\u5305\u542B\u6210\u5458\"\uFF09\uFF1B\n 
    \xB7 \u7C7B\u91CC\u6CA1\u6709 `Empty` \u5B57\u6BB5/\u5C5E\u6027 \u2192 `CellState.Empty`
    \u5FC5\u7136\u7F16\u8BD1\u5931\u8D25\uFF1B\n  \xB7 \u771F\u6B63\u7684\u6210\u5458\u53D8\u6210\u4E86
    `CellState.CellStateType.Empty`\uFF0C\u53EA\u80FD\u5728 `CellStateType` \u8BED\u5883\u4E0B\u7528\u3002\n\n>
    \u5BB9\u6613\u8FF7\u60D1\u7684\u70B9\uFF1A\u7F16\u8BD1\u5668\u9519\u8BEF\u662F\"\u8BED\u4E49\u9519\u8BEF\"\uFF08\u6210\u5458\u7F3A\u5931\uFF09\uFF0C\u800C\u4E0D\u662F\"\u7C7B\u578B\u627E\u4E0D\u5230\"\u2014\u2014\u6587\u4EF6\u5728\u3001\u540D\u5B57\u5BF9\uFF0C\u7B2C\u4E00\u773C\u5F88\u53EF\u80FD\u6000\u7591\u662F\u5F15\u7528\u6CA1\u7528\u5BF9\uFF0C\u5B9E\u9645\u662F\u7C7B\u578B\u5F62\u6001\u8DD1\u504F\u4E86\u3002\n\n#\n\u56DB\u3001\u89E3\u51B3\u65B9\u6848\n\n\u628A
    `CellState.cs` \u6539\u56DE\u8BBE\u8BA1\u53E3\u5F84\uFF1A\u7EAF\u679A\u4E3E\uFF0C\u53BB\u6389
    MonoBehaviour \u5916\u58F3\u548C\u5D4C\u5957\u7C7B\u578B\u3002\n\ncsharp\n///
    <summary>\u68CB\u76D8\u683C\u72B6\u6001\uFF08MD 6.3\uFF09\u3002</summary>\npublic
    enum Cell\fState\n{\n    Locked,              // \u6C38\u4E45\u6269\u5BB9\u5C1A\u672A\u5F00\u653E\n   
    Empty,               // \u5DF2\u5F00\u653E\u4E14\u65E0\u7269\u54C1\n    ItemOccupied,       
    // \u5DF2\u5F00\u653E\u4E14\u6709\u7269\u54C1\n    ReservedForTutorial  // \u5C5E\u4E8E\u73A9\u5BB6\u4F46\u65B0\u624B\u671F\u6682\u4E0D\u53EF\u81EA\u7531\u64CD\u4F5C\n}\n\n\n\u914D\u5957\uFF1A`BoardCellRegistry`
    \u4E5F\u53BB\u6389 MonoBehaviour\uFF08\u666E\u901A\u7C7B\u5373\u53EF\u88AB `new`
    \u521B\u5EFA\uFF09\uFF0C\u679A\u4E3E\u6570\u7EC4 `CellState[]` \u624D\u80FD\u6309\u503C\u5B58\u50A8\u72B6\u6001\u3002\n\n#\n\u4E94\u3001\u7ECF\u9A8C\u6559\u8BAD\uFF08\u4EE5\u540E\u600E\u4E48\u907F\u514D\uFF09\n\n1.
    \u5199\u5F15\u7528\u524D\uFF0C\u5148\u786E\u8BA4\u76EE\u6807\u7C7B\u578B\u7684\"\u5F62\u6001\"\uFF1Aenum
    / class / struct / MonoBehaviour \u56DB\u79CD\u5F62\u6001\u7684\u7528\u6CD5\u5B8C\u5168\u4E0D\u540C\uFF1A\n  
    \xB7 \u679A\u4E3E\uFF1A`TypeName.Member` \u662F\u5E38\u91CF\uFF1B\n   \xB7 \u7C7B\uFF1A`TypeName.Member`
    \u53EF\u80FD\u662F\u9759\u6001\u6210\u5458\uFF0C\u5B9E\u4F8B\u6210\u5458\u8981
    `.I\fnstance.Member`\uFF1B\n   \xB7 MonoBehaviour\uFF1A\u53EA\u80FD `AddComponent<Type>()`
    \u83B7\u5F97\uFF0C\u4E0D\u80FD `new`\u3002\n2. \u679A\u4E3E\u4E0D\u8981\u5957
    MonoBehaviour \u58F3\uFF1A\u72B6\u6001\u503C\u662F\"\u6570\u636E\"\uFF0C\u4E0D\u662F\"\u7EC4\u4EF6\"\uFF0C\u5957\u58F3\u4F1A\u5BFC\u81F4\u5B58\u8FDB\u6570\u7EC4\u53D8\u6210
    null\u3001\u8FD8\u4E0D\u80FD new\u3002\n3. \u547D\u540D\u4E0E\u8BBE\u8BA1\u6587\u6863\u5B8C\u5168\u4E00\u81F4\uFF1A\u522B\u64C5\u81EA\u6539\u7C7B\u578B\u540D/\u5D4C\u5957\uFF08\u5982
    `CellStateType`\uFF09\u2014\u2014\u6539\u4E86\uFF0C\u6240\u6709\u5F15\u7528\u65B9\u5168\u90E8\u8DDF\u7740\u9519\u3002\n4.
    \u533A\u5206\u4E24\u7C7B\u7F16\u8BD1\u9519\u8BEF\uFF1A\n   \xB7 CS0246\uFF08\u627E\u4E0D\u5230\u7C7B\u578B/\u547D\u540D\u7A7A\u95F4\uFF09\u2192
    \u7C7B\u578B\u4E0D\u5B58\u5728 / using \u7F3A\u5931 / \u7A0B\u5E8F\u96C6\u5F15\u7528\u7F3A\u5931\uFF1B\n  
    \xB7 CS1061\uFF08\u4E0D\u5305\u542B\u6210\u5458\u5B9A\u4E49\uFF09\u2192 \u7C7B\u578B\u5B58\u5728\u4F46\u5F62\u6001/\u6210\u5458\u4E0D\u540C
    \u2192 \u91CD\u70B9\u68C0\u67E5 enum/class \u5F62\u6001\u3001\u5927\u5C0F\u5199\u3001\u6210\u5458\u540D\u3002\n\n#\n\u516D\u3001\u5173\u8054\u77E5\u8BC6\u901F\u67E5\n\n|
    \u5199\u6CD5 | \u542B\u4E49 | \u5E38\u89C1\u9519\u8BEF |\n|---|---|---|\n| `CellState.Empty`
    | \u679A\u4E3E\u6210\u5458\u5E38\u91CF | \u82E5 \fCellState \u662F\u7C7B \u2192
    CS1061 |\n| `ClassMember.xxx` | \u9759\u6001\u6210\u5458 | \u82E5\u60F3\u7528\u5B9E\u4F8B\u6210\u5458\u5374\u5199\u6210\u9759\u6001
    \u2192 CS0176 |\n| `new BoardCellRegistry()` | \u5B9E\u4F8B\u5316\u666E\u901A\u7C7B
    | \u82E5\u76EE\u6807\u662F MonoBehaviour \u2192 \u7F16\u8BD1\u8FC7\u4F46\u8FD0\u884C\u671F\u65E0\u6548\uFF0C\u5FC5\u987B
    AddComponent |\n| `GetComponent<T>()` | \u53D6\u5DF2\u6709\u7EC4\u4EF6 | \u7EC4\u4EF6\u6CA1\u6302
    \u2192 \u8FD0\u884C\u671F NRE |"
  slotCode: D4-2-07
