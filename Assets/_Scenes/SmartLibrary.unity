--- !u!114 &1004201009
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1004201007}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: daf404ac10c46324790e3afd8418ce81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: "\u4FC4\u7F57\u65AF\u65B9\u5757\u8DEF\u7EBFA\u8865\u5751\u6587\u6863"
  author: "\u65E5\u5E38\u95EE\u9898\u5904\u7406\u7ECF\u9A8C"
  summary: "\n\U0001F9F1 \u4FC4\u7F57\u65AF\u65B9\u5757\u2014\u2014\u8DEF\u7EBFA
    \u8865\u5751\u6587\u6863\n\n> \u5982\u679C\u4F60\u9009\u7684\u662F\u8DEF\u7EBFA\uFF08\u78B0\u649E\u4F53+\u6807\u7B7E\u6CD5\uFF09\uFF0C\u505A\u5B8C\u540E\u53D1\u73B0\u6E38\u620F\u6709\u4EE5\u4E0B\u5F02\u5E38\uFF0C\u8BF7\u5BF9\u7167\u67E5\u770B\u3002\n\n---\n\n#\n\u57511\uFF1A\u65B9\u5757\u5806\u53E0\u540E\u6C38\u8FDC\u4E0D\u4F1A\u6D88\u884C\n\n\u73B0\u8C61\uFF1A\n\xB7
    \u65B9\u5757\u4E00\u4E2A\u63A5\u4E00\u4E2A\u5F80\u4E0A\u5806\uFF0C\u8D8A\u5806\u8D8A\u9AD8\n\xB7
    \u6EE1\u884C\u540E\u6CA1\u6709\u88AB\u6E05\u9664\n\xB7 \u6E38\u620F\u5F88\u5FEB\u88AB\u5835\u6B7B\n\n\u539F\u56E0\uFF1A
    \u6EE1\u884C\u68C0\u6D4B\uFF08`CheckAndClear()`\uFF09\u6CA1\u6709\u88AB\u89E6\u53D1\u3002\n\n\u4FEE\u590D\uFF1A\n\n\u5728
    `BlockPlacer` \u7684 `PlaceBlock()` \u65B9\u6CD5\u4E2D\uFF0C\u5B8C\u6210\u7ED8\u5236\u548C\u9500\u6BC1\u540E\uFF0C\u52A0\u4E0A\u6EE1\u884C\u68C0\u6D4B\u7684\u8C03\u7528\uFF1A\n\n\nPlaceBlock(block,
    tile):\n    \u904D\u5386 block \u7684 4 \u4E2A\u5B50\u7269\u4F53\n    \u83B7\u53D6\u5B50\u7269\u4F53\u7684\u4E16\u754C\u5750\u6807
    \u2192 \u8F6C\u6210\u74E6\u7247\u5750\u6807\n    objectTilemap.SetTile(\u74E6\u7247\u5750\u6807,
    tile)  \u2192 \u7ED8\u5236\n    Destroy(block)  \u2192 \u5220\u9664\u5F53\u524D\u65B9\u5757\n   
    + \u8C03\u7528 clearManager.CheckAndClear()    \u2190 \u52A0\u4E0A\u8FD9\u4E00\u884C\n   
    \u901A\u77E5\f\u540C\u7269\u4F53\u4E0A\u7684 Spawner.OnBlockPlaced()\n\n\n> \u4F60\u8981\u786E\u4FDD
    `PlaceBlock` \u65B9\u6CD5\u80FD\u8BBF\u95EE\u5230 `clearManager`\u3002\u53EF\u4EE5\u901A\u8FC7\u4E24\u79CD\u65B9\u5F0F\uFF1A\n>
    1. \u5728 BlockPlacer \u4E2D\u4E5F\u58F0\u660E\u4E00\u4E2A `public ClearManager
    clearManager` \u53D8\u91CF\uFF0C\u5728 Inspector \u4E2D\u62D6\u5165\n> 2. \u901A\u8FC7\u540C\u7269\u4F53\u4E0A\u7684
    `GetComponent<Spawner>()` \u62FF\u5230 Spawner \u4E0A\u7684 `clearManager` \u5F15\u7528\n\n\u5B8C\u6210\u540E\uFF0C\u6EE1\u884C\u68C0\u6D4B\u4F1A\u5728\u6BCF\u6B21\u65B9\u5757\u843D\u5730\u540E\u81EA\u52A8\u6267\u884C\u3002\n\n---\n\n#\n\u57512\uFF1A\u65B9\u5757\u843D\u4E0D\u5230\u5DF2\u6709\u7684\u65B9\u5757\u4E0A\n\n\u73B0\u8C61\uFF1A\n\xB7
    \u65B9\u5757\u53EF\u4EE5\u6B63\u5E38\u78B0\u5230\u5730\u9762\u505C\u6B62\u5E76\u653E\u7F6E\n\xB7
    \u4F46\u5F53\u65B9\u5757\u843D\u5230\u4E4B\u524D\u5DF2\u7ECF\u753B\u597D\u7684\u65B9\u5757\u4E0A\u65F6\uFF0C\u76F4\u63A5\u7A7F\u8FC7\u53BB\uFF0C\u4E0D\u505C\u4E0B\u6765\n\n\u539F\u56E0\uFF1A
    `OnCollisionEnter2D` \u4E2D\u53EA\u5224\u65AD\u4E86 Tag \u4E3A \"Ground\" \u548C
    \"Wall\" \u7684\u78B0\u649E\u3002ObjectTilemap \u4E0A\u7684\u5DF2\u6709\u65B9\u5757\u6CA1\u6709\f
    Tag\uFF0C\u6240\u4EE5\u78B0\u649E\u88AB\u5FFD\u7565\u4E86\u3002\n\n\u4FEE\u590D\u65B9\u6848\uFF08\u4EFB\u9009\u5176\u4E00\uFF09\uFF1A\n\n##\n\u65B9\u6848A\uFF1A\u7ED9
    ObjectTilemap \u52A0 Tag\n\n1. \u5728 Inspector \u9876\u90E8 Tag \u4E0B\u62C9\u83DC\u5355
    \u2192 `Add Tag...` \u2192 \u65B0\u5EFA\u4E00\u4E2A `BlockTile` \u6807\u7B7E\n2.
    \u9009\u4E2D ObjectTilemap \u2192 Tag \u2192 \u9009\u62E9 `BlockTile`\n3. \u5728
    Spawner \u7684 `OnCollisionEnter2D` \u4E2D\u589E\u52A0\u5224\u65AD\uFF1A\n\n\nOnCollisionEnter2D(Collision2D
    collision):\n    if collision.gameObject.CompareTag(\"Ground\") \u2192 \u78B0\u5230\u5730\u9762\uFF0C\u653E\u7F6E\n   
    if collision.gameObject.CompareTag(\"Wall\") \u2192 \u78B0\u5230\u5899\u58C1\uFF0C\u653E\u7F6E\n   
    if collision.gameObject.CompareTag(\"Block\fTile\") \u2192 \u78B0\u5230\u5DF2\u6709\u65B9\u5757\uFF0C\u653E\u7F6E\n\n\n##\n\u65B9\u6848B\uFF1A\u4E0D\u5224\u65AD
    Tag\uFF0C\u53EA\u8981\u78B0\u5230 Tilemap \u5C31\u653E\u7F6E\n\n\u5728 `OnCollisionEnter2D`
    \u4E2D\uFF0C\u4E0D\u901A\u8FC7 Tag \u533A\u5206\uFF0C\u76F4\u63A5\u68C0\u67E5\u78B0\u649E\u4F53\u7684\u7EC4\u4EF6\uFF1A\n\n\nOnCollisionEnter2D(Collision2D
    collision):\n    if collision.gameObject.GetComponent<Tilemap>() != null:\n       
    \u2192 \u4E0D\u7BA1\u5B83\u662F Ground/Wall/Object\uFF0C\u4E00\u5F8B\u89E6\u53D1\u653E\u7F6E\n\n\n\u8FD9\u6837\u53EA\u8981\u65B9\u5757\u78B0\u5230\u4E86\u4EFB\u610F
    Tilemap\uFF08\u5730\u9762/\u5899\u58C1/\u5DF2\u6709\u65B9\u5757\uFF09\uFF0C\u90FD\u4F1A\u89E6\u53D1
    `BlockPlacer.PlaceBlock()`\u3002\n\n---\n\n#\n\u57513\uFF1A\u6309 A/D \u79FB\u52A8\u540E\uFF0C\u78B0\u649E\u68C0\u6D4B\u5931\u6548\n\n\u73B0\u8C61\uFF1A\n\xB7
    \u65B9\u5757\u751F\u6210\u540E\u4E0D\u52A8\uFF0C\u6216\u8005\u6309 A/D \u79FB\u52A8\u540E\uFF0C\u65B9\u5757\u4E0D\u518D\u54CD\u5E94\u78B0\u649E\n\xB7
    \u65B9\u5757\u76F4\u63A5\u7A7F\u8FC7\u5730\u9762\u6389\u51FA\u89C6\u91CE\n\n\u539F\u56E0\uFF1A
    \u4F60\u7528 `transform.position` \u76F4\f\u63A5\u8D4B\u503C\u6765\u79FB\u52A8\u65B9\u5757\u3002\n\n\u5728
    Unity \u4E2D\uFF1A\n\xB7 `transform.position += ...` \u2192 \u4E0D\u4F1A\u89E6\u53D1
    `OnCollisionEnter2D`\n\xB7 `Rigidbody2D.MovePosition(...)` \u2192 \u4F1A\u89E6\u53D1
    `OnCollisionEnter2D`\n\xB7 `Rigidbody2D.velocity = ...` \u2192 \u4F1A\u89E6\u53D1
    `OnCollisionEnter2D`\n\n\u56E0\u4E3A\u8DEF\u7EBFA \u7684\u78B0\u649E\u4F9D\u8D56
    `OnCollisionEnter2D` \u81EA\u52A8\u56DE\u8C03\uFF0C\u7528 `transform.position`
    \u8D4B\u503C\u79FB\u52A8\u7B49\u4E8E\u7ED5\u8FC7\u4E86\u7269\u7406\u7CFB\u7EDF\uFF0C\u78B0\u649E\u81EA\u7136\u5C31\u4E0D\u4F1A\u89E6\u53D1\u4E86\u3002\n\n\u4FEE\u590D\uFF1A
    \u628A\u79FB\u52A8\u65B9\u5F0F\u6539\u4E3A\u4F7F\u7528 `Rigidbody2D` \u7684\u65B9\u6CD5\uFF1A\n\n\n//
    \u83B7\u53D6\u65B9\u5757\u7684 Rigidbody2D \u7EC4\u4EF6\nRigidbody2D rb = currentBlock.GetComponent<Rigidbody2D>();\n\n//
    \u5DE6\u79FB\uFF1A\nrb\f.MovePosition(rb.position + Vector2.left);\n\n// \u53F3\u79FB\uFF1A\nrb.MovePosition(rb.position
    + Vector2.right);\n\n\n> \u65CB\u8F6C\u4E5F\u8981\u6CE8\u610F\uFF1A`transform.Rotate()`
    \u4E0D\u4F1A\u89E6\u53D1\u78B0\u649E\uFF0C\u4F46\u65CB\u8F6C\u672C\u8EAB\u4E0D\u4F9D\u8D56\u78B0\u649E\u56DE\u8C03\u3002\u65CB\u8F6C\u540E\u5B50\u7269\u4F53\u4F4D\u7F6E\u53D8\u4E86\uFF0C\u518D\u6B21\u79FB\u52A8\u65F6
    `MovePosition` \u4F1A\u57FA\u4E8E\u65CB\u8F6C\u540E\u7684\u65B0\u4F4D\u7F6E\u79FB\u52A8\u3002\n\n---\n\n#\n\u603B\u7ED3\uFF1A\u4E09\u79CD\u5F02\u5E38
    vs \u4FEE\u590D\u5BF9\u7167\n\n| \u73B0\u8C61 | \u539F\u56E0 | \u4FEE\u590D |\n|------|------|------|\n|
    \u65B9\u5757\u5806\u53E0\u4E0D\u6D88\u884C | `CheckAndClear()` \u6CA1\u88AB\u8C03\u7528
    | \u5728 `PlaceBlock` \u672B\u5C3E\u52A0\u8C03\u7528 |\n| \u65B9\u5757\u7A7F\u6A21\u4E0D\u843D\u5730
    | ObjectTilemap \u65E0 Tag \u5224\u65AD | \u52A0 Tag \u6216\u4E0D\u5224\u65AD\u76F4\u63A5\u89E6\u53D1
    |\n| \u79FB\u52A8\u540E\u78B0\u649E\u5931\u6548 | \u7528\u4E86 `transform.position`
