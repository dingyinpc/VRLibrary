    \u653E\f Boss \u4F4D\u7F6E / Follow \u6307 Boss\uFF09\uFF1BBrain \u53EA\u8D1F\u8D23\u642C\u8FD0\u3002\u5206\u5DE5
    = vcam \u5B9A\u4F4D+\u653E\u5927\uFF0CBrain \u642C\u8FD0\u3002\n\nQ2 \u4F60\u7684\u56DE\u7B54\uFF1A\u6682\u65F6\u60F3\u6CD5\u662F\u4E00\u4E2A
    vcam \u5C31\u591F\uFF08\u5168\u666F\u4E3B\u76F8\u673A\u8D1F\u8D23\uFF0C\u8FD1\u666F
    vcam \u7279\u5199\uFF09\uFF1B\u5982\u679C\u8981\u4E24\u4E2A vcam\uFF0C\u9700\u8981\u534F\u7A0B\u5B9A\u65F6
    2 \u79D2 + \u6444\u50CF\u673A\u9707\u52A8\uFF1B\u8BA4\u540C\"Brain \u6BCF\u5E27\u9009\u8C01\"\u770B\u67D0\u4E2A\u503C\u7684\u63D0\u793A\uFF1B\u62C9\u56DE\u5168\u666F\uFF1A\u5B9A\u4F4D
    2.x \u79D2\uFF0C\u62C9\u56DE\u8FC7\u7A0B\u4E2D\u7528\"\u52A8\u6001\u6A21\u7CCA\"\uFF0C\u5982\u679C\u8FD9\u6837\u53EF\u80FD\u8981\u7528\u4E24\u4E2A
    vcam \u5E76\u901A\u8FC7 Brain \u7684\u6444\u50CF\u673A\u9009\u62E9\u63A7\u5236\u3002\n\n\u2714\uFE0F
    \u70B9\u8BC4\uFF1A\n\xB7 \u4F60\u63A8\u7406\u51FA\"\u4E24\u4E2A vcam \u2192 \u5B9A\u65F6
    \u2192 Brain \u9009\u8C01\uFF08\u4F18\u5148\u7EA7\uFF09\"\u7684\u94FE\u8DEF\u2014\u2014\u5B8C\u5168\u6B63\u786E\uFF0C\u8FD9\u5C31\u662F
    Cinemachine \u6807\u51C6\u73A9\u6CD5\u3002\n\n\u274C \u7EA0\u6B63\uFF08\u6982\u5FF5\uFF09\uFF1A\n\xB7
    \"\u52A8\u6001\u6A21\u7CCA\" \u2260 \u8FC7\u6E21\u3002Cinemachine \u91CC\u4EA4\u63A5\u8FC7\u6E21\u53EB
    Blend\uFF08\u6DF7\u5408\uFF09\uFF0C\u662F Brain \u5185\u7F6E\u7684\uFF0C\u5207\u6362\u65F6\u81EA\u52A8\u5E73\u6ED1\u6ED1\u52A8\uFF0C\u4E0D\u9700\u8981\u4E5F\u4E0D\u80FD\u624B\u5199\u8FC7\u6E21\u4EE3\u7801\u3002\n\xB7
    \u65B9\u6848\u53EF\u5927\u5E45\u7B80\u5316\uFF1A\u53EA\u9700\u2460\u7279\u5199
    vca\fm \u63A5\u7BA1\uFF08Priority \u63D0\u9AD8\uFF09\u2461\u505C\u7559 2 \u79D2
    \u2462\u7279\u5199 vcam \u8BA9\u6743\uFF08Priority \u964D\u56DE 0\uFF09\uFF0CBrain
    \u81EA\u52A8\u5B8C\u6210\u62C9\u8FD1/\u62C9\u56DE\u6DF7\u5408\u3002\n\xB7 1 \u4E2A
    vcam \u591F\u4E0D\u591F\uFF1A\u7406\u8BBA\u591F\uFF0C\u4F46\u4F53\u9A8C\u4E0E\u4EE3\u7801\u91CF\u4E0D\u5982
    2 \u4E2A vcam + Priority \u5207\u6362\u5E72\u51C0\u2014\u20142 \u4E2A vcam \u662F\u66F4\u7B26\u5408\u5F15\u64CE\u8BBE\u8BA1\u7684\u505A\u6CD5\u3002\n\nQ3
    \u4F60\u7684\u56DE\u7B54\uFF1A\u4EE3\u7801\u90E8\u5206\u4E0D\u6E05\u695A\uFF08\u6CA1\u63A5\u89E6\u8FC7\u7EC4\u4EF6\uFF09\uFF1B\u65F6\u95F4\u8F74\u503E\u5411\u534F\u7A0B\uFF0CDotween
    \u6CA1\u63A5\u89E6\u8FC7\u3001\u4E0D\u786E\u5B9A\u662F\u5426\u53EF\u884C\u3002\n\n\u2714\uFE0F
    \u70B9\u8BC4\uFF1ADOTween 100% \u53EF\u884C\u2014\u2014\u9879\u76EE `Assets/Plugins/Demigiant`
    \u5DF2\u88C5\uFF0C`UIAnim.cs`/`TowerPlacement.cs` \u5DF2\u5728\u7528\uFF08`DG.Tweening`\uFF09\uFF0C`AppendInterval`
    = \u7B49 2 \u79D2\uFF0C\u65E0\u9700\u5B66\u65B0\u4E1C\u897F\u3002\n\n\u53C2\u8003\u4EE3\u7801\uFF08\u65B9\u6848
    A \u534F\u7A0B / \u65B9\u6848 B DOTween\uFF0C\u5747\u53EF\u7528\uFF09\uFF1A\ncsharp\n//
    \u65B9\u6848 A\uFF1A\u534F\u7A0B\uFF08WaveManager \f\u5185\uFF0CBoss \u6CE2\u51FA\u73B0\u65F6
    StartCoroutine\uFF09\nIEnumerator BossZoomRoutine(Vector3 bossPos)\n{\n    var
    zoomGo = GameObject.Find(\"CM vcam (BossZoom)\");\n    var zoom = zoomGo.GetComponent<CinemachineVirtualCamera>();\n   
    zoom.transform.position = bossPos;    // \u2460 \u5B9A\u4F4D\uFF1Avcam \u653E\u5230
    Boss \u8EAB\u4E0A\n    zoom.m_Lens.OrthographicSize = 4.5f;  // \u2461 \u653E\u5927\uFF1A8.5
    \u2192 4.5\n    zoom.Priority = 20;                   // \u2462 \u63A5\u7BA1\uFF1ABrain
    \u5F00\u59CB\u62C9\u8FD1\uFF08\u7EA60.5s\u6DF7\u5408\uFF09\n    yield return
    \fnew WaitForSeconds(2.5f); // \u2463 \u505C\u75592\u79D2 + \u6DF7\u5408\u65F6\u95F4\n   
    zoom.Priority = 0;                    // \u2464 \u8BA9\u6743\uFF1ABrain \u81EA\u52A8\u62C9\u56DE\u5168\u666F\n}\n\n//
    \u65B9\u6848 B\uFF1ADOTween\uFF08\u66F4\u8D34\u5408\u9879\u76EE\u73B0\u6709\u98CE\u683C\uFF09\nvar
    zoom = /* \u7279\u5199 vcam\uFF0C\u540C\u4E0A */;\nzoom.transform.position =
    bossPos;\nzoom.m_Lens.OrthographicSize = 4.5f;\nzoom.Priority = 20;                                 
    // \u63A5\u7BA1\uFF0C0.5s \u6DF7\u5408\u62C9\u8FD1\nDOTween.Sequence()\n    .AppendInterval(2f)                            
    // \u505C\u7559 2 \u79D2\n    .AppendCallback(() =\f> zoom.Priority = 0);     
    // \u8BA9\u6743\uFF0CBrain 0.5s \u6DF7\u5408\u62C9\u56DE\n\n\n3 \u4E2A\u5173\u952E\u53C2\u6570\uFF1A`Position`\uFF08vcm
    \u653E Boss\uFF09\xB7 `OrthographicSize`\uFF088.5\u21924.5 \u62C9\u8FD1\uFF09\xB7
    `Priority`\uFF0820>10 \u63A5\u7BA1\uFF0C0 \u8BA9\u6743\uFF09\u3002\n\u6DF7\u5408\u5FEB\u6162\u5728
    Main Camera \u7684 CinemachineBrain \u2192 Default Blend\uFF08\u7EA6 2s\uFF0C\u6539
    0.5 \u5373\u5FEB\uFF09\u3002\n\n##\n9.4 \u6211\u63D0\u51FA\u7684\u6700\u7EC8\u95EE\u9898\uFF08\u4F60\u5DF2\u7B54\u5BF9\uFF09\n\n\xB7
    \u95EE\u9898\uFF1A\u7279\u5199 vcam \u63A5\u7BA1\u65F6\uFF0C\u5168\u666F vcam
    \u8FD8\u5728\u8DD1\u5417\uFF1F\u4E24\u4E2A vcam \u540C\u65F6\u8BF4\"\u6211\u662F\u8001\u5927\"\uFF0CBrain
    \u51ED\u4EC0\u4E48\u4E0D\u6253\u67B6\uFF1F\n\xB7 \u4F60\u7684\u4F5C\u7B54\uFF1A\"\u53EF\u80FD\u662F
    BRAIN \u91CC\u7684\u6444\u50CF\u673A\u9009\u62E9\u65B9\u9762\u2026\u2026\u901A\u8FC7\u4EE3\u7801\u63A7\u5236\uFF0C\u89E6\u53D1\u67D0\u4E9B\u884C\u4E3A\uFF08\u5982
    Boss \u767B\u573A\uFF09\u5C31\u542F\u7528\u7279\u5199 vcam\uFF0C\u7528\u534F\u7A0B\u63A7\u5236
    2 \u79D2\u540E\u89E6\u53D1\u4E0B\u4E00\u903B\u8F91\uFF0C\u56DE\u5230\u5168\u666F
    vcam\u3002\"\n\xB7 \u2714\uFE0F \u70B9\u8BC4\uFF1A\u7B54\u5BF9\uFF0C\u6BD5\u4E1A\uFF01
    \u8FD9\u5C31\u662F `P\friority` \u673A\u5236 + \u4E8B\u4EF6\u89E6\u53D1 + \u534F\u7A0B\u5B9A\u65F6\u7684\u6807\u51C6\u505A\u6CD5\uFF1A\n 
    1. \u89E6\u53D1\u70B9\uFF1ABoss \u767B\u573A\uFF08\u4E8B\u4EF6\u65F6\u673A\uFF09\n 
    2. \u63A7\u5236\u624B\u6BB5\uFF1A`Priority`\uFF08Brain \u4EF2\u88C1\u4F9D\u636E\uFF09\n 
    3. \u65F6\u5E8F\uFF1A\u534F\u7A0B `WaitForSeconds(2)`\uFF082 \u79D2\u540E\u89E6\u8FBE\u4E0B\u4E00\u903B\u8F91\uFF09\n 
    \xB7 Brain \u9009 Priority \u6700\u9AD8\u8005\uFF0C\u6570\u5927\u8005\u4E3A\u738B\uFF0C\u6C38\u4E0D\u6253\u67B6\u2014\u2014\u8FD9\u662F\u5F15\u64CE\u7684\u4EF2\u88C1\u89C4\u5219\uFF0C\u4E0D\u9700\u8981\u4F60\u5199
    if-else\u3002\n\n##\n9.5 \u8FC7\u6E21\u65F6\u673A\u7EA0\u9519\uFF08\u6700\u540E\u4E00\u8BFE\uFF09\n\n\xB7
    \u4F60\u7684\u95EE\u9898\uFF1A\"2 \u79D2\u534F\u7A0B\uFF0C\u5728 1.5 \u79D2\u65F6\u5C31\u4F1A\u56DE\u5230\u4E0B\u4E00\u76F8\u673A\uFF0C\u90A3
    0.5 \u79D2\u5C31\u662F\u5E73\u6ED1\u8FC7\u6E21\u7684\u89E6\u53D1\u65F6\u673A\uFF0C\u662F\u8FD9\u6837\u5417\uFF1F\"\n\xB7
    \u7EA0\u6B63\uFF1A\u8FC7\u6E21\u4E0D\u662F\"\u63D0\u524D 0.5 \u79D2\u89E6\u53D1\"\uFF0C\u800C\u662F\"\u5207\u6362\u7684\u90A3\u4E00\u5E27\u624D\u5F00\u59CB\"\uFF1A\n 
    \n  \u534F\u7A0B\u79D2\u6570\u5230\u4E86 \u2500\u2500\u25BA \u4F60\u6539 Priority\uFF08\u8FD9\u4E00\u5E27\uFF1D\u5207\u6362\u77AC\u95F4\uFF09\u2500\u2500\u25BA
    Brain \u624D\u5F00\u59CB 0.5s \u6DF7\u5408\n  \n  \u6DF7\u5408\u65F6\u957F\u7531
    Brain \u7684 `Default Blend` \u51B3\u5B9A\uFF1B\u5207\u6362\u52A8\u4F5C\u7531
    Pr\fiority \u53D8\u5316\u89E6\u53D1\u3002\u987A\u5E8F\u662F\"\u5207\u2192\u6DF7\"\uFF0C\u4E0D\u662F\"\u9884\u7559\u2192\u5207\"\u3002\n\xB7
    \u65F6\u95F4\u7B97\u6CD5\uFF08\u4E24\u79CD\u5199\u6CD5\u5BF9\u5E94\u4E24\u79CD\u6548\u679C\uFF09\uFF1A\n 
    | \u60F3\u8981\u7684\u6548\u679C | \u534F\u7A0B\u5199\u51E0\u79D2 | \u5B9E\u9645\u65F6\u95F4\u7EBF
    |\n  |---|---|---|\n  | \u7279\u5199\u5B8C\u6574\u770B\u5230 2 \u79D2\uFF0C\u7136\u540E\u5F00\u59CB\u62C9\u56DE
    | `WaitForSeconds(2)` | 2s \u7A33\u5B9A \u2192 \u6539 Priority \u2192 0.5s \u62C9\u56DE\uFF08\u5171
    2.5s \u56DE\u5168\u666F\uFF09 |\n  | \u7279\u5199\u5C55\u793A\u5171 2 \u79D2\uFF08\u542B\u8FC7\u6E21\uFF09
    | `WaitForSeconds(1.5)` | 1.5s \u7A33\u5B9A \u2192 \u6539 Priority \u2192 0.5s
    \u8FC7\u6E21 \u2192 \u6B63\u597D 2s \u56DE\u5168\u666F |\n  \xB7 \u4F60\u7684\"1.5
    + 0.5 = 2\"\u5728\u7B2C\u4E8C\u79CD\u5199\u6CD5\u91CC\u6210\u7ACB\u2014\u2014\u4F46\u90A3
    0.5 \u79D2\u662F\u5207\u6362\u4E4B\u540E\u82B1\u6389\u7684\uFF0C\u4E0D\u662F\u5207\u6362\u4E4B\u524D\u9884\u7559\u7684\u3002\u4F60\u8499\u5BF9\u4E86\"\u8981\u9884\u7559\u8FC7\u6E21\u65F6\u95F4\"\u7684\u65B9\u5411\uFF0C\u53EA\u662F\u628A\u56E0\u679C\u987A\u5E8F\u60F3\u53CD\u4E86\u3002\n\n---\n\n*\u6587\u6863\u751F\u6210\u65F6\u95F4\uFF1A\u4E0E
    M1.5 v2.0 \u65B9\u6848\u540C\u76EE\u5F55\u3002\u4FEE\u6539\u4EE3\u7801\u540E\u8BF7\u6309
    \xA75 \u9A8C\u6536\u3002*"
  slotCode: A1-1-01
