    7 \u79CD\u6807\u51C6\u5F62\u72B6\uFF0C\u6BCF\u4E2A\u7531 4 \u4E2A\u5C0F\u65B9\u5757\u7EC4\u6210\uFF1A\n\n>
    [\u5728\u6B64\u5904\u63D2\u5165\u622A\u56FE\uFF1A\u4E03\u79CD\u5F62\u72B6\u7684\u793A\u610F\u56FE\uFF0C\u6807\u6CE8\u540D\u79F0\u7F29\u5199]\n\n|
    \u540D\u79F0 | \u5F62\u72B6\uFF08\u4FEF\u89C6\u56FE\uFF09 | \u8BF4\u660E |\n|------|--------------|------|\n|
    I \u5F62 | \u2588\u2588\u2588\u2588 | \u4E00\u6761\u76F4\u7EBF\uFF0C4 \u4E2A\u4E00\u6392
    |\n| O \u5F62 | \u2588\u2588<br>\u2588\u2588 | 2\xD72 \u6B63\u65B9\u5F62 |\n|
    T \u5F62 | \u2588\u2588\u2588<br> \u2588 | \u4E0A\u9762\u4E09\u4E2A\u4E0B\u9762\u4E2D\u95F4\u4E00\u4E2A
    |\n| L \u5F62 | \u2588\u2588<br> \f\u2588<br> \u2588 | \u7AD6\u7740\u7684 L \u5F62
    |\n| J \u5F62 | \u2588\u2588<br> \u2588<br> \u2588 | L \u5F62\u955C\u50CF |\n|
    S \u5F62 | \u2588\u2588<br> \u2588\u2588 | \u50CF\u86C7\u4E00\u6837\u5F2F\u66F2
    |\n| Z \u5F62 | \u2588\u2588<br> \u2588\u2588 | S \u5F62\u955C\u50CF |\n\n\u5236\u4F5C\u6B65\u9AA4\uFF08\u4EE5
    I \u5F62\u4E3A\u4F8B\uFF09\uFF1A\n\n1. \u521B\u5EFA\u4E00\u4E2A\u7A7A\u7269\u4F53\uFF0C\u547D\u540D\u4E3A
    \"I\"\n   \xB7 Hierarchy \u53F3\u952E \u2192 `Create Empty`\n\n2. \u6DFB\u52A0
    4 \u4E2A\u5B50\u7269\u4F53\uFF0C\u6BCF\u4E2A\u5B50\u7269\u4F53\u662F\u4E00\u4E2A\u5C0F\u65B9\u5757\n  
    \xB7 \u5728 \"I\" \u4E0A\u53F3\u952E \u2192 `Create Empty` \u2192 \u547D\u540D
    \"Block1\"\n   \xB7 \u91CD\u590D 4 \u6B21\n\n3. \u7ED9\u6BCF\u4E2A\u5C0F\u65B9\u5757\u52A0
    SpriteRenderer\n   \xB7 \u9009\u4E2D Block1 \u2192 Inspector \u2192 `Add Component`
    \u2192 \u641C\u7D22 `SpriteRenderer`\n   \xB7 > [\u5728\u6B64\u5904\u63D2\u5165\u622A\u56FE\uFF1A\u6DFB\u52A0
    SpriteRenderer \u7684\u4F4D\u7F6E]\n\n4. \u7ED9\u6BCF\u4E2A\u5C0F\u65B9\u5757\u52A0
    Sprite\n  \f \xB7 \u5728 Project \u4E2D\u627E\u5230\u51C6\u5907\u597D\u7684\u5C0F\u65B9\u5757\u56FE\u7247\n  
    \xB7 \u62D6\u5165 SpriteRenderer \u7684 `Sprite` \u69FD\n   \xB7 > [\u5728\u6B64\u5904\u63D2\u5165\u622A\u56FE\uFF1A\u5C06\u56FE\u7247\u62D6\u5165
    Sprite \u69FD]\n\n5. \u6392\u5217\u6210\u76F4\u7EBF\n   \xB7 \u5728 Inspector
    \u4E2D\u8BBE\u7F6E\u6BCF\u4E2A\u5B50\u7269\u4F53\u7684 Position\uFF1A\n     \xB7
    Block1: (0, 0, 0)\n     \xB7 Block2: (-1, 0, 0)\n     \xB7 Block3: (1, 0, 0)\n    
    \xB7 Block4: (2, 0, 0)\n   \xB7 > [\u5728\u6B64\u5904\u63D2\u5165\u622A\u56FE\uFF1A\u8BBE\u7F6E
    Position \u7684\u4F4D\u7F6E]\n\n6. \u7ED9\u7236\u7269\u4F53\u52A0 Collider2D\n  
    \xB7 \u9009\u4E2D \"I\" \u2192 `Add Component` \u2192 \u641C\u7D22 `BoxCollider2D`\n  
    \xB7 \u662F\u5426\u7ED9\u5B50\u7269\u4F53\u52A0 BoxCollider2D\uFF0C\u53D6\u51B3\u4E8E\u4F60\u9009\u62E9\u7684\u8DEF\u7EBF\uFF08\u89C1\u7B2C\u56DB\u90E8\u5206\uFF09\n\n7.
    \u7ED9\u7236\u7269\u4F53\u52A0 Rigidbody2D\n   \xB7\f `Add Component` \u2192
    `Rigidbody2D`\n   \xB7 \u5173\u952E\u8BBE\u7F6E\uFF08\u9632\u6B62\u7269\u7406\u51B2\u7A81\uFF09\uFF1A\n    
    \xB7 `BodyType` = `Kinematic`\uFF08\u8FD0\u52A8\u5B66\u6A21\u5F0F\uFF0C\u4E0D\u53D7\u91CD\u529B\u5F71\u54CD\uFF09\n    
    \xB7 `Gravity Scale` = `0`\uFF08\u4E0D\u9700\u8981\u91CD\u529B\uFF0C\u65B9\u5757\u9760\u4EE3\u7801\u7684\u5B9A\u65F6\u5668\u4E0B\u843D\uFF09\n    
    \xB7 `Constraints` \u2192 \u52FE\u9009 `Freeze Rotation Z`\uFF08\u9632\u6B62\u65CB\u8F6C\u65F6\u7FFB\u5012\uFF09\n  
    \xB7 > [\u5728\u6B64\u5904\u63D2\u5165\u622A\u56FE\uFF1ARigidbody2D \u7EC4\u4EF6\u8BBE\u7F6E\uFF0CBodyType=Kinematic,
    Gravity Scale=0, Freeze Rotation Z]\n\n8. \u62D6\u5165 Project \u7A97\u53E3\u53D8\u6210\u9884\u5236\u4F53\n  
    \xB7 \u628A Hierarchy \u4E2D\u7684 \"I\" \u62D6\u5230 Project \u7A97\u53E3\n  
    \xB7 \u51FA\u73B0\u84DD\u8272\u65B9\u5757\u56FE\u6807 \u2192 \u9884\u5236\u4F53\u5B8C\u6210\n\n9.
    \u91CD\u590D 1-8 \u6B65\u5B8C\u6210\u5176\u4ED6 6 \u79CD\u5F62\u72B6\n\n> [\u5728\u6B64\u5904\u63D2\u5165\u622A\u56FE\uFF1AProje\fct
    \u7A97\u53E3\u4E2D 7 \u4E2A\u9884\u5236\u4F53\u84DD\u8272\u56FE\u6807\u7684\u5217\u8868]\n\n\u6CE8\u610F\uFF1A
    \u4E0D\u540C\u5F62\u72B6\u7684\u65B9\u5757\uFF0C\u5B50\u7269\u4F53\u7684 Position
    \u6392\u5217\u4E0D\u540C\u3002\u5EFA\u8BAE\u5728 Scene \u89C6\u56FE\u4E2D\u76F4\u63A5\u62D6\u62FD\u8C03\u6574\u4F4D\u7F6E\uFF0C\u66F4\u76F4\u89C2\u3002\n\n---\n\n\n\u7B2C\u4E09\u90E8\u5206\uFF1A\u573A\u666F\u8F6C\u6362\uFF08\u7B2C\u4E00\u90E8\u5206\uFF09\n\n#\n3.1
    \u4EC0\u4E48\u662F\u573A\u666F\u8F6C\u6362\n\n\u573A\u666F\u8F6C\u6362\u5C31\u662F\u4ECE\u5F53\u524D\u753B\u9762\u8DF3\u8F6C\u5230\u53E6\u4E00\u4E2A\u753B\u9762\u3002\u6BD4\u5982\uFF1A\n\xB7
    \u5728 Start \u573A\u666F\u70B9\"\u5F00\u59CB\" \u2192 \u8DF3\u8F6C\u5230 Game
    \u573A\u666F\n\xB7 \u6E38\u620F\u7ED3\u675F \u2192 \u663E\u793A Panel \u2192
    \u70B9\"\u91CD\u65B0\u6E38\u73A9\" \u2192 \u91CD\u65B0\u52A0\u8F7D Game \u573A\u666F\n\xB7
    \u70B9\"\u9000\u51FA\" \u2192 \u8DF3\u8F6C\u5230 Exit \u573A\u666F\n\n#\n3.2
    Button \u7EC4\u4EF6\u8BE6\u89E3\n\nButton \u662F Unity \u7684 UI \u7EC4\u4EF6\uFF0C\u7528\u4E8E\u54CD\u5E94\u7528\u6237\u70B9\u51FB\u3002\n\n\u521B\u5EFA\u65B9\u6CD5\uFF1A 
    \n`Hierarchy \u53F3\u952E` \u2192 `UI` \u2192 `Button`\uFF08\u4F1A\u81EA\u52A8\u521B\u5EFA
    Canvas \u548C EventSystem\uFF09\n\nButton \u7684 Inspector \u7ED3\u6784\uFF1A\n\n>
    [\u5728\u6B64\u5904\u63D2\u5165\u622A\u56FE\uFF1AButton \u7684 Inspector \u5168\u8C8C\uFF0C\u6807\u6CE8\u5173\u952E\u4F4D\f\u7F6E]\n\n\nButton
    (GameObject)\n\u251C\u2500\u2500 Transform (\u4F4D\u7F6E/\u5927\u5C0F)\n\u251C\u2500\u2500
    Canvas Renderer (\u6E32\u67D3)\n\u251C\u2500\u2500 Image (\u80CC\u666F\u56FE\u7247)\n\u2502  
    \u251C\u2500\u2500 Source Image (\u80CC\u666F\u56FE)\n\u2502   \u2514\u2500\u2500
    Color (\u80CC\u666F\u989C\u8272)\n\u2514\u2500\u2500 Button (\u811A\u672C\u7EC4\u4EF6)\n   
    \u251C\u2500\u2500 Interactable (\u2714 \u52FE\u9009\u8868\u793A\u53EF\u7528)\n   
    \u251C\u2500\u2500 Transition (\u8FC7\u6E21\u6548\u679C)\n    \u2502   \u251C\u2500\u2500
    Color Tint (\u989C\u8272\u53D8\u5316)\n    \u2502   \u2514\u2500\u2500 Target
    Graphic (\u76EE\u6807\u56FE\u7247)\n    \u2514\u2500\u2500 OnClick() \u2190 \u6700\u91CD\u8981\u7684\u5730\u65B9\uFF01\n       
    \u251C\u2500\u2500 + (\u6DFB\u52A0\u4E8B\u4EF6)\n        \u251C\u2500\u2500 \u62D6\u5165\u5BF9\u8C61
    (\u6709\u811A\u672C\u7684\u7269\u4F53)\n        \u2514\u2500\u2500 \u9009\u62E9\u65B9\u6CD5
    (\u8981\u8C03\u7528\u7684\u51FD\u6570)\n\n\n##\nButton \u7684\u6838\u5FC3\u5C5E\u6027\n\n|
    \u5C5E\u6027 | \u8BF4\u660E |\n|------|------|\f\n| Interactable | \u6253\u52FE\u8868\u793A\u6309\u94AE\u53EF\u7528\uFF0C\u4E0D\u6253\u52FE\u6309\u94AE\u7070\u8272\u4E0D\u53EF\u70B9\u51FB
    |\n| Transition | \u6309\u94AE\u6548\u679C\uFF0C\u9009 Color Tint \u5C31\u662F\u9F20\u6807\u653E\u4E0A\u53BB\u53D8\u989C\u8272
    |\n| OnClick() | \u70B9\u51FB\u6309\u94AE\u65F6\u6267\u884C\u7684\u64CD\u4F5C\u5217\u8868
    |\n\n##\nOnClick() \u4E8B\u4EF6\u7684\u8BBE\u7F6E\u6B65\u9AA4\n\n\u8FD9\u662F
    Button \u6700\u6838\u5FC3\u7684\u90E8\u5206\uFF0C\u8BF7\u4E25\u683C\u6309\u7167\u4EE5\u4E0B\u6B65\u9AA4\u64CD\u4F5C\uFF1A\n\n1.
    \u70B9\u51FB OnClick() \u4E0B\u65B9\u7684 `+` \u6309\u94AE\n   > [\u5728\u6B64\u5904\u63D2\u5165\u622A\u56FE\uFF1A\u70B9\u51FB
    + \u53F7\u7684\u4F4D\u7F6E]\n\n2. \u4ECE Hierarchy \u4E2D\u62D6\u5165\u4E00\u4E2A\u6302\u8F7D\u4E86\u811A\u672C\u7684
    GameObject\n   > [\u5728\u6B64\u5904\u63D2\u5165\u622A\u56FE\uFF1A\u62D6\u5165\u5BF9\u8C61\u7684\u64CD\u4F5C]\n\n3.
    \u5728\u53F3\u4FA7\u4E0B\u62C9\u83DC\u5355\u9009\u62E9\u811A\u672C\u540D\u79F0
    \u2192 \u518D\u9009\u62E9\u811A\u672C\u4E2D\u7684 \u516C\u5F00\u65B9\u6CD5\uFF08public
    \u65B9\u6CD5\uFF09\n   > [\u6B64\u5904\u63D2\u5165\u622A\u56FE\uFF1A\u9009\u62E9\u65B9\u6CD5\u7684\u83DC\u5355]\n\n\u8BF7\u8BB0\u4F4F\uFF1A
    \u53EA\u6709 `public` \u7684\u65B9\u6CD5\u624D\u4F1A\u51FA\u73B0\u5728\u8FD9\u4E2A\u83DC\u5355\u4E2D\uFF01\n\n#\n3.3
    \u573A\u666F\u5207\u6362\u811A\u672C\u2014\u2014SceneSwitcher\n\n\u9700\u8981\u521B\u5EFA\u7684\u811A\u672C\u6587\u4EF6\uFF1A
    \f\u4E00\u4E2A\u540D\u4E3A `SceneSwitcher` \u7684 C\n\u811A\u672C\n\n\u9700\u8981\u5199\u7684\u65B9\u6CD5\uFF08\u544A\u8BC9\u540C\u5B66\u65B9\u6CD5\u540D\u548C\u529F\u80FD\u5373\u53EF\uFF09\uFF1A\n\n|
    \u8981\u5199\u7684\u65B9\u6CD5 | \u529F\u80FD |\n|-----------|------|\n| `GoToGame()`
    | \u8C03\u7528 `SceneManager.LoadScene(\"Game\")` \u52A0\u8F7D\u6E38\u620F\u573A\u666F
    |\n| `GoToStart()` | \u8C03\u7528 `SceneManager.LoadScene(\"Start\")` \u52A0\u8F7D\u5F00\u59CB\u573A\u666F
    |\n| `GoToExit()` | \u8C03\u7528 `SceneManager.LoadScene(\"Exit\")` \u52A0\u8F7D\u7ED3\u675F\u573A\u666F
    |\n\n\u9700\u8981\u5F15\u7528\u7684\u547D\u540D\u7A7A\u95F4\uFF1A `UnityEngine.SceneManagement`\n\n\u5176\u4ED6\u77E5\u8BC6\u70B9\uFF1A\n\xB7
    \u811A\u672C\u5FC5\u987B\u5199\u5728 `Start()` \u6216 `Update()` \u5916\u9762\u7684\u5B9A\u4E49\u4E2D\uFF08\u4F5C\u4E3A\u72EC\u7ACB\u65B9\u6CD5\uFF09\n\xB7
    \u65B9\u6CD5\u5FC5\u987B\u662F `public` \u624D\u80FD\u5728 Button \u7684 OnClick
    \u83DC\u5355\u4E2D\u627E\f\u5230\n\xB7 \u573A\u666F\u540D\u5FC5\u987B\u548C `Build
    Settings` \u4E2D\u6DFB\u52A0\u7684\u573A\u666F\u540D\u5B8C\u5168\u4E00\u81F4\uFF08\u533A\u5206\u5927\u5C0F\u5199\uFF09\n\n##\n\u573A\u666F\u5207\u6362\u811A\u672C\u7684\u7528\u6CD5\n\n1.
    \u5C06 SceneSwitcher \u811A\u672C\u6302\u8F7D\u5230\u4E00\u4E2A\u7A7A\u7269\u4F53\u4E0A\uFF08\u6BD4\u5982\u53EB
    \"SceneManager\" \u7684\u7A7A\u7269\u4F53\uFF09\n2. \u5728\u81EA\u5DF1\u573A\u666F\u7684
    Button \u7684 OnClick() \u4E2D\uFF1A\n   \xB7 \u628A \"SceneManager\" \u7269\u4F53\u62D6\u5165\u4E8B\u4EF6\u69FD\n  
    \xB7 \u9009\u62E9 `SceneSwitcher` \u2192 `GoToGame()`\uFF08\u6216\u5BF9\u5E94\u65B9\u6CD5\uFF09\n\n>
    [\u5728\u6B64\u5904\u63D2\u5165\u622A\u56FE\uFF1AOnClick \u914D\u7F6E\u5B8C\u6210\u540E
    Inspector \u7684\u6837\u5B50]\n\n#\n3.4 \u6E38\u620F\u7ED3\u675F Panel \u7684\u5236\u4F5C\n\nPanel
    \u662F UI \u5BB9\u5668\uFF0C\u7528\u6765\u5728\u6E38\u620F\u7ED3\u675F\u65F6\u663E\u793A\"\u91CD\u65B0\u6E38\u73A9\"\u548C\"\u9000\u51FA\"\u6309\u94AE\u3002\n\n##\n\u521B\u5EFA\u6B65\u9AA4\n\n1.
    \u521B\u5EFA Panel\uFF1A Hierarchy \u53F3\u952E \u2192 `UI` \u2192 `Panel`\n  
    \xB7 \u4F1A\u81EA\u52A8\u653E\u5728 Canvas \u4E0B\n   \xB7 > [\u5728\u6B64\u5904\u63D2\u5165\u622A\u56FE\uFF1A\u521B\u5EFA
