--- !u!114 &1715384384
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1715384382}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: daf404ac10c46324790e3afd8418ce81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: "Office_Tool_Plus_\u5B89\u88C5\u6FC0\u6D3B\u6559\u7A0B"
  author: "\u65E5\u5E38\u95EE\u9898\u5904\u7406\u7ECF\u9A8C"
  summary: "\nOffice Tool Plus \u5B89\u88C5 & \u6FC0\u6D3B Visio \u5168\u6D41\u7A0B\n\n>
    \u53C2\u8003\u6587\u6863\uFF1A\n> \xB7 \u5B98\u7F51\uFF1Ahttps://www.officetool.plus/zh-cn/\n>
    \xB7 \u6FC0\u6D3B\u6559\u7A0B\uFF1Ahttps://blog.yerong.org/archives/14\n> \xB7
    \u6FC0\u6D3B\u9519\u8BEF\u6392\u67E5\uFF1Ahttps://blog.yerong.org/archives/13\n\n---\n\n#\n\u7B2C\u4E00\u6B65\uFF1A\u4E0B\u8F7D
    Office Tool Plus\n\n1. \u6253\u5F00\u5B98\u7F51 https://www.officetool.plus/zh-cn/\n2.
    \u70B9\u51FB\u5DE6\u4FA7\u83DC\u5355 \u4E0B\u8F7D\n3. \u9009\u62E9 64-bit \u5E26\u8FD0\u884C\u5E93\u7248\u672C\uFF08`with_runtime`\uFF09\uFF0C\u76F4\u63A5\u4E0B\u8F7D\n4.
    \u89E3\u538B\u5230\u4EFB\u610F\u76EE\u5F55\uFF08\u5982\u684C\u9762\uFF09\n\n---\n\n#\n\u7B2C\u4E8C\u6B65\uFF1A\u6FC0\u6D3B\uFF08\u547D\u4EE4\u6846\u81EA\u52A8\u6FC0\u6D3B\uFF09\n\n1.
    \u6253\u5F00 `Office Tool Plus.exe`\n2. \u6309\u5FEB\u6377\u952E `Ctrl + Shift
    + P` \u6253\u5F00\u547D\u4EE4\u6846\n3. \u8F93\u5165\u4EE5\u4E0B\u547D\u4EE4\uFF0C\u6309\u56DE\u8F66\f\u6267\u884C\uFF1A\n\nbatch\nospp
    /inslicid VisioPro2024Volume /sethst kms.loli.best /setprt 1688 /act\n\n\n\u51FA\u73B0\u4EE5\u4E0B\u8F93\u51FA\u5373\u4E3A\u6210\u529F\uFF08\u6700\u4E0B\u9762\u90A3\u884C\u65E0\u9519\u8BEF\u7801\uFF09\uFF1A\n\nSuccessfully
    installed product key.\nSuccessfully installed licenses.\nSuccessfully applied
    KMS settings.\nOffice 24, Office24VisioPro2024VL_KMS_Client_AE edition \xB7 \u6FC0\u6D3B\u6210\u529F\n\n\n>
    \u5982\u9700\u540C\u65F6\u6FC0\u6D3B Office + Visio + Project 2024\uFF0C\u7528\u8FD9\u6761\uFF1A\n>
    \n> ospp /inslicid ProPlus2024Volume /inslicid VisioPro2024Volume /inslicid ProjectPro2024V\folume
    /sethst kms.loli.best /setprt 1688 /act\n> \n\n##\n\u4EA7\u54C1 ID \u5BF9\u7167\u8868\n\n|
    \u4EA7\u54C1 | \u547D\u4EE4 ID |\n|---|---|\n| Office 2024 \u4E13\u4E1A\u589E\u5F3A\u7248
    | `ProPlus2024Volume` |\n| Visio 2024 \u4E13\u4E1A\u7248 | `VisioPro2024Volume`
    |\n| Project 2024 \u4E13\u4E1A\u7248 | `ProjectPro2024Volume` |\n| Office 2021
    \u4E13\u4E1A\u589E\u5F3A\u7248 | `ProPlus2021Volume` |\n| Visio 2021 \u4E13\u4E1A\u7248
    | `VisioPro2021Volume` |\n| Project 2021 \u4E13\u4E1A\u7248 | `ProjectPro2021Volume`
    |\n\n---\n\n#\n\u7B2C\u4E09\u6B65\uFF1A\u90E8\u7F72\uFF08\u4E0B\u8F7D\u5B89\u88C5\uFF09\n\n\u6FC0\u6D3B\u5B8C\u6210\u540E\uFF0C\u8FDB\u884C\u90E8\u7F72\u4E0B\u8F7D\u5B89\u88C5\uFF1A\n\n1.
    \u5728 Office Tool Plus \u4E2D\u5207\u6362\u5230 \u90E8\u7F72 \f\u9875\u9762\n2.
    \u5728 \u6DFB\u52A0\u4EA7\u54C1 \u4E2D\u9009\u62E9\u5BF9\u5E94\u7684\u4EA7\u54C1\uFF08\u4E0E\u6FC0\u6D3B\u65F6\u7528\u7684
    ID \u4E00\u81F4\uFF09\n   \xB7 \u4F8B\u5982\u6FC0\u6D3B\u4E86 `VisioPro2024Volume`\uFF0C\u5C31\u6DFB\u52A0
    Visio LTSC Professional Plus 2024 \xB7 \u6279\u91CF\u8BB8\u53EF\u8BC1\n3. \u5728\u4E0B\u65B9
    \u5E94\u7528\u7A0B\u5E8F \u4E2D\u53EA\u52FE\u9009\u9700\u8981\u7684\uFF08\u5982\u53EA\u52FE\u9009
    Visio\uFF09\n4. \u4F53\u7CFB\u7ED3\u6784 \u9009 64\u4F4D\n5. \u70B9\u51FB\u53F3\u4E0A\u89D2
