--- !u!114 &1394716692
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1394716690}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: daf404ac10c46324790e3afd8418ce81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: "CinemachineBrain\u7EC4\u4EF6\u89E3\u6790\u4E0E\u7B54\u7591"
  author: "\u65E5\u5E38\u95EE\u9898\u5904\u7406\u7ECF\u9A8C"
  summary: "\nCinemachineBrain \u7EC4\u4EF6\u89E3\u6790\u4E0E\u7B54\u7591\uFF08\u5B88\u62A4\u841D\u535C
    \xB7 M1\uFF09\n\n> \u9002\u7528\u5DE5\u7A0B\uFF1A`E:\\Unity xianmu\\MCP\u6D4B\u8BD5`
    \xB7 Unity 2022.3.42f1 \xB7 Cinemachine 2.9.7\n> \u573A\u666F\uFF1A`Mcp` \xB7
    \u76F8\u5173\u811A\u672C\uFF1A`GameBootstrap.cs`\uFF08SetupCinemachine\uFF09\u3001`WaveManager.cs`\uFF08ShakeCamera\uFF09\n\n---\n\n#\n1.
    \u4E00\u53E5\u8BDD\u7ED3\u8BBA\n\nCinemachineBrain \u662F\u6302\u5728\u4E3B\u6444\u50CF\u673A\u4E0A\u7684\u552F\u4E00\"\u603B\u8C03\u5EA6\u5668\"\u7EC4\u4EF6\u3002\u5B83\u4E00\u4E2A\u7EC4\u4EF6\u7BA1\u4E24\u4EF6\u4E8B\uFF1A\n1.
    \u8FD0\u955C\u8F6C\u53D1\uFF1A\u628A\"\u5F53\u524D\u6FC0\u6D3B\u7684\u865A\u62DF\u76F8\u673A\uFF08vcam\uFF09\"\u7684\u955C\u5934\u72B6\u6001\uFF08\u4F4D\u7F6E/\u65CB\u8F6C/\u7126\u8DDD\uFF09\u5199\u8FDB\u771F\u5B9E\u4E3B\u76F8\u673A\uFF1B\n2.
    \u51B2\u51FB\u8F6C\u53D1\uFF1A\u628A vcam \u4E0A\u7684\u9707\u52A8\u4FE1\u53F7\uFF08CinemachineImpulseSource
    \u4EA7\u751F\u7684\uFF09\u642C\u8FDB\u753B\u9762\uFF0C\u5B9E\u73B0\u9707\u5C4F\u3002\n\n\u5B83\u4E0D\u662F\u8FD0\u955C\u5185\u5BB9\u7684\u5236\u9020\u8005\uFF0C\u800C\u662F\u642C\u8FD0\u5DE5
    + \u6DF7\u97F3\u53F0\u3002\n\n---\n\n#\n2. \u5B83\u662F\u8C01\u3001\u7AD9\u5728\u54EA\n\n|
    \u9879 \f| \u8BF4\u660E |\n|---|---|\n| \u7EC4\u4EF6\u540D | `CinemachineBrain`\uFF08\u547D\u540D\u7A7A\u95F4
    `Cinemachine`\uFF0C\u7A0B\u5E8F\u96C6 `Cinemachine.dll`\uFF09 |\n| \u6302\u5728\u54EA
    | \u771F\u5B9E\u4E3B\u76F8\u673A\uFF08\u672C\u9879\u76EE = Main Camera\uFF09
    |\n| \u4F9D\u8D56 | Unity \u7F16\u8F91\u5668\u5DF2\u5B89\u88C5 Cinemachine \u5305\uFF08PackageManager\uFF09
    |\n| \u6743\u5A01\u6027 | \u4E00\u4E2A\u573A\u666F\u53EA\u80FD\u6709\u4E00\u4E2A\u88AB\u6FC0\u6D3B\u7684
    Brain \u7BA1\u4E3B\u76F8\u673A\uFF1B\u591A vcam \u65F6\u7531 Brain \u4EF2\u88C1
    |\n\n> \u26A0\uFE0F \u8E29\u5751\u8BB0\u5F55\uFF1ACinemachine 2.9.x \u7684\u547D\u540D\u7A7A\u95F4\u662F
    `Cinemachine`\uFF0C\u4E0D\u662F `UnityEngine.Cinemachine`\uFF1B\n> \u7A0B\u5E8F\u96C6\u540D\u662F
    `Cinemachine`\uFF08`com.unity.cinemachine.editor` \u662F\u7F16\u8F91\u5668\u4FA7\u7A0B\u5E8F\u96C6\uFF09\u3002\n>
    \u672C\u9879\u76EE\u7684 UnityBridge\uFF08`UnityCommandHand\fler.ResolveComponentType`\uFF09\u5DF2\u6309\u6B64\u4FEE\u6B63\uFF0C\u624D\u80FD\u7528\n>
    `addComponent \u2192 CinemachineBrain` \u628A\u7EC4\u4EF6\u6302\u4E0A\u573A\u666F\u3002\n\n---\n\n#\n3.
    \u4E00\u4E2A\u7EC4\u4EF6\uFF0C\u4E24\u4E2A\u529F\u80FD\u9762\n\n##\n3.1 \u529F\u80FD\u9762
    A\uFF1A\u8FD0\u955C\u8F6C\u53D1\uFF08\u6BCF\u5E27\uFF09\n\n\nvcam\uFF08\u865A\u62DF\u76F8\u673A\uFF0C\u5B58\"\u8FD0\u955C\u65B9\u6848\"\uFF09\u2500\u2500\u25BA
    CinemachineBrain \u2500\u2500\u25BA \u771F\u5B9E\u4E3B\u76F8\u673A\n  \u4F4D\u7F6E/\u65CB\u8F6C/\u955C\u5934\u53C2\u6570             
    \u6BCF\u5E27\u8BFB\u53D6+\u5E73\u6ED1              \u753B\u9762\n\n\n\xB7 vcam
    \u672C\u8EAB\u4E0D\u62CD\u6444\uFF0C\u5B83\u53EA\u662F\"\u5EFA\u8BAE\"\u3002\n\xB7
    Brain \u6BCF\u5E27\u6BD4\u8F83\u6240\u6709 vcam \u7684 Priority\uFF08\u4F18\u5148\u7EA7\uFF09\uFF0C\u9009\u6700\u9AD8\u7684\u90A3\u4E2A\uFF0C\u628A\u5B83\u7684\u72B6\u6001\u5E94\u7528\u5230\u4E3B\u76F8\u673A\u3002\n\xB7
    \u5207\u6362 vcam \u65F6\u81EA\u52A8\u505A\u6DF7\u5408\u8FC7\u6E21\uFF08Blend\uFF09\uFF0C\u800C\u4E0D\u662F\u77AC\u95F4\u8DF3\u53D8\u3002\n\n##\n3.2
    \u529F\u80FD\u9762 B\uFF1A\u51B2\u51FB\u8F6C\u53D1\uFF08\u9707\u5C4F\uFF09\n\n\nCinemachineImpulseSource\uFF08\u9707\u52A8\u53D1\u751F\u5668\uFF0C\u6302
    vcam \u4E0A\uFF09\n        \u2502  Genera\fteImpulse(\u5F3A\u5EA6)\n        \u25BC\nCinemachineBrain
    \u2500\u2500\u25BA \u628A\u51B2\u51FB\u566A\u58F0\u53E0\u52A0\u5230\u4E3B\u76F8\u673A\u4F4D\u7F6E/\u65CB\u8F6C
    \u2500\u2500\u25BA \u753B\u9762\u6296\u52A8\n\n\n\xB7 \u9707\u52A8\u6E90\u662F
    vcam \u4E0A\u7684 `CinemachineImpulseSource`\uFF08\u4E0D\u662F Brain \u4EA7\u751F\uFF09\u3002\n\xB7
    Brain \u8D1F\u8D23\u628A\u4FE1\u53F7\"\u642C\"\u5230\u753B\u9762\u4E0A\uFF0C\u5E76\u81EA\u52A8\u8870\u51CF\u56DE\u539F\u4F4D\u3002\n\xB7
    \u672C\u9879\u76EE Boss \u6CE2\uFF1A`WaveManager.ShakeCamera()` \u2192 \u627E\u5230
    `CM vcam (BossShake)` \u2192 `GenerateImpulse(v)` \u2192 Brain \u8BA9\u4E3B\u76F8\u673A\u6296\u51E0\u5E27\u3002\n\n---\n\n#\n4.
    \u9879\u76EE\u5F53\u524D\u5B9E\u73B0\uFF08\u53EF\u76F4\u63A5\u5BF9\u7167\u4EE3\u7801\uFF09\n\n`GameBootstrap.cs`
    \u2192 `SetupCinemachine()`\uFF08Play \u5F00\u59CB\u65F6\u6267\u884C\uFF09\uFF1A\n\ncsharp\nif
    (cam.GetComponent<CinemachineBrain>() == null)\n    cam.g\fameObject.AddComponent<CinemachineBrain>();       
    // \u2460 \u4E3B\u76F8\u673A\u6302 Brain\n\nvar vcamGo = new GameObject(\"CM
    vcam (BossShake)\");\nvar vcam = vcamGo.AddComponent<CinemachineVirtualCamera>();
    // \u2461 \u5EFA\u865A\u62DF\u76F8\u673A\nvcam.m_Lens.Orthographic = true;\nvcam.m_Lens.OrthographicSize
    = cam.orthographicSize;        // \u6B63\u4EA4 8.5\uFF0C\u4E0E\u4E3B\u76F8\u673A\u4E00\u81F4\nvcam.transform.position
    = cam.transform.position;           // \u955C\u5934\u4F4D\u7F6E = \u4E3B\u76F8\u673A\u4F4D\u7F6E\nvcam.Priority
    = 10;           \f                              // \u4F18\u5148\u7EA7\nvcamGo.AddComponent<CinemachineImpulseSource>();           
    // \u2462 \u9707\u52A8\u53D1\u751F\u5668\n\n\n`WaveManager.cs` \u2192 `ShakeCamera()`\uFF08Boss
    \u6CE2\u51FA\u573A\u65F6\uFF09\uFF1A\n\ncsharp\npublic static void ShakeCamera(float
    velocity = 0.6f)\n{\n    var vcamGo = GameObject.Find(\"CM vcam (BossShake)\");\n   
    var src = vcamGo?.GetComponent<CinemachineImpulseSource>();\n    src?.GenerateImpulse(new
    Vector3(velocity, velocity, 0));\n}\n\n\n\u573A\u666F\u73B0\u72B6\uFF08\u5DF2\u5E38\f\u9A7B\uFF09\uFF1AMain
    Camera \u4E0A\u5DF2\u6302 `CinemachineBrain` \u5E76\u4FDD\u5B58\u573A\u666F\uFF1B\n\u8FD0\u884C\u65F6\u4F1A\u52A8\u6001\u65B0\u5EFA
    `CM vcam (BossShake)` \u7A7A\u7269\u4F53\uFF08\u9759\u6001\u753B\u9762\u7528\uFF09\u3002\n\n---\n\n#\n5.
    \u6CA1\u6709\u5B83 vs \u6709\u5B83\uFF08\u5BF9\u6BD4\uFF09\n\n| \u573A\u666F
    | \u6CA1\u6709 CinemachineBrain | \u6709 CinemachineBrain |\n|---|---|---|\n|
    Boss \u9707\u5C4F | \u624B\u5199\u968F\u673A\u504F\u79FB+\u590D\u4F4D\uFF0C\u6613\u6296\u574F
    | `GenerateImpulse()` \u4E00\u884C\uFF0C\u81EA\u52A8\u8870\u51CF |\n| \u955C\u5934\u8DDF\u968F\u841D\u535C/\u654C\u4EBA
    | \u624B\u5199\u6BCF\u5E27\u63D2\u503C\u79FB\u52A8\u76F8\u673A | vcam \u6302
    Follow\uFF0C\u5F15\u64CE\u81EA\u52A8 |\n| \u955C\u5934\u7F29\u653E/\u7279\u5199
    | \u624B\u5199 Lerp \u5C3A\u5BF8 | \u5207 vcam \u6216\u6539 OrthographicSize\uFF0C\u81EA\u52A8\u6DF7\u5408
    |\n| \u591A\u76F8\u673A | \u5BB9\u6613\u91CD\u590D\u521B\u5EFA\u3001\u4E92\u76F8\u6253\u67B6
    | \u76F8\u673A\u552F\u4E00\uFF0Cvcam \u53EA\u662F\"\u65B9\u6848\" |\n| \u672A\u6765\u6269\u5C55\uFF08\u7ED3\u5C40\u955C\u5934\u3001\u6CE2\u6B21\u7279\u5199\uFF09
    | \u6BCF\u6B21\u65B0\u5199\u4E00\u5957 | \u52A0\f vcam \u5373\u53EF |\n\n---\n\n#\n6.
    \u6DF1\u5EA6\u5B9E\u4F8B\u53CD\u95EE\uFF08\u5148\u60F3\uFF0C\u518D\u770B\u7B54\u6848\uFF09\n\n>
    \u60F3\u6E05\u695A\"\u6211\u4F1A\u600E\u4E48\u5904\u7406\u3001\u52A8\u54EA\u4E2A\u7EC4\u4EF6\u3001\u4EE3\u7801\u600E\u4E48\u5199\"\uFF0C\u518D\u5F80\u4E0B\u7FFB\u53C2\u8003\u7B54\u6848\u3002\n\n##\n\u573A\u666F
