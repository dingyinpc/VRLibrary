    \u2502    (\u573A\u666F\u7F16\u8F91\u533A)  \u2502   (\u5C5E\u6027\u9762\u677F)     
    \u2502\n\u2502                   \u2502                  \u2502                  
    \u2502\n\u2502   \u2500 Start         \u2502                  \u2502   Transform      
    \u2502\n\u2502   \u2500 Game          \u2502  \u5728\u8FD9\u91CC\u62D6\u62FD/    
    \u2502   Position: 0,0,0 \u2502\n\u2502   \u2500 Main Camera   \u2502  \u65CB\u8F6C/\u7F29\u653E\u7269\u4F53  
    \u2502   Rotation: 0,0,0 \u2502\n\u2502   \u2500 Directional   \u2502            
