--- !u!114 &913144466
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 913144464}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: daf404ac10c46324790e3afd8418ce81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: "\u811A\u672C\u751F\u6210\u9884\u5236\u4F53_\u7A0B\u5E8F\u5316\u70D8\u7119_\u64CD\u4F5C\u6307\u5357"
  author: "\u65E5\u5E38\u95EE\u9898\u5904\u7406\u7ECF\u9A8C"
  summary: "\n\u811A\u672C\u751F\u6210\u9884\u5236\u4F53\uFF08\u7A0B\u5E8F\u5316\u70D8\u7119\uFF09\xB7
    \u64CD\u4F5C\u6307\u5357\n\n> \u573A\u666F\uFF1A\u4E0D\u60F3\u624B\u5DE5\u5728
    Unity \u7F16\u8F91\u5668\u91CC\u642D\u7269\u4F53/\u9762\u677F\uFF0C\u800C\u662F\u300C\u7528\u4EE3\u7801\u6784\u5EFA
    \u2192 \u4E00\u6761\u547D\u4EE4\u5B58\u6210 .prefab \u8D44\u4EA7 \u2192 \u8FD0\u884C\u65F6\u52A0\u8F7D\u5B9E\u4F8B\u5316\u300D\u3002\n>
    \u9002\u7528\uFF1AUI \u9762\u677F\u3001\u5361\u7247\u3001\u5217\u8868\u884C\u3001\u53EF\u590D\u7528\u7269\u4F53\uFF08\u672C\u9879\u76EE\u5B88\u62A4\u841D\u535C
    V2.1 \u6838\u5FC3\u65B9\u6CD5\uFF09\u3002\n> \u5DF2\u5B9E\u6D4B\uFF1A`Tools/M1TD/\u6F14\u793A-\u811A\u672C\u70D8\u7119\u9884\u5236\u4F53`\uFF08\u9879\u76EE\u5185\u53EF\u8FD0\u884C\uFF09\u3002\n\n#\n\u4E00\u3001\u4E00\u53E5\u8BDD\u539F\u7406\n\nUnity
    \u573A\u666F\u91CC\u7684\u6BCF\u4E2A GameObject \u672C\u8D28\u4E0A\u90FD\u662F\"\u7EC4\u4EF6\u5217\u8868
    + \u7236\u5B50\u5173\u7CFB\"\u7684\u6570\u636E\u3002\n\u624B\u5DE5\u642D = \u4F60\u5728\u7F16\u8F91\u5668\u91CC\u4E00\u4E2A\u4E2A
    AddComponent\u3001\u62D6\u5F15\u7528\uFF1B\u811A\u672C\u70D8\u7119 = \u8BA9\u4EE3\u7801\u5E72\u540C\u6837\u7684\u4E8B\uFF0C\u6700\u540E\u7528\u4E00\u884C
    `PrefabUtility.SaveAsPrefabAsset` \u628A\u7ED3\u679C\u5199\u8FDB Assets \u53D8\u6210\u4E00\u4E2A
    `.prefab` \u6587\u4EF6\u3002\n\u4E4B\u540E\u8FD9\u4E2A\u6587\u4EF6\u5C31\u662F\u666E\u901A\u8D44\u4EA7\uFF1A\u80FD\u62D6\u8FDB\u4EFB\u610F\u573A\u666F\u3001\u80FD\u88AB
    `Resources.Load` \u52A0\u8F7D\u3001\u80FD\u88AB\u65E0\u6570\u6B21 `Insta\fntiate`\u3002\n\n#\n\u4E8C\u3001\u5173\u952E
    API\uFF08\u5C31 4 \u4E2A\uFF09\n\n| API | \u4F5C\u7528 |\n|---|---|\n| `PrefabUtility.SaveAsPrefabAsset(go,
    path)` | \u6838\u5FC3\uFF1A\u628A\u5185\u5B58\u91CC\u7684 GameObject\uFF08\u542B\u5168\u90E8\u7EC4\u4EF6/\u5B50\u7269\u4F53/\u5F15\u7528\uFF09\u5B58\u6210
    .prefab \u8D44\u4EA7 |\n| `AssetDatabase.SaveAssets()` + `AssetDatabase.Refresh()`
    | \u843D\u76D8 + \u5237\u65B0\u8D44\u4EA7\u6570\u636E\u5E93\uFF08\u8BA9 .prefab
    \u7ACB\u523B\u53EF\u89C1\u53EF\u52A0\u8F7D\uFF09 |\n| `Resources.Load<GameObject>(\"M1TD/Prefabs/xxx\")`
    | \u8FD0\u884C\u65F6\u52A0\u8F7D\uFF08\u6CE8\u610F\uFF1A\u53EA\u5BF9 `Assets/Resources/`
    \u76EE\u5F55\u4E0B\u7684\u8D44\u4EA7\u751F\u6548\uFF0C\u8DEF\u5F84\u4E0D\u5E26\u6269\u5C55\u540D\uFF09
    |\n| `Object.Instantiate(prefab, parent, false)` | \u5B9E\u4F8B\u5316\u5230\u573A\u666F/\u753B\u5E03\u4E0B
    |\n\n#\f\n\u4E09\u3001\u5B8C\u6574\u6D41\u7A0B\uFF08\u4E94\u6B65\uFF0C\u5DF2\u5728\u672C\u9879\u76EE\u6F14\u793A\u811A\u672C\u4E2D\u5B9E\u73B0\uFF09\n\n##\n\u7B2C
    1 \u6B65\uFF1A\u5199\u4E00\u4E2A Editor \u811A\u672C\uFF0C\u83DC\u5355\u5165\u53E3\n\u6587\u4EF6\u653E
    `Assets/Editor/` \u4E0B\uFF08Editor \u6C47\u7F16\uFF09\uFF0C`[MenuItem(\"Tools/\u4F60\u7684\u83DC\u5355\u540D\")]`
    \u5373\u6CE8\u518C\u83DC\u5355\u3002\n\n##\n\u7B2C 2 \u6B65\uFF1A\u5728\u83DC\u5355\u65B9\u6CD5\u91CC\"\u7528\u4EE3\u7801\u6784\u5EFA\u7269\u4F53\"\u2014\u2014\u548C\u8FD0\u884C\u65F6
    BuildUI \u4E00\u6A21\u4E00\u6837\ncsharp\nvar root = new GameObject(\"DemoPanel\",
    typeof(RectTransform));\nroot.AddComponent<Image>().color = Color.blue;   //
    \u7EC4\u4EF6\u968F\u4FBF\u52A0\nvar btn = new GameObject(\"Btn\").transform;
    btn.SetParent(root.transform, false);\nbtn.gameObject.AddComponent<Button>(\f);\n\n\xB7
    \u53EF\u4EE5\u5728\u7F16\u8F91\u6A21\u5F0F\u76F4\u63A5\u8DD1\uFF1AAddComponent
    / SetParent / \u8BBE\u5C5E\u6027\u5168\u90FD\u80FD\u5728\u975E Play \u4E0B\u6267\u884C\u3002\n\xB7
    RectTransform\u3001Canvas\u3001Image\u3001Button \u7B49 UGUI \u7EC4\u4EF6\u540C\u7406\u3002\n\n##\n\u7B2C
    3 \u6B65\uFF1A\u70D8\u7119\uFF08\u6838\u5FC3\u4E00\u884C\uFF09\ncsharp\nPrefabUtility.SaveAsPrefabAsset(root,
    \"Assets/Resources/M1TD/Prefabs/DemoPanel.prefab\");\nObject.DestroyImmediate(root);  
    // \u4E34\u65F6\u7269\u4F53\u6E05\u6389\uFF0C\u573A\u666F\u4E0D\u7559\u75D5\nAssetDatabase.SaveAssets();
    AssetDatabase.Refresh();\n\n> \u6CE8\u610F\uFF1A`SaveAsPrefabAsset` \u4FDD\u5B58\u7684\u662F\"\u7269\u4F53\u672C\u8EAB\"\uFF0C\u4E0D\u8981\u63D0\u524D\u628A
    root \u6302\u8FDB\u5F53\u524D\u573A\u666F\uFF08\u573A\u666F\u5B9E\u4F8B\u4FDD\u5B58\u4F1A\u5E26\u7740\u573A\u666F\u4E0A\u4E0B\u6587\uFF09\u3002\n\n##\n\u7B2C
    4 \u6B65\uFF1A\u8FD0\u884C\u65F6\u52A0\f\u8F7D + \u5B9E\u4F8B\u5316\ncsharp\nvar
    prefab = Resources.Load<GameObject>(\"M1TD/Prefabs/DemoPanel\"); // \u4E0D\u5E26\u6269\u5C55\u540D\nvar
    inst = Instantiate(prefab, canvas.transform, false);\n\n\n##\n\u7B2C 5 \u6B65\uFF1A\u7ED1\u5B9A\u52A8\u6001\u5185\u5BB9\uFF08\u6309\u94AE\u56DE\u8C03
    / \u6587\u672C / \u56FE\u6807\uFF09\ncsharp\ninst.transform.Find(\"Title\").GetComponent<TextMeshProUGUI>().text
    = \"\u5B9E\u9645\u6807\u9898\";\ninst.transform.Find(\"Btn\").GetComponent<Button>().onClick.AddListener(MyHandler);\n\n\u94C1\u5F8B\uFF1Aprefab
    \u91CC\u53EA\u5B58\"\u9AA8\u67B6\"\uFF08\u7EC4\u4EF6\u7ED3\u6784/\u5E03\u5C40/\u9ED8\u8BA4\u6837\u5F0F\uFF09\uFF0C\u6240\u6709\u6570\u636E\u4E0E\u56DE\u8C03\u5728\u5B9E\u4F8B\u5316\u540E\u8FD0\u884C\u65F6\u586B\u3002\n\n#\n\u56DB\u3001\u516D\u5927\u9677\u9631\u4E0E\u5BF9\u7B56\uFF08\u65B0\u624B\u5FC5\u8E29\f\uFF09\n\n1.
    Button.onClick / \u59D4\u6258\u4E0D\u5E8F\u5217\u5316\n   `UnityEvent` \u5E8F\u5217\u5316\u7684\u662F\"\u76EE\u6807+\u65B9\u6CD5\u540D\"\uFF0C\u4EE3\u7801\u91CC
    `AddListener(\u533F\u540D\u59D4\u6258)` \u65E0\u6CD5\u5B58\u8FDB prefab\u2014\u2014\u70D8\u7119\u540E\u662F\u7A7A\u5217\u8868\u3002\n  
    \u2192 \u5BF9\u7B56\uFF1A\u70D8\u7119\u65F6\u7559\u7A7A\uFF0C\u5B9E\u4F8B\u5316\u540E
    `onClick.AddListener(...)` \u7ED1\u5B9A\uFF08\u89C1\u7B2C 5 \u6B65\uFF09\u3002\n\n2.
    \u5F15\u7528\u4E0D\u80FD\u6307\u5411\u573A\u666F\u91CC\u7684\u7269\u4F53\n  
    \u4EE3\u7801\u91CC `someField = GameObject.Find(\"...\")` \u8FD9\u79CD\u5F15\u7528\u5B58\u4E0D\u8FDB
    prefab\uFF08\u573A\u666F\u5F15\u7528\u8DE8\u8D44\u4EA7\u65E0\u6548\uFF09\u3002\n  
    \u2192 \u5BF9\u7B56\uFF1Aprefab \u5185\u5F15\u7528\u7528 `Transform.Find(\"\u5B50\u7269\u4F53\u540D\")`
    \u5728\"\u7ED3\u6784\u4E0A\"\u5B9A\u4F4D\uFF1B\u573A\u666F\u7EA7\u5F15\u7528\u5168\u90E8\u8FD0\u884C\u65F6\u6CE8\u5165\u3002\n\n3.
    TMP \u52A8\u6001/\u8FD0\u884C\u65F6\u5B57\u4F53\u4E0D\u4F1A\u968F prefab \u4FDD\u5B58\n  
    \u672C\u9879\u76EE CJK \u5B57\u4F53\u662F\u8FD0\u884C\u65F6 `CJKFontUtil` \u521B\u5EFA\u7684\uFF0Cprefab
    \u91CC\u4FDD\u5B58\u7684\u662F\u7A7A\u5B57\u4F53\u3002\n   \u2192 \u5BF9\u7B56\uFF1A\u70D8\f\u7119\u65F6\u5B57\u4F53\u7559\u7A7A\uFF1B\u5B9E\u4F8B\u5316\u540E
    `tmp.text` \u8D4B\u503C\u524D\u5148 `tmp.font = CJKFont`\uFF08\u6216\u5168\u5C40\u9ED8\u8BA4\u5B57\u4F53\u5DF2\u6302\uFF09\u3002\n\n4.
    Resources \u76EE\u5F55\u662F\u5927\u5C0F\u5199/\u8DEF\u5F84\u654F\u611F\u7684\u52A0\u8F7D\u8FB9\u754C\n  
    \u53EA\u6709 `Assets/Resources/` \u4E0B\u7684\u8D44\u4EA7\u80FD `Resources.Load`\uFF1B\u8DEF\u5F84\u4E0D\u5E26
    `.prefab` \u540E\u7F00\u3002\n   \u2192 \u5BF9\u7B56\uFF1A\u7EDF\u4E00\u653E
    `Assets/Resources/M1TD/Prefabs/`\uFF0C\u52A0\u8F7D\u4E32\u6052\u4E3A `\"M1TD/Prefabs/\u540D\u5B57\"`\u3002\n\n5.
    \u70D8\u7119\u8981\u5E42\u7B49\n   \u91CD\u590D\u6267\u884C\u83DC\u5355 \u2192
    \u540C\u540D\u8D44\u4EA7\u88AB\u8986\u76D6\uFF0C\u4E0D\u8981\u62A5\u9519\u3001\u4E0D\u8981\u5806\u79EF\u3002\n  
    \u2192 \u5BF9\u7B56\uFF1A`SaveAsPrefabAsset` \u5929\u7136\u8986\u76D6\uFF08\u540C\u540D\u540C\u8DEF\u5F84\uFF09\uFF1B\u70D8\u7119\u5F00\u5934
    `Directory.CreateDirectory` \u4FDD\u8BC1\u76EE\u5F55\u5B58\u5728\u3002\n\n6.
    .prefab \u662F\u6587\u672C YAML\uFF0Cgit diff \u53EF\u8BFB\u6027\u5DEE\n   \u2192
    \u5BF9\u7B56\uFF1A\u6309\u9762\u677F\u4E00\u6B21\u63D0\u4EA4\u4E00\u4E2A/\u51E0\u4E2A
    p\frefab\uFF1B\u70D8\u7119\u5668\u662F\u53EF\u91CD\u751F\u6210\u4EE3\u7801\uFF0Cprefab
    \u5F53\"\u4EA7\u7269\"\u770B\u5F85\u2014\u2014\u8981\u6539\u6837\u5F0F\u6539\u4EE3\u7801\u91CD\u70D8\u7119\uFF0C\u4E0D\u8981\u624B\u6539
    prefab \u6587\u672C\u3002\n   \u53E6\u6CE8\uFF1A\u9884\u5236\u4F53\u91CC\u7684\u5F15\u7528\u9760
    GUID \u5E8F\u5217\u5316\uFF0C\u628A\u5F15\u7528\u7684\u8D44\u6E90\u6539\u8DEF\u5F84/\u5220\u4E86\u4F1A\u5BFC\u81F4
    prefab \u5F15\u7528\u65AD\u2014\u2014\u7528\u7F16\u8F91\u5668\u5185\u5F15\u7528\u4FEE\u590D\u6216\u91CD\u70D8\u7119\u3002\n\n#\n\u4E94\u3001\u811A\u672C\u70D8\u7119
    vs \u624B\u5DE5\u642D prefab\n\n| \u7EF4\u5EA6 | \u811A\u672C\u70D8\u7119 | \u624B\u5DE5\u642D
    prefab |\n|---|---|---|\n| \u4E0A\u624B\u901F\u5EA6 | \u4F1A\u5199\u4EE3\u7801\u5C31\u4F1A\uFF08\u4E00\u6B21\u5199\u5BF9\uFF0C\u5168\u8D44\u4EA7\u590D\u7528\uFF09
    | \u62D6\u62D6\u62FD\u62FD\u76F4\u89C2\uFF0C\u4F46\u91CF\u5927\u65F6\u91CD\u590D\u52B3\u52A8
    |\n| \u4E00\u81F4\u6027 | \u540C\u6BB5\u4EE3\u7801\u751F\u6210\u6240\u6709\u8D44\u4EA7\uFF0C\u7ED3\u6784
    100% \u4E00\u81F4 | \u624B\u642D\u5BB9\u6613\u53C2\u6570/\u5E03\u5C40\u4E0D\u9F50
    |\n| \u53EF\u7248\u672C\u5316 | \u4EE3\u7801 diff \u6E05\u6670\uFF0C\u6837\u5F0F\u6539\u4E00\u884C\u91CD\u70D8\u7119
    | prefab YAML \u5927\u6BB5\u5DEE\u5F02\u96BE review |\n| \u52A8\u6001\u5185\u5BB9
    | \u9AA8\u67B6+\u8FD0\u884C\u65F6\u7ED1\u5B9A\uFF0C\u5929\u7136\u9002\u5408\u52A8\u6001
    UI | \u9759\u6001\u5F15\u7528\u65B9\u4FBF\uFF0C\u52A8\u6001\u5185\u5BB9\u540C\u6837\u8981\u4EE3\u7801\u7ED1\u5B9A
    |\n| \u65F6\u673A | \u7F16\u8F91\u5668\u83DC\u5355\u4E00\u952E\u751F\u6210\f\u4EFB\u610F\u591A\u6B21
    | \u6BCF\u6B21\u624B\u642D/\u624B\u6539 |\n| \u9002\u7528 | \u9762\u677F/\u5361\u7247/\u5217\u8868\u884C/\u6279\u91CF\u76F8\u4F3C\u7269
    | \u4E00\u6B21\u6027\u7684\u573A\u666F\u6446\u4EF6\u3001\u624B\u8C03\u8FC7\u7684\u7F8E\u672F\u8D44\u4EA7
    |\n\n\u7ED3\u8BBA\uFF1A\u6279\u91CF/\u76F8\u4F3C/\u52A8\u6001\u5185\u5BB9 \u2192
    \u811A\u672C\u70D8\u7119\uFF1B\u72EC\u4E00\u65E0\u4E8C\u3001\u7EAF\u7F8E\u672F\u6446\u8BBE
    \u2192 \u624B\u5DE5\u642D\u3002\u4E24\u8005\u53EF\u4EE5\u6DF7\u7528\uFF08\u9AA8\u67B6\u70D8\u7119
    + \u624B\u8C03\u7EC6\u8282\u518D\u53E6\u5B58\uFF09\u3002\n\n#\n\u516D\u3001\u672C\u9879\u76EE
    V2.1 \u7684\u6B63\u5F0F\u843D\u5730\u5F62\u6001\uFF08\u5BF9\u6BD4\u6F14\u793A\uFF09\n\n|
    \u6F14\u793A\u811A\u672C\uFF08\u6559\u5B66\uFF09 | V2.1 \u6B63\u5F0F\uFF08PrefabBaker
    + PrefabUI\uFF09 |\n|---|---|\n| \u6F14\u793A\u6784\u5EFA\u4E00\u4E2A DemoPanel
    | \u590D\u7528\u65E2\u6709 BuildShopPanel/BuildHUD \u7B49\u771F\u5B9E\u6784\u5EFA\u65B9\u6CD5
    |\n| \u83DC\u5355\u624B\u52A8\u70B9\u4E00\u6B21 | \u83DC\u5355\u6279\u91CF\u70D8\u7119\u5168\u90E8\u9762\u677F\uFF08\u5E42\u7B49\uFF0C\u8F93\u51FA\u6E05\u5355\uFF09
    |\n| `Resources.Load` + \u624B\u5199 Find | `PrefabUI.Instantiate/Txt/Btn` \u5C01\u88C5\uFF08\u7F13\u5B58+\u5B9A\u4F4D+\u7ED1\u5B9A\u4E00\u884C\u641E\u5B9A\uFF09
    |\n| \u65E0\u7F13\u5B58 | \u52A0\u8F7D\u7F13\u5B58 Dictionary\uFF0C\u91CD\u590D\u6253\f\u5F00\u4E0D\u91CD\u590D\u8BFB\u76D8
    |\n\n#\n\u4E03\u3001\u5728\u9879\u76EE\u91CC\u4EB2\u624B\u8BD5\uFF083 \u5206\u949F\u95ED\u73AF\uFF09\n\n1.
    \u83DC\u5355 Tools/M1TD/\u6F14\u793A-\u811A\u672C\u70D8\u7119\u9884\u5236\u4F53
    \u2192 Assets/Resources/M1TD/Prefabs/ \u51FA\u73B0 `DemoPanel.prefab`\uFF0C\u53CC\u51FB\u53EF\u70B9\u5F00\u770B\u5B83\u7684
    Inspector\uFF08\u5C31\u662F\u4E00\u4E2A\u6B63\u5E38\u9884\u5236\u4F53\uFF01\uFF09\n2.
    \u83DC\u5355 Tools/M1TD/\u6F14\u793A-\u5B9E\u4F8B\u5316\u70D8\u7119\u7684\u9884\u5236\u4F53
    \u2192 Hierarchy \u51FA\u73B0 `DemoPanel(Clone)`\uFF0C\u6807\u9898\u6587\u672C\u88AB\u8FD0\u884C\u65F6\u8986\u76D6\u4E3A\"\u8FD0\u884C\u65F6\u5199\u5165\u7684\u6807\u9898\"\uFF0C\u6309\u94AE\u70B9\u51FB\u4F1A\u6253\u65E5\u5FD7\n3.
    \u628A\u300C\u6F14\u793A-\u811A\u672C\u70D8\u7119\u9884\u5236\u4F53\u300D\u518D\u8DD1\u4E00\u904D
    \u2192 \u8986\u76D6\u518D\u751F\uFF0C\u8BC1\u660E\u5E42\u7B49\n4. \u6253\u5F00
    `Assets/Editor/PrefabBakerDemo.cs` \u5BF9\u7167\u4E0A\u6587\u9010\u6B65\u8BFB\u4E00\u904D\uFF0C\u5C31\u662F\u5B8C\u6574\u6559\u5B66\u3002"
  slotCode: B2-1-06
