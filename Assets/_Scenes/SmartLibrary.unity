--- !u!114 &1235883731
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1235883729}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: daf404ac10c46324790e3afd8418ce81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: "\u5B9E\u73B0\u65B9\u6848 \xB7 02-\u5929\u7A7A\u76D2\u7684\u5236\u4F5C"
  author: "VRlibrary \u9879\u76EE\u7EC4"
  summary: "\n02 \u5929\u7A7A\u76D2\u7684\u5236\u4F5C(\u7A0B\u5E8F\u5316\u8D5B\u535A\u4E4B\u591C
    Skybox/CyberNight)\n\n> \u8D44\u4EA7\u4F4D\u7F6E:`Assets/Skybox/CyberNightSky.shader`
    + `Assets/Skybox/M_CyberNightSky.mat`\n> \u7279\u70B9:\u7EAF\u8FC7\u7A0B\u5316\u3001\u65E0\u8D34\u56FE(\u7EA6
    150 ALU,\u79FB\u52A8\u7AEF VR \u53CB\u597D),HDR \u8F93\u51FA\u914D\u5408 Bloom
    \u4EA7\u751F\u53D1\u5149\u7684\u6708\u4EAE/\u5730\u5E73\u7EBF\u3002\n\n#\n\u4E00\u3001\u539F\u7406\n\n\u81EA\u5199
    HLSL Skybox shader(Shader \u540D `Skybox/CyberNight`),\u5728\u7247\u5143\u7740\u8272\u5668\u91CC\u6309\u89C6\u7EBF\u65B9\u5411\u9010\u50CF\u7D20\u5408\u6210:\n\n1.
    \u4E09\u6BB5\u6E10\u53D8\u5E95\u8272:\u5929\u9876\u8272 `_ZenithColor`(\u6DF1\u84DD\u9ED1)\u2192
    \u5730\u5E73\u7EBF\u8272 `_HorizonColor`(\u9752\u84DD)\u2192 \u5730\u9762\u8272
    `_GroundColor`,\u6309\u89C6\u7EBF y \u5206\u91CF\u7528 `_HorizonFalloff` \u63A7\u5236\u8FC7\u6E21\u9661\u5CED\u5EA6;\n2.
    \u5730\u5E73\u7EBF\u8F89\u5149:\u8D34\u7740\u5730\u5E73\u7EBF\u53E0\u4E00\u5C42\u9752\u8272\u5149\u5E26
    `_Horizo\fnGlowColor`(\u5F3A\u5EA6 `_HorizonGlow`);\n3. Synthwave \u7EC6\u7EBF:\u5730\u5E73\u7EBF\u5904\u4E00\u6761\u54C1\u7EA2\u53D1\u5149\u7EBF(\u989C\u8272
    `_HorizonLineColor`,\u5BBD\u5EA6 `_HorizonLineWidth`),\u590D\u53E4\u8D5B\u535A\u98CE\u7684\u70B9\u775B\u4E4B\u7B14;\n4.
    \u6708\u4EAE:\u4EE5 `_MoonDir` \u4E3A\u4E2D\u5FC3,\u6309\u89D2\u534A\u5F84 `_MoonSize`
    \u753B\u5706\u76D8,\u8FB9\u7F18\u67D4\u5316 `_MoonSoftness`,\u5916\u5708\u5149\u6655
    `_MoonHalo`,\u4EAE\u5EA6 `_MoonIntensity`(HDR >1,\u914D\u5408 Bloom \u53D1\u5149);\n5.
    \u53CC\u5C42\u661F\u5149:\u7F51\u683C\u54C8\u5E0C\u968F\u673A\u6492\u661F,`_StarScale`
    \u63A7\u5236\u758F\u5BC6\u3001`_StarDensity` \u63A7\u5236\u6570\u91CF\u3001`_StarBrightness`
    \u4EAE\u5EA6;\n6. \u7D2B\u8272\u661F\u4E91:\u4F4E\u9891\u566A\u58F0 + `_NebulaColor`
    \u53E0\u52A0,\u5F3A\u5EA6 `_NebulaIntensity`\u3002\n\n#\n\u4E8C\u3001\u5F53\u524D\u53C2\u6570(M_CyberNightSky)\n\n|
    \u5C5E\u6027 |\f \u5F53\u524D\u503C | \u8BF4\u660E |\n| --\xB7 | --\xB7 | --\xB7
    |\n| _ZenithColor | (0.01, 0.02, 0.055) | \u5929\u9876\u6DF1\u84DD |\n| _HorizonColor
    | (0.02, 0.075, 0.095) | \u5730\u5E73\u7EBF\u9752\u84DD |\n| _HorizonGlow | 0.9
    | \u9752\u8272\u8F89\u5149\u5F3A\u5EA6 |\n| _HorizonLineWidth | 0.014 | \u54C1\u7EA2\u7EC6\u7EBF\u5BBD\u5EA6
    |\n| _MoonSize | 0.033(\u539F 0.05,\u5E94\u9700\u6C42\"\u63A8\u8FDC\u4E00\u534A\"\u7F29\u5C0F
    1/3) | \u6708\u4EAE\u89D2\u534A\u5F84(\u5F27\u5EA6) |\n| _MoonIntensity | 3 |
    \u6708\u4EAE HDR \u4EAE\u5EA6 |\n| _MoonDir | \u4E0E\u4E3B\u5E73\u884C\u5149\u540C\u6B65
    | \u6708\u4EAE\u65B9\u5411 = \u5149\u6E90\u65B9\u5411 |\n| _StarDensity | 0.34
    | \u661F\u661F\u5BC6\u5EA6 |\n| _StarBrightness | 1.6 | \u661F\u661F\u4EAE\u5EA6
    |\n| _NebulaIntensity \f| 0.4 | \u661F\u4E91\u5F3A\u5EA6 |\n\n#\n\u4E09\u3001\u6708\u4EAE\u65B9\u5411\u4E0E\u592A\u9633\u5149\u81EA\u52A8\u540C\u6B65(\u5173\u952E\u7EC6\u8282)\n\n\u5929\u7A7A\u91CC\u7684\u6708\u4EAE\u5FC5\u987B\"\u770B\u8D77\u6765\u5C31\u662F\u5149\u6E90\",\u5426\u5219\u5F71\u5B50\u65B9\u5411\u7A7F\u5E2E\u3002\n\u5DE5\u7A0B\u91CC\u6709\u7F16\u8F91\u5668\u811A\u672C
    `Assets/Editor/SkyboxSunSync.cs`:\u6BCF\u5E27(\u7F16\u8F91\u5668)\u628A\n`RenderSettings.skybox.SetVector(\"_MoonDir\",
    \u592A\u9633.transform.forward)` \u540C\u6B65,\n\u5373 \u6708\u4EAE\u65B9\u5411
    = Directional Light \u7167\u5C04\u65B9\u5411,\u5929\u7A7A\u4EAE\u70B9\u3001\u5149\u7EBF\u6765\u5411\u3001\u6295\u5F71\u65B9\u5411\u4E09\u8005\u4E00\u81F4\u3002\n\n#\n\u56DB\u3001\u5E94\u7528\u6B65\u9AA4(\u590D\u523B)\n\n1.
    \u628A `CyberNightSky.shader` \u62F7\u5165\u5DE5\u7A0B(URP/Built-in \u901A\u7528,`#pragma
    target 3.0`);\n2. \u65B0\u5EFA\u6750\u8D28,shader \u9009 `Skybox/CyberNight`,\u547D\u540D
    `M_CyberNightSky`;\n3. `Window \u2192 Rendering \u2192 \fLighting \u2192 Environment
    \u2192 Skybox Material` \u62D6\u5165\u8BE5\u6750\u8D28;\n4. \u5FAE\u8C03\u4E0A\u8868\u53C2\u6570\u5373\u53EF;\u6CE8\u610F:\n  
    \xB7 \u6708\u4EAE\"\u53D8\u8FDC\" = \u7F29\u5C0F `_MoonSize`(\u5929\u7A7A\u76D2\u5728\u65E0\u7A77\u8FDC,\u8DDD\u79BB\u53EA\u80FD\u7528\u89D2\u5C3A\u5BF8\u8868\u8FBE);\n  
    \xB7 \u60F3\u8981\u6708\u4EAE\u66F4\u4EAE\u66F4\u5927:\u8C03 `_MoonIntensity`
    / `_MoonSize`,\u53D1\u5149\u611F\u6765\u81EA\u5168\u5C40 Bloom\u3002\n\n#\n\u4E94\u3001\u4E3A\u4EC0\u4E48\u4E0D\u7528\u8D34\u56FE\u5929\u7A7A\u76D2\n\n\xB7
    \u8D34\u56FE\u5929\u7A7A\u76D2\u63A5\u7F1D\u3001\u5206\u8FA8\u7387\u4E0D\u8DB3\u3001\u5728
    VR \u91CC\u8FD1\u773C\u5BB9\u6613\u7CCA;\n\xB7 \u7A0B\u5E8F\u5316\u53EF\u4EE5\u4EFB\u610F\u8C03\u8272/\u8C03\u661F\u5BC6\u5EA6,\u4E0E\u573A\u666F\u9713\u8679\u8272\u677F(\u9752/\u54C1\u7EA2)\u7EDF\u4E00;\n\xB7
    \u65E0\u91C7\u6837\u5927\u8D34\u56FE,\u79FB\u52A8\u7AEF(PICO)\u5E26\u5BBD\u538B\u529B\u5C0F\u3002\n\r\n---\r\n\r\n#\n\u4EBA\u5DE5\u590D\u523B\u6B65\u9AA4(\u5929\u7A7A\u76D2,\u7167\u505A\u5373\u53EF)\r\n\r\n1.
    \u5EFA shader \u6587\u4EF6:`Assets/Skybox/` \u6587\u4EF6\u5939\u4E0B\u53F3\u952E
    \u2192 Create \u2192 Shader \u2192 Unlit Shader,\u547D\u540D `CyberNightSky`;\u53CC\u51FB\u7528
    IDE \u6253\u5F00,\u5168\u9009\f\u5220\u9664,\u7C98\u8D34\u5B8C\u6574 HLSL \u6E90\u7801(\u6E90\u7801\u5728\u672C\u5DE5\u7A0B
    `Assets/Skybox/CyberNightSky.shader`,\u7EA6 200 \u884C,\u76F4\u63A5\u6574\u4F53\u590D\u5236);Ctrl+S
    \u56DE Unity \u7B49\u7F16\u8BD1\u5B8C\u6210;\r\n2. \u5EFA\u6750\u8D28:\u540C\u6587\u4EF6\u5939\u53F3\u952E
    \u2192 Create \u2192 Material,\u547D\u540D `M_CyberNightSky`,Shader \u4E0B\u62C9\u9009
    `Skybox/CyberNight`;\r\n3. \u542F\u7528:`Window \u2192 Rendering \u2192 Lighting
    \u2192 Environment \u2192 Skybox Material` \u62D6\u5165 M_CyberNightSky;\r\n4.
    \u6309\u53C2\u6570\u8868\u9010\u9879\u8BBE\u7F6E(\u7167\u672C\u6587\u6863\"\u5F53\u524D\u53C2\u6570\"\u8868):\u5929\u9876/\u5730\u5E73\u7EBF/\u5730\u9762\u4E09\u8272\u3001_MoonSize=0.033\u3001_StarDensity=0.34;\r\n5.
    \u6708\u4EAE\u5BF9\u9F50\u5149\u6E90:\u786E\u8BA4\u5DE5\u7A0B\u91CC\u6709 `Assets/Editor/SkyboxSunSync.cs`(\u4F5C\u7528:\f\u7F16\u8F91\u5668\u91CC\u5B9E\u65F6\u628A
    `_MoonDir` \u8BBE\u4E3A\u4E3B\u5E73\u884C\u5149\u65B9\u5411),\u6CA1\u6709\u5219\u4ECE\u672C\u5DE5\u7A0B\u590D\u5236;\u7F3A\u5931\u65F6\u6708\u4EAE\u65B9\u4F4D\u4E0E\u5F71\u5B50\u4F1A\u8131\u8282;\r\n6.
    \u9A8C\u6536:\u76F8\u673A\u62AC\u9AD8\u6216\u4ECE\u540A\u9876\u8FB9\u7F18\u7F1D\u9699\u770B\u591C\u7A7A\u2014\u2014\u6DF1\u84DD\u6E10\u53D8
    + \u9752\u8272\u5730\u5E73\u7EBF\u8F89\u5149 + \u54C1\u7EA2\u7EC6\u7EBF + \u5E26\u5149\u6655\u7684\u6708\u4EAE
    + \u6EE1\u5929\u661F + \u7D2B\u8272\u661F\u4E91;\u8C03\u6574\u4EFB\u4E00\u53C2\u6570,Game
    \u89C6\u56FE\u5373\u65F6\u53D8\u5316\u5373\u4E3A\u6210\u529F\u3002\r\n"
  slotCode: A1-2-06
