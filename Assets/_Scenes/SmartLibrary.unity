--- !u!114 &375071449
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 375071447}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: daf404ac10c46324790e3afd8418ce81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: "\u5B9E\u73B0\u65B9\u6848 \xB7 07-\u8BBE\u5907\u8981\u6C42\u4E0E\u64CD\u4F5C\u65B9\u5F0F"
  author: "VRlibrary \u9879\u76EE\u7EC4"
  summary: "\n07 \u5BFC\u51FA\u540E\u8981\u6C42\u7684\u8BBE\u5907,\u4EE5\u53CA\u4F7F\u7528\u65B9\u5F0F(\u952E\u76D8
    / \u624B\u67C4)\n\n#\n\u4E00\u3001\u8FD0\u884C\u8BBE\u5907\u8981\u6C42\n\n| \u573A\u666F
    | \u8BBE\u5907/\u73AF\u5883 | \u8BF4\u660E |\n| --\xB7 | --\xB7 | --\xB7 |\n|
    \u5F00\u53D1\u8C03\u8BD5 | Windows PC + Unity 2022.3(\u6216\u76F4\u63A5\u7F16\u8F91\u5668
    Play) | \u7528 XR Device Simulator \u952E\u76D8\u9F20\u6807\u6A21\u62DF |\n|
    \u771F\u673A\u4F53\u9A8C | PICO \u4E00\u4F53\u673A(PICO 4 / Neo 3 / PICO 4 Pro
    \u7B49,\u652F\u6301 6DoF \u624B\u67C4) | apk \u5B89\u88C5\u6216 Build And Run
    |\n| \u4F20\u8F93\u7EBF | USB \u6570\u636E\u7EBF(USB 3.0 \u4EE5\u4E0A\u63A8\u8350)
    | Build And Run / adb \u5B89\u88C5 |\n| \u7CFB\u7EDF\u8BBE\u7F6E | PICO \u5F00\u53D1\u8005\u6A21\u5F0F\u5F00\u542F;\u9996\u6B21
    USB \u8C03\u8BD5\u6388\u6743 | |\n\n\u6700\u4F4E\u6027\u80FD\u53C2\u8003:\u672C\u573A\u666F\u7EA6
    13 \u76CF\u5B9E\u65F6\u706F(\u5168\u65E0\u9634\u5F71\u4EC5\u4E3B\u5149)+ Bloom,\u5B9E\u6D4B
    PC \u7F16\u8F91\u5668\u8F7B\u677E 90FPS;PICO 4 \u5EFA\u8BAE\u76EE\u6807 72\fHz\u3002\n\n#\n\u4E8C\u3001\u7F16\u8F91\u5668(\u952E\u76D8\u9F20\u6807)\u64CD\u4F5C
    \u2014\u2014 XR Device Simulator\n\n> \u8FDB\u5165 Play \u81EA\u52A8\u751F\u6210(\u5DE6\u4E0B\u89D2\u6709
    \"XR Device Simulator\" \u5C0F\u9762\u677F,\u70B9\u51FB\u9F7F\u8F6E\u53EF\u67E5\u6309\u952E\u8868)\u3002\n\n|
    \u52A8\u4F5C | \u6309\u952E |\n| --\xB7 | --\xB7 |\n| \u79FB\u52A8 | W A S D
    |\n| \u4E0A/\u4E0B(\u98DE) | Q / E |\n| \u89C6\u89D2(\u8F6C\u5934) | \u6309\u4F4F\u53F3\u952E\u79FB\u52A8\u9F20\u6807
    |\n| \u5DE6\u624B\u5C04\u7EBF | \u6309\u4F4F\u53F3 Shift + \u79FB\u52A8\u9F20\u6807
    |\n| \u53F3\u624B\u5C04\u7EBF | \u6309\u4F4F\u5DE6 Shift(\u6216\u9ED8\u8BA4)
    + \u79FB\u52A8\u9F20\u6807 |\n| \u6273\u673A(Trigger)/ \u5F00\u4E66 / \u7FFB\u9875
    / \u70B9\u6309\u94AE | \u9F20\u6807\u53F3\u952E |\n| \u6293\u53D6(Grip)/ \u62FF\u4E66
    | \u9F20\u6807\u5DE6\u952E |\n| \u6447\u6746\u4F20\u9001 | \u6309\u4F4F\u624B\u67C4\u6447\u6746(\u6A21\u62DF:\u5C0F\u952E\u76D8?)\u2014\u2014\u63A8\u8350\u76F4\u63A5\u8D70\"\u8FDB\u5165\u56FE\u4E66\u9986\"\u6309\u94AE\u4F20\u9001
    |\n| \u6682\u505C\u6A21\u62DF/\u67E5\u770B\u5E2E\u52A9 | \u9762\u677F\u9F7F\u8F6E
    \u2192 \u6309\u952E\u603B\u8868 |\n\n\u5178\u578B\u6D41\u7A0B(\u7F16\u8F91\u5668):Play
    \u2192 WASD \u8D70\u5230\u4E2D\u592E\u53F0\u6216\u76F4\u63A5\u70B9\"\u8FDB\u5165\f\u56FE\u4E66\u9986\"\u4F20\u9001
    \u2192 Shift+\u9F20\u6807 \u79FB\u5C04\u7EBF\u5230\u4E66\u4E0A \u2192 \u53F3\u952E
    \u2192 \u9605\u8BFB\u5C4F\u6253\u5F00 \u2192 \u5C04\u7EBF\u70B9\"\u4E0B\u4E00\u9875/\u4E0A\u4E00\u9875/\u5173\u95ED\"\u3002\n\n#\n\u4E09\u3001PICO
    \u624B\u67C4\u64CD\u4F5C\n\n| \u52A8\u4F5C | \u8F93\u5165 |\n| --\xB7 | --\xB7
    |\n| \u884C\u8D70 | \u5DE6\u6447\u6746(\u8FDE\u7EED\u79FB\u52A8,Character Controller)
    |\n| \u8F6C\u8EAB | \u53F3\u6447\u6746 \u5DE6\u53F3(Snap Turn) |\n| \u4F20\u9001
    | \u6307\u5730\u9762\u6309\u53F3\u6447\u6746\u51FA\u5F27\u7EBF \u2192 \u6273\u673A\u786E\u8BA4(\u6216\u76F4\u63A5\u7528\"\u8FDB\u5165\u56FE\u4E66\u9986\"\u6309\u94AE)
    |\n| \u5C04\u7EBF | \u624B\u67C4\u524D\u7AEF\u5E38\u9A7B |\n| \u6253\u5F00\u4E66(\u91CD\u70B9)
    | \u5C04\u7EBF\u6307\u7740\u4E66 \u2192 \u6263\u6273\u673A;\u6216\u5148 Grip
    \u6293\u8D77\u518D\u6263\u6273\u673A |\n| \u7FFB\u9875 / \u5173\u95ED | \u5C04\u7EBF\u70B9\u9762\u677F\u6309\u94AE
    \u2192 \u6273\u673A |\n| \u6293\u4E66 / \u653E\u4E66 | Grip \u4FA7\u952E\u6309\u4F4F/\u677E\u5F00
    |\n| \u5F52\u8FD8\u4E66 | \u62FF\u4E66\u9760\u8FD1\u670D\u52A1\u53F0\u53D1\u5149\u611F\u5E94\u5708
    \u2192 \u81EA\u52A8\u5438\u9644 = \u5F52\u8FD8\u6210\u529F |\n| \u7CFB\u7EDF\u8FD4\u56DE
    | \u624B\u67C4 Home \u952E |\n\n#\n\u56DB\u3001\u4F53\u9A8C\u52A8\u7EBF(\u8BBE\u8BA1\u597D\u7684\u5B8C\u6574\u6D41\u7A0B)\n\n1.
    \u51FA\u751F\u70B9\u9762\u5411\u4E2D\u592E\u5168\u606F\u5BFC\u89C8\u53F0;\n2.
    \u70B9 \"\f\u8FDB\u5165\u56FE\u4E66\u9986\" \u2192 \u76F4\u63A5\u4F20\u9001\u5230\u4E66\u67B6\u533A(\u514D\u8D70\u957F\u8DEF);\n3.
    \u4E66\u67B6\u4E0A\u770B\u4E66\u810A\u6807\u9898\u627E\u4E66 \u2192 \u5C04\u7EBF\u6307\u4E66\u6263\u6273\u673A
    \u2192 \u9605\u8BFB\u5C4F\u5C55\u5F00;\n4. \u4E0A\u4E00\u9875/\u4E0B\u4E00\u9875\u9605\u8BFB;\u5173\u95ED\u540E\u4E66\u53EF\u653E\u56DE\u6216\u5E26\u8D70;\n5.
    \u60F3\u6362\u533A:\u5730\u9762\u53D1\u5149\u5706\u76D8\u4F20\u9001\u951A\u70B9,\u6216\u8D70\u56DE\u4E2D\u592E\u53F0;\n6.
    \u770B\u5B8C\u5F52\u8FD8:\u5317\u4FA7\u670D\u52A1\u53F0,\u628A\u4E66\u653E\u8FDB\u54C1\u7EA2\u53D1\u5149\u611F\u5E94\u5708
    \u2192 \u72B6\u6001\u5C4F\u663E\u793A\u5F52\u8FD8\u6210\u529F\u3002\n\n#\n\u4E94\u3001\u5E38\u89C1\u64CD\u4F5C\u95EE\u9898\n\n|
    \u75C7\u72B6 | \u539F\u56E0 |\n| --\xB7 | --\xB7 |\n| \u7F16\u8F91\u5668\u91CC\u70B9\u4E86\u6CA1\u53CD\u5E94
    | \u6273\u673A\u662F\u9F20\u6807\u53F3\u952E,\u4E0D\u662F\u5DE6\u952E(\u5DE6\u952E\u662F
    Grip \u6293\u53D6) |\n| \u89C6\u89D2\u8F6C\u4E0D\u52A8 | \u8981\u6309\u4F4F\u53F3\u952E\u62D6\u9F20\u6807(\u6216\u5DE6
    Shift+\u9F20\u6807\u63A7\u5236\u53F3\u624B\u5C04\u7EBF,\u53F3 Shift+\u9F20\u6807\u63A7\u5236\u5DE6\u624B\u5C04\u7EBF)
    |\n| \u771F\u673A\u4E0A\u5C04\u7EBF\u70B9\u4E0D\u5230\u6309\u94AE | \u6309\u94AE
    Canvas \u7F3A TrackedDeviceGraphicRaycaster,\u6216 Event System \u4E0D\u5728\u573A\u666F
    |\n| \u4F20\u9001\u70B9\u4E0D\u4E86\u5730\u9762 | \u5730\u9762\u7F3A Teleportation
    Area;\u6216 Locomotion S\fystem \u88AB\u7981\u7528 |\n\r\n---\r\n\r\n#\n\u4EBA\u5DE5\u590D\u523B\u6B65\u9AA4(\u8F93\u5165\u7CFB\u7EDF\u914D\u7F6E,\u7167\u505A\u5373\u53EF)\r\n\r\n##\nA.
    \u7F16\u8F91\u5668\u952E\u76D8\u9F20\u6807(XR Device Simulator)\r\n\r\n1. Package
    Manager \u2192 XR Interaction Toolkit \u2192 Samples \u2192 \u5BFC\u5165 XR Device
    Simulator;\r\n2. \u628A sample \u7684 `XRDeviceSimulatorSettings.asset` \u653E\u5230\u67D0\u4E2A
    Resources \u6587\u4EF6\u5939(\u672C\u5DE5\u7A0B\u5728 `Assets/XRI/Settings/Resources/`),Inspector
    \u91CC Simulator Prefab \u69FD\u6307\u5B9A `XR Device Simulator.prefab`,\u52FE
    Automatically Instantiate(\u4EC5 Editor);\r\n3. Play \u2192 \u5DE6\u4E0B\u89D2\u51FA\u73B0\u6A21\u62DF\u5668\u9762\u677F\u5373\u6210\u529F;\u6309\u952E\u8868\u89C1\u672C\u6587\u6863\u7B2C\u4E8C\u8282(\u6838\u5FC3:W\fASD
    \u8D70\u3001\u53F3\u952E\u8F6C\u89C6\u89D2\u3001\u53F3\u952E=\u6273\u673A\u3001\u5DE6\u952E=\u6293\u624B);\r\n4.
    \u5E38\u89C1\u95EE\u9898:\u9762\u677F\u51FA\u73B0\u4F46\u70B9\u4E0D\u4E86 UI
    \u2192 Event System \u7684\u8F93\u5165\u6A21\u5757\u88AB\u6362\u6210 Standalone
    Input Module \u4E86,\u6362\u56DE XR UI Input Module\u3002\r\n\r\n##\nB. PICO
    \u624B\u67C4\r\n\r\n1. \u65E0\u9700\u989D\u5916\u914D\u7F6E\u2014\u2014XRI Default
    Input Actions \u5DF2\u6620\u5C04\u901A\u7528\u624B\u67C4(\u6447\u6746/\u6273\u673A/Grip);\r\n2.
    \u9A8C\u8BC1\u987A\u5E8F:\u6447\u6746\u8D70 \u2192 \u53F3\u6447\u6746\u8F6C \u2192
    \u5C04\u7EBF\u51FA\u5F27\u7EBF\u6307\u5730\u9762\u4F20\u9001 \u2192 \u6307\u4E66\u6263\u6273\u673A\u5F00\u9605\u8BFB
    \u2192 \u6293\u4E66\u653E\u5F52\u8FD8\u53E3;\r\n3. \u624B\u67C4\u6A21\u578B\u4E0D\u663E\u793A:\u786E\u8BA4
    XR Controller \u7EC4\u4EF6\u7684 Model Prefab \u6CA1\u88AB\u6E05\u7A7A;\r\n4.
    \u60F3\u52A0\u9707\u52A8:\u7528 `PXR_Input.SendHapticImpulse(PXR_Input.VibrateType.BothController,
    0.5f, 500, 100)`(XRI \u81EA\u5E26 Hap\ftic Events \u5728 PICO Integration SDK
    \u4E0B\u65E0\u6548,\u5FC5\u987B\u8D70 PXR_Input)\u3002\r\n"
  slotCode: A1-1-02
