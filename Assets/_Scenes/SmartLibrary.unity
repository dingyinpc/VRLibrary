--- !u!114 &1152626248
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1152626246}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: daf404ac10c46324790e3afd8418ce81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: "\u5B9E\u73B0\u65B9\u6848 \xB7 05-\u5C4F\u5E55\u7684\u5236\u4F5C"
  author: "VRlibrary \u9879\u76EE\u7EC4"
  summary: "\n05 \u5C4F\u5E55\u7684\u5236\u4F5C(\u4E16\u754C\u7A7A\u95F4 UI + \u5C04\u7EBF\u70B9\u51FB
    + \u9605\u8BFB\u9762\u677F)\n\n> \u573A\u666F\u5171 3 \u5757\u5C4F:\u4E2D\u592E\u5BFC\u89C8\u5C4F(InfoCanvas)\u3001\u5F52\u8FD8\u53E3\u72B6\u6001\u5C4F(ReturnStatusCanvas)\u3001\u9605\u8BFB\u9762\u677F(BookReaderPanel)\u3002\n>
    \u4E09\u5757\u5C4F\u505A\u6CD5\u5B8C\u5168\u4E00\u81F4,\u53EA\u662F\u5185\u5BB9\u4E0D\u540C\u3002\n\n#\n\u4E00\u3001\u4E16\u754C\u7A7A\u95F4
    UI \u7684 5 \u8981\u7D20(\u7F3A\u4E00\u4E0D\u53EF)\n\n1. Canvas(RenderMode =
    WorldSpace):\u666E\u901A Canvas \u653E\u5230\u4E09\u7EF4\u4E16\u754C\u91CC;\n2.
    RectTransform \u5C3A\u5BF8+\u7F29\u653E:\u4E60\u60EF\u505A\u6CD5 = \u5C3A\u5BF8\u5199\"\u50CF\u7D20\"(\u5982
    760\xD7460),\u7F29\u653E\u538B\u6210\u7C73(\xD70.0016 \u2248 1.2m \u5BBD);\n3.
    TrackedDeviceGraphicRaycaster(XRI \u7EC4\u4EF6,\u66FF\u6362\u9ED8\u8BA4 GraphicRaycaster):\u8BA9
    XR \u5C04\u7EBF/\u6233\u52A8\u53C2\u4E0E UI \u547D\u4E2D;\n4. Event System +
    XR UI Input Module:\u573A\u666F\u5168\u5C40\f\u4E00\u4E2A(XR Interaction Setup
    \u9884\u5236\u4F53\u81EA\u5E26),\u6CA1\u6709\u5B83\u5C04\u7EBF\u70B9\u4E0D\u4E86\u6309\u94AE;\n5.
    \u671D\u5411:UGUI \u5185\u5BB9\u4ECE -Z \u9762\u9605\u8BFB\u3002\u9762\u5411\u73A9\u5BB6
    = \u8BA9 Canvas \u7684 -Z \u6307\u5411\u73A9\u5BB6(\u5E38\u89C1\u505A\u6CD5:\u65CB\u8F6C
    Y 180\xB0,\u6216 LookRotation \u65F6\u53D6\"\u753B\u5E03\u4F4D\u7F6E-\u73A9\u5BB6\u4F4D\u7F6E\"\u65B9\u5411)\u3002\n  
    \u26A0\uFE0F \u5751:\u4E0D\u8F6C\u4F1A\u6210\u955C\u50CF\u5B57(\u672C\u5DE5\u7A0B\u4E2D\u592E\u5C4F\u548C\u4E66\u810A\u6807\u9898\u90FD\u8E29\u8FC7)\u3002\n\n#\n\u4E8C\u3001\u4E2D\u592E\u5BFC\u89C8\u5C4F(InfoCanvas)\u53C2\u6570\n\n|
    \u9879 | \u503C |\n| --\xB7 | --\xB7 |\n| \u6302\u8F7D | CentralKiosk \u4E0B
    |\n| sizeDelta | 760 \xD7 460,scale 0.0024(\u7EA6 1.8m \xD7 1.1m) |\n| \u4F4D\u7F6E/\u671D\u5411
    | \u5EA7\u4E0A\u65B9 (0, 2.05, 0.42),Euler(-8, 180, 0) |\n| \u7ED3\u6784 | \u80CC\u677F
    Image(\u6DF1\u84DD\u534A\u900F\u660E)\u2192 \u6807\u9898 Text 64 \u2192 \u526F\u6807\u9898
    28 \u2192 \u72B6\u6001 Text 26 \u2192 3 \u4E2A\f\u6309\u94AE(\u8FDB\u5165\u56FE\u4E66\u9986/\u667A\u80FD\u68C0\u7D22/\u5F52\u8FD8\u670D\u52A1,Text
    \u7528 Legacy,\u5B57\u53F7 30) |\n| \u5B57\u4F53 | `Resources.GetBuiltinResource<Font>(\"LegacyRuntime.ttf\")`(Legacy
    Text,\u4E2D\u6587\u65E0\u9700 TMP Essentials) |\n\n##\n\"\u8FDB\u5165\u56FE\u4E66\u9986\"\u6309\u94AE\u7684\u4F20\u9001\u7ED1\u5B9A\n\n\xB7
    \u6309\u94AEonClick \u91CC\u6302\u4E24\u4E2A\u6301\u4E45\u5316\u76D1\u542C:\n 
    1. `LibraryUIController.OnGuideButton`(\u72B6\u6001\u5C4F\u663E\u793A\u5BFC\u89C8\u8BCD)\n 
    2. `KioskTeleporter.TeleportToDestination`(\u4F20\u9001)\n\xB7 KioskTeleporter
    \u7684 origin = XR Origin,destination = `Dest_ShelfArea` \u7A7A\u7269\u4F53(-12.5,
    0, 3,Y=-90\xB0)\u3002\n\n#\n\u4E09\u3001\u9605\u8BFB\u9762\u677F(BookReaderPanel)\n\n|
    \u9879 | \f\u503C |\n| --\xB7 | --\xB7 |\n| \u5C3A\u5BF8 | 660 \xD7 600(\u6BD4\u539F\u7248\u5411\u4E0A\u6269\u5BB9
    1/4),scale 0.0022,pivot (0.5, 0)(\u4ECE\u5E95\u8FB9\u5411\u4E0A\u957F) |\n| \u8DDF\u968F
    | BookReader.Update:\u4FDD\u6301\u73A9\u5BB6\u524D\u65B9 1.55m\u3001\u9AD8\u5EA6\u89C6\u7EBF-0.45m,LookRotation
    \u9762\u5411\u73A9\u5BB6,Lerp 6/s \u8F7B\u8DDF\u968F |\n| \u7ED3\u6784 | \u6807\u9898
    34 / \u4F5C\u8005 22(\u9752)/ \u6B63\u6587 24(\u951A\u70B9 0.05~0.95 \xD7 0.16~0.83)/
    \u9875\u7801 22 / \u6309\u94AE:\u25C0\u4E0A\u4E00\u9875\u3001\u5173\u95ED(\u7EA2)\u3001\u4E0B\u4E00\u9875\u25B6
    |\n| \u7FFB\u9875\u52A8\u753B | \u534F\u7A0B:\u6B63\u6587 RectTransform scaleX
    1\u21920(0.12s)\u2192 \u6362\u6587\u672C \u2192 0\u21921,\u6A21\u62DF\u7FFB\u9875
    |\n| \u5206\u9875\u89C4\u5219 | summary \u542B `\\f` \u6309\u5176\u5207\u5206;\u5426\u5219
    160 \u5B57/\u9875;\u4E0D\u8DB3 3 \u9875\u81EA\u52A8\u8865\"\u5F85\u5F55\u5165\"\u5360\u4F4D\u9875
    |\n\n#\n\u56DB\u3001\u5F52\u8FD8\u53E3\u72B6\u6001\u5C4F(ReturnStatusCanva\fs)\n\n\xB7
    \u5C3A\u5BF8 620\xD7220\u3001scale 0.0016,\u4F4D\u4E8E\u670D\u52A1\u53F0\u4E0A\u65B9,\u4FEF\u89D2
    25\xB0;\n\xB7 \u4E00\u5757 Text \u7531 `BookReturnSocket.statusText` \u5F15\u7528,Socket
    \u5438\u9644\u4E66\u65F6\u81EA\u52A8\u66F4\u65B0\"\u5DF2\u5F52\u8FD8\u300Axx\u300B,\u7D2F\u8BA1
    N \u672C\"\u3002\n\n#\n\u4E94\u3001\u5C04\u7EBF\u70B9\u51FB UI \u7684\u5B8C\u6574\u94FE\u8DEF(\u6392\u67E5\u6E05\u5355)\n\n\n\u624B\u67C4\u6263\u6273\u673A\n\u2192
    XR Ray Interactor(select/activate)\n\u2192 XR UI Input Module(Event System)\n\u2192
    TrackedDeviceGraphicRaycaster(Canvas \u4E0A)\n\u2192 Button.onClick\n\u2192 \u6301\u4E45\u5316\u76D1\u542C\u65B9\u6CD5\n\n\u4EFB\u4F55\u4E00\u73AF\u7F3A\u5931\u5C31\u70B9\u4E0D\u52A8:\u6700\u5E38\u89C1\u662F
    \u2462(Canvas \u5FD8\u52A0 TrackedDeviceGraphicRaycaster)\u548C \u2463(\u573A\u666F\u91CC\u6CA1\u6709\u5E26
    XR UI Input Module \u7684 Event System)\u3002\n\n#\n\u516D\u3001UI \u5236\u4F5C\u89C4\u8303(\u672C\u5DE5\f\u7A0B\u7EA6\u5B9A)\n\n1.
    \u4E00\u5F8B XR \u5206\u7C7B\u5EFA Canvas(\u6216\u666E\u901A Canvas + \u624B\u52A8\u6362
    Raycaster),\u4E0D\u8981\u7528 Screen Space;\n2. \u6587\u5B57\u4E00\u5F8B Legacy
    Text + LegacyRuntime.ttf(\u4E2D\u6587\u7A33\u3001\u4E0D\u9700\u8981 TMP);\n3.
    \u9762\u677F\u505A\"\u8F7B\u8DDF\u968F\":\u4E16\u754C\u7A7A\u95F4\u5B9A\u4F4D
    + Update \u91CC Lerp,\u65E2\u7A33\u5B9A\u53C8\u80FD\u8F6C\u8EAB\u540E\u8DDF\u4E0A;\n4.
    \u6309\u94AE\u60AC\u505C/\u6309\u4E0B\u6362\u8272:Button.colors.highlightedColor
    = \u9752\u3001pressed = \u6DF1\u9752\u3002\n\r\n---\r\n\r\n#\n\u4EBA\u5DE5\u590D\u523B\u6B65\u9AA4(\u4EE5\u4E2D\u592E\u5BFC\u89C8\u5C4F\u4E3A\u4F8B,\u7167\u505A\u5373\u53EF)\r\n\r\n1.
    \u5EFA Canvas:Hierarchy \u53F3\u952E \u2192 UI \u2192 Canvas;Render Mode = World
    Space;\r\n2. \u5B9A\u5C3A\u5BF8:RectTransform \u5BBD 760 \u9AD8 460;Scale \u7EDF\u4E00\u538B\u5230
    (0.0024, 0.0024, 0.0024)(\u22481.8m \f\xD7 1.1m);\u6446\u5230\u5BFC\u89C8\u53F0\u4E0A\u65B9,\u65CB\u8F6C
    (-8, 180, 0)(180\xB0 \u662F\u4E3A\u4E86\u8BA9\u6587\u5B57\u6B63\u5BF9\u73A9\u5BB6,\u4E0D\u8F6C\u4F1A\u955C\u50CF!);\r\n3.
    \u6362 Raycaster:\u5220\u9664 Canvas \u4E0A\u9ED8\u8BA4\u7684 Graphic Raycaster
    \u2192 Add Component \u2192 Tracked Device Graphic Raycaster;\r\n4. \u67E5 Event
    System:\u573A\u666F\u91CC\u5FC5\u987B\u6709\u5E26 XR UI Input Module \u7684 Event
    System(XR Interaction Setup \u9884\u5236\u4F53\u81EA\u5E26);\r\n5. \u94FA\u5185\u5BB9:\u5EFA\u80CC\u677F
    Image(\u951A\u70B9\u94FA\u6EE1,\u6DF1\u84DD\u534A\u900F\u660E\u8272)\u2192 \u53F3\u952E
    UI \u2192 Legacy \u2192 Text \u5EFA\u6807\u9898(64)/\u526F\u6807\u9898(28)/\u72B6\u6001\u6587\u5B57(26),\u5B57\u4F53
    LegacyRuntime;\u53F3\u952E UI \u2192 Legacy \u2192 Button \u5EFA\u4E09\u4E2A\u6309\u94AE,\u6BCF\u4E2A\u6309\u94AE
    Text \u6539\u529F\u80FD\u540D,\u5220\u6389\u9ED8\u8BA4 Raycaster\f \u68C0\u67E5;\r\n6.
    \u6302\u63A7\u5236\u5668:\u5BFC\u89C8\u53F0 Add Component \u2192 LibraryUIController,\u628A\u72B6\u6001
    Text \u62D6\u8FDB statusText;\r\n7. \u7ED1\u6309\u94AE:\u9009\u4E2D\u6309\u94AE
    \u2192 Inspector \u6700\u4E0B onClick \u2192 \u70B9 + \u2192 \u628A\u6302 LibraryUIController
    \u7684\u7269\u4F53\u62D6\u8FDB\u69FD \u2192 \u4E0B\u62C9\u9009 OnGuideButton
    / OnSearchButton / OnReturnButton;\u4F20\u9001\u6309\u94AE\u518D\u52A0\u4E00\u6761
    KioskTeleporter.TeleportToDestination;\r\n8. \u9A8C\u6536:Play \u2192 \u5C04\u7EBF\u60AC\u505C\u6309\u94AE\u53D8\u8272
    \u2192 \u53F3\u952E/\u6273\u673A\u70B9\u51FB \u2192 \u4FE1\u606F\u5C4F\u6587\u5B57\u53D8\u5316\u5373\u6210\u529F\u3002\r\n"
  slotCode: A1-1-08
