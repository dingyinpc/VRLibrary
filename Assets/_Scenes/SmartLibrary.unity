--- !u!114 &1680116407
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1680116405}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: daf404ac10c46324790e3afd8418ce81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: "\u4FC4\u7F57\u65AF\u65B9\u5757\u5F00\u53D1\u6307\u5357"
  author: "\u65E5\u5E38\u95EE\u9898\u5904\u7406\u7ECF\u9A8C"
  summary: "\n\U0001F9F1 \u4FC4\u7F57\u65AF\u65B9\u5757 Unity 2D \u5C0F\u6E38\u620F\u5F00\u53D1\u6307\u5357\uFF08\u96F6\u57FA\u7840\u7248\uFF09\n\n>
    Unity \u7248\u672C\uFF1A 2022.3.57f1c2  \n> \u76EE\u6807\uFF1A \u4ECE\u96F6\u5F00\u59CB\uFF0C\u5B8C\u6210\u4FC4\u7F57\u65AF\u65B9\u5757\u57FA\u7840
    2D \u5C0F\u6E38\u620F  \n> \u9762\u5411\u4EBA\u7FA4\uFF1A \u6CA1\u6709 Unity
    \u57FA\u7840\u7684\u540C\u5B66\n\n---\n\n\n\u7B2C\u4E00\u90E8\u5206\uFF1AUnity
    \u57FA\u7840\u6982\u5FF5\uFF08\u5FC5\u8BFB\uFF09\n\n\u5728\u5F00\u59CB\u4E4B\u524D\uFF0C\u4F60\u9700\u8981\u5148\u4E86\u89E3\u51E0\u4E2A\u6700\u57FA\u7840\u7684\u6982\u5FF5\uFF0C\u5426\u5219\u4E4B\u540E\u4F1A\u770B\u4E0D\u61C2\u3002\n\n#\n1.1
    Unity \u754C\u9762\u5E03\u5C40\n\n\u6253\u5F00 Unity \u540E\uFF0C\u4F60\u4F1A\u770B\u5230\u8FD9\u6837\u7684\u754C\u9762\uFF1A\n\n\n\u250C\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\n\u2502 
